// componentNavLink represents a prev/next link for component navigation
type componentNavLink struct {
	Label string
	Href  string
}

// orderedComponents returns the flat ordered list of component IDs matching the sidebar order
var orderedComponents = []componentNavLink{
	{"Accordion", "/components/accordion"},
	{"Avatar", "/components/avatar"},
	{"Badge", "/components/badge"},
	{"Banner", "/components/banner"},
	{"Card", "/components/card"},
	{"Carousel", "/components/carousel"},
	{"Code Block", "/components/codeblock"},
	{"Spinner", "/components/spinner"},
	{"Table", "/components/table"},
	{"Tabs", "/components/tabs"},
	{"Button", "/components/button"},
	{"Checkbox", "/components/checkbox"},
	{"Combobox", "/components/combobox"},
	{"Combobox (new)", "/components/combobox-new"},
	{"Dropdown", "/components/dropdown"},
	{"File Input", "/components/fileinput"},
	{"Form", "/components/form"},
	{"Form Validation", "/components/form-validation"},
	{"Key Value", "/components/key-value"},
	{"Pagination", "/components/pagination"},
	{"Select", "/components/select"},
	{"Palette", "/components/palette"},
	{"Tags List", "/components/tags-list"},
	{"Text Input", "/components/text-input"},
	{"Textarea", "/components/textarea"},
	{"Toggle", "/components/toggle"},
	{"Triplet", "/components/triplet"},
	{"Alert", "/components/alert"},
	{"Modal", "/components/modal"},
	{"Steps", "/components/steps"},
	{"Toast", "/components/toast"},
	{"Tooltip", "/components/tooltip"},
	{"Breadcrumbs", "/components/breadcrumbs"},
	{"Navbar", "/components/navbar"},
	{"Sidebar", "/components/sidebar"},
}

func getComponentNav(activeComponent string) (prev, next *componentNavLink) {
	href := "/components/" + activeComponent
	for i, c := range orderedComponents {
		if c.Href == href {
			if i > 0 {
				prev = &orderedComponents[i-1]
			}
			if i < len(orderedComponents)-1 {
				next = &orderedComponents[i+1]
			}
			return
		}
	}
	return nil, nil
}

templ componentNavFooter(activeComponent string) {
	{{ prev, next := getComponentNav(activeComponent) }}
	if prev != nil || next != nil {
		<div class="mt-12 flex items-center justify-between border-t border-outline dark:border-outline-dark pt-6 pb-4">
			if prev != nil {
				{{ prevAttrs := navHxAttrs(prev.Href, "") }}
				<a
					href={ templ.SafeURL(prev.Href) }
					{ prevAttrs... }
					class="group flex items-center gap-2 text-sm text-on-surface-muted hover:text-primary dark:text-on-surface-dark-muted dark:hover:text-primary-dark transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span>{ prev.Label }</span>
				</a>
			} else {
				<div></div>
			}
			if next != nil {
				{{ nextAttrs := navHxAttrs(next.Href, "") }}
				<a
					href={ templ.SafeURL(next.Href) }
					{ nextAttrs... }
					class="group flex items-center gap-2 text-sm text-on-surface-muted hover:text-primary dark:text-on-surface-dark-muted dark:hover:text-primary-dark transition-colors"
				>
					<span>{ next.Label }</span>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
					</svg>
				</a>
			} else {
				<div></div>
			}
		</div>
	}
}

