package main

import (
	"strconv"

	"github.com/araihu/goshtoso/components/alert"
	"github.com/araihu/goshtoso/components/appshell"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/breadcrumbs"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/navbar"
	"github.com/araihu/goshtoso/components/pageheader"
	"github.com/araihu/goshtoso/components/panel"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/skeleton"
	"github.com/araihu/goshtoso/components/steps"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/components/toolbar"
)

templ layout(meta pageMeta) {
	<!DOCTYPE html>
	<html
		lang="en"
		data-theme={ meta.Appearance.Theme }
		class={ templ.KV("dark", meta.Appearance.dark()) }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ meta.Title } · Goshtoso Application Patterns</title>
			@head.Dependencies()
			<link rel="stylesheet" href="/app.css?v=composition-kit"/>
		</head>
		<body>
			@appshell.AppShell(appshell.Config{
				Header:    benchmarkHeader(meta),
				Sidebar:   benchmarkSidebar(meta),
				RootClass: "benchmark-shell",
				MainClass: "benchmark-main",
				MainAttrs: templ.Attributes{"data-scroll-region": "main"},
			}) {
				{ children... }
			}
		</body>
	</html>
}

templ benchmarkHeader(meta pageMeta) {
	@navbar.Navbar(navbar.Config{
		Brand:     benchmarkBrand(),
		BrandHref: routeURL("/", meta.Appearance),
		Actions: []navbar.ActionItem{
			{Content: benchmarkMobileSidebar(meta)},
			{Content: appearanceForm(meta)},
		},
		NavClass: "benchmark-navbar",
	})
}

templ benchmarkBrand() {
	<span>Atlas Ops</span>
}

templ benchmarkMobileSidebar(meta pageMeta) {
	@sidebar.Overlay(sidebar.OverlayConfig{
		ID:                    "benchmark-navigation",
		Sidebar:               benchmarkSidebarConfig(meta),
		TriggerLabel:          "Open pattern navigation",
		RootClass:             "app-mobile-nav",
		BackdropPositionClass: "app-mobile-backdrop",
		PanelPositionClass:    "app-mobile-panel",
	})
}

templ benchmarkSidebar(meta pageMeta) {
	@sidebar.Sidebar(benchmarkSidebarConfig(meta))
}

func benchmarkSidebarConfig(meta pageMeta) sidebar.Config {
	return sidebar.Config{
		Items: []sidebar.Item{
			{ID: "app-shell", Label: "App Shell", Href: routeURL("/", meta.Appearance), Active: meta.Pattern == "App Shell"},
			{ID: "operations", Label: "Operations", Href: routeURL("/operations", meta.Appearance), Active: meta.Pattern == "Operations List" || meta.Pattern == "Detail Workspace"},
			{ID: "deployment", Label: "Deployment", Href: routeURL("/workflows/deploy", meta.Appearance), Active: meta.Pattern == "Multi-step Workflow"},
		},
		SectionsTitle:   "Patterns",
		FooterSlot:      benchmarkRuntimeNote(),
		DisableSkipLink: true,
	}
}

templ benchmarkRuntimeNote() {
	<div class="runtime-note">
		<strong>Local runtime</strong>
		<span>CSS, Alpine.js, and HTMX come from Goshtoso's embedded assets.</span>
	</div>
}

templ appearanceForm(meta pageMeta) {
	<form class="appearance-form" method="get" action={ templ.URL(meta.CurrentPath) }>
		if meta.State != "" {
			<input type="hidden" name="state" value={ string(meta.State) }/>
		}
		if meta.Step > 0 {
			<input type="hidden" name="step" value={ strconv.Itoa(meta.Step) }/>
		}
		<label>
			<span>Theme</span>
			<select name="theme">
				<option value="goshtoso" selected?={ meta.Appearance.Theme == "goshtoso" }>Goshtoso</option>
				<option value="minimal" selected?={ meta.Appearance.Theme == "minimal" }>Minimal</option>
			</select>
		</label>
		<label>
			<span>Mode</span>
			<select name="mode">
				<option value="light" selected?={ meta.Appearance.Mode == "light" }>Light</option>
				<option value="dark" selected?={ meta.Appearance.Mode == "dark" }>Dark</option>
			</select>
		</label>
		<button type="submit">Apply</button>
	</form>
}

templ appShellPage(meta pageMeta, operations []operation) {
	@layout(meta) {
		<section data-pattern="app-shell" class="app-stack">
			@pageheader.PageHeader(pageheader.Config{
				Title:       "Operate the platform without losing context.",
				Description: "This shell keeps navigation, system status, appearance controls, and the current task in one predictable frame.",
				Breadcrumbs: badge.Badge(badge.Config{
					Label:      "All systems observable",
					Tone:       badge.ToneSuccess,
					Appearance: badge.AppearanceSoft,
					Indicator:  true,
				}),
				Actions: badge.Badge(badge.Config{
					Label:      strconv.Itoa(len(operations)) + " tracked operations",
					Tone:       badge.ToneInfo,
					Appearance: badge.AppearanceSoft,
				}),
			})
			<div class="app-card-grid">
				@card.Card(card.Config{
					Tag:         "Pattern 02",
					Title:       "Operations List",
					Description: "Scan status, ownership, environment, and start time before opening a focused workspace.",
					Body:        patternSignals("Page header + toolbar", "Skeleton, empty, error, success"),
					Footer:      patternLink(routeURL("/operations", meta.Appearance), "Open operations"),
					RootClass:   "app-pattern-card",
				})
				@card.Card(card.Config{
					Tag:         "Pattern 03",
					Title:       "Detail Workspace",
					Description: "Keep run context, evidence, ownership, and next actions together for a single operation.",
					Footer:      patternLink(routeURL("/operations/op-104", meta.Appearance), "Inspect op-104"),
					RootClass:   "app-pattern-card",
				})
				@card.Card(card.Config{
					Tag:         "Pattern 04",
					Title:       "Multi-step Workflow",
					Description: "Collect a deployment target, release, and explicit review before executing the change.",
					Footer:      patternLink(routeURL("/workflows/deploy", meta.Appearance), "Start deployment"),
					RootClass:   "app-pattern-card",
				})
			</div>
			@card.Card(card.Config{
				Tag:       "Shell contract",
				Title:     "Stable frame, task-specific center",
				Body:      shellContract(),
				RootClass: "app-wide-card",
			})
		</section>
	}
}

templ shellContract() {
	<div class="app-contract-grid">
		<div><strong>Navigation</strong><span>Four benchmark patterns stay one click away.</span></div>
		<div><strong>Appearance</strong><span>Goshtoso and Minimal work in light and dark.</span></div>
		<div><strong>Runtime</strong><span>No CDN or remote font request is required.</span></div>
	</div>
}

templ patternSignals(items ...string) {
	<ul class="app-pattern-signals">
		for _, item := range items {
			<li>{ item }</li>
		}
	</ul>
}

templ patternLink(href string, label string) {
	@link.Link(href) {
		{ label } <span aria-hidden="true">→</span>
	}
}

templ operationsPage(meta pageMeta, view operationsView) {
	@layout(meta) {
		<section data-pattern="operations-list" class="app-stack">
			@pageheader.PageHeader(pageheader.Config{
				Title:       "Current changes and interventions",
				Description: "Switch the state matrix in place; direct URLs remain useful for testing and progressive enhancement.",
				Breadcrumbs: patternBadge("Shared operational queue"),
				Actions:     primaryLink(routeURL("/workflows/deploy", meta.Appearance), "New deployment"),
			})
			@toolbar.Toolbar(toolbar.Config{
				Label:   "Operations state matrix",
				Actions: operationsStateButtons(meta),
			})
			@operationsStatePanel(view)
		</section>
	}
}

templ operationsStateButtons(meta pageMeta) {
	for _, state := range []viewState{stateLoading, stateEmpty, stateError, stateSuccess} {
		@button.Button(
			button.WithTone(buttonTone(state)),
			button.WithSize(button.SizeSmall),
			button.WithHTMX(&button.HTMXConfig{
				Get:     routeURLWith("/operations", meta.Appearance, "state", string(state)),
				Target:  "#operations-state",
				Swap:    "outerHTML",
				PushURL: true,
			}),
			button.WithLoadingText("Switching…"),
		) {
			{ operationStateLabel(state) }
		}
	}
}

func buttonTone(state viewState) button.Tone {
	switch state {
	case stateError:
		return button.ToneDanger
	case stateEmpty:
		return button.ToneAlternate
	case stateLoading:
		return button.ToneInfo
	default:
		return button.ToneSuccess
	}
}

templ operationsStatePanel(view operationsView) {
	<section
		id="operations-state"
		class="operations-state"
		data-state={ string(view.State) }
		aria-live="polite"
		aria-busy={ strconv.FormatBool(view.State == stateLoading) }
	>
		switch view.State {
			case stateLoading:
				<div class="state-card">
					<div>
						<h2>Refreshing operations</h2>
						<p>Loading ownership, health signals, and rollout progress.</p>
					</div>
					@skeleton.Skeleton(skeleton.Config{
						Shape:     skeleton.ShapeRectangle,
						Count:     3,
						Label:     "Refreshing operations",
						RootClass: "state-skeleton",
						ItemClass: "state-skeleton-row",
					})
				</div>
			case stateEmpty:
				@emptystate.EmptyState(emptystate.Config{
					Title:       "No operations found",
					Description: "The current operational queue is empty. Start a deployment or adjust the upstream filters.",
					Action:      operationsEmptyActions(view.Appearance),
					RootClass:   "state-empty",
				})
			case stateError:
				@alert.Alert(alert.Config{
					Title:       "Operations unavailable",
					Description: "The control plane could not load the queue. Existing operations remain unchanged; retry when connectivity returns.",
					Tone:        alert.ToneDanger,
					ListItems:   []string{"No mutation was attempted", "Last known state remains authoritative"},
				})
				<div class="action-row">
					@primaryLink(routeURLWith("/operations", view.Appearance, "state", "success"), "Retry operations")
				</div>
			default:
				@card.Card(card.Config{
					Tag:         "Success state",
					Title:       "Operations loaded",
					Description: "Live operational data is ready for review.",
					Body:        operationsTableBody(view),
					RootClass:   "app-wide-card",
				})
		}
	</section>
}

templ operationsTableBody(view operationsView) {
	@badge.Badge(badge.Config{
		Label:      "Live",
		Tone:       operationStateTone(view.State),
		Appearance: badge.AppearanceSoft,
		Indicator:  true,
	})
	@table.Table(view.Table)
}

templ operationsEmptyActions(prefs appearance) {
	<div class="action-row">
		@primaryLink(routeURL("/workflows/deploy", prefs), "Start a deployment")
		@link.Link(routeURLWith("/operations", prefs, "state", "success")) {
			Show all operations
		}
	</div>
}

templ patternBadge(label string) {
	@badge.Badge(badge.Config{
		Label:      label,
		Tone:       badge.ToneInfo,
		Appearance: badge.AppearanceSoft,
	})
}

templ primaryLink(href string, label string) {
	@link.Link(href, link.WithAppearance(link.AppearanceButton)) {
		{ label }
	}
}

templ operationDetailPage(meta pageMeta, op operation) {
	@layout(meta) {
		<section data-pattern="detail-workspace" class="app-stack">
			@pageheader.PageHeader(pageheader.Config{
				Title:       op.Summary,
				Description: op.ID + " · " + op.Environment + " · " + op.Service + " · Owned by " + op.Owner,
				Breadcrumbs: breadcrumbs.Breadcrumbs(breadcrumbs.Config{
					Items: []breadcrumbs.Item{
						{Label: "Control room", Href: routeURL("/", meta.Appearance)},
						{Label: "Operations", Href: routeURL("/operations", meta.Appearance)},
					},
					Current: op.ID,
				}),
				Actions: badge.Badge(statusBadge(op.Status)),
			})
			<div class="detail-grid">
				@panel.Panel(panel.Config{
					Header:    applicationPanelHeader("Evidence", "Live decision context"),
					Body:      detailEvidence(op),
					RootClass: "detail-primary",
					BodyClass: "detail-primary-body",
				})
				@panel.Panel(panel.Config{
					Header:    applicationPanelHeader("Operation context", "Run metadata"),
					Body:      operationMetadata(op),
					Footer:    primaryLink(routeURL("/workflows/deploy", meta.Appearance), "Run another deployment"),
					RootClass: "detail-rail",
				})
			</div>
		</section>
	}
}

templ applicationPanelHeader(kicker, title string) {
	<div class="application-panel-heading">
		<span>{ kicker }</span>
		<h2>{ title }</h2>
	</div>
}

templ detailEvidence(op operation) {
	<ul class="evidence-list">
		for _, item := range op.Evidence {
			<li><span aria-hidden="true">✓</span>{ item }</li>
		}
	</ul>
	@alert.Alert(alert.Config{
		Title:       "Guardrail",
		Description: "Pause the rollout if error rate exceeds 0.5% for two consecutive windows.",
		Tone:        alert.ToneWarning,
	})
}

templ operationMetadata(op operation) {
	<dl class="metadata-list">
		<div><dt>Service</dt><dd>{ op.Service }</dd></div>
		<div><dt>Owner</dt><dd>{ op.Owner }</dd></div>
		<div><dt>Started</dt><dd>{ op.Started }</dd></div>
		<div><dt>Change</dt><dd><code>{ op.Change }</code></dd></div>
	</dl>
}

templ workflowPage(meta pageMeta, view workflowView) {
	@layout(meta) {
		<section data-pattern="multi-step-workflow" class="workflow-wrap app-stack" data-step={ strconv.Itoa(view.Step) } data-state={ workflowState(view) }>
			@pageheader.PageHeader(pageheader.Config{
				Title:       "Deploy a release",
				Description: "Each response is server-rendered; validation keeps the user on the step that needs attention.",
				Breadcrumbs: patternBadge("Controlled change"),
			})
			@panel.Panel(panel.Config{
				Header:    applicationPanelHeader("Deployment plan", "Review and submit"),
				Body:      workflowBody(meta, view),
				RootClass: "workflow-panel",
				BodyClass: "workflow-panel-body",
			})
		</section>
	}
}

templ workflowBody(meta pageMeta, view workflowView) {
	@steps.Steps(workflowSteps(view.Step, view.Success))
	if view.Error != "" {
		@alert.Alert(alert.Config{
			Title:       "Check this step",
			Description: view.Error,
			Tone:        alert.ToneDanger,
		})
	}
	if view.Success {
		<div class="workflow-success">
			@alert.Alert(alert.Config{
				Title:       "Deployment queued",
				Description: "The release passed review and entered the production rollout queue.",
				Tone:        alert.ToneSuccess,
			})
			<dl class="metadata-list">
				<div><dt>Environment</dt><dd>{ view.Environment }</dd></div>
				<div><dt>Version</dt><dd>{ view.Version }</dd></div>
				<div><dt>Next checkpoint</dt><dd>5% canary health review</dd></div>
			</dl>
		</div>
	} else {
		<form class="workflow-form" method="post" action="/workflows/deploy">
			<input type="hidden" name="step" value={ strconv.Itoa(view.Step) }/>
			<input type="hidden" name="theme" value={ meta.Appearance.Theme }/>
			<input type="hidden" name="mode" value={ meta.Appearance.Mode }/>
			if view.Step > 1 {
				<input type="hidden" name="environment" value={ view.Environment }/>
			}
			if view.Step > 2 {
				<input type="hidden" name="version" value={ view.Version }/>
			}
			switch view.Step {
				case 1:
					@selectfield.Select(selectfield.Config{
						ID:          "environment",
						Name:        "environment",
						Label:       "Environment",
						Placeholder: "Choose an environment",
						HelperText:  "Production requires the same explicit review as staging in this benchmark.",
						Options: []selectfield.Option{
							{Value: "staging", Label: "Staging", Selected: view.Environment == "staging"},
							{Value: "production", Label: "Production", Selected: view.Environment == "production"},
						},
					})
				case 2:
					@textinput.TextInput(textinput.Config{
						ID:           "version",
						Name:         "version",
						Label:        "Release version",
						Value:        view.Version,
						Placeholder:  "v1.18.0",
						Autocomplete: "off",
						HelperText:   "Use the immutable version prepared by the release pipeline.",
					})
				default:
					<div class="review-grid">
						<div><span>Environment</span><strong>{ view.Environment }</strong></div>
						<div><span>Version</span><strong>{ view.Version }</strong></div>
						<div><span>Strategy</span><strong>5% canary, then regional</strong></div>
					</div>
			}
			<div class="workflow-actions">
				if view.Step > 1 {
					@button.Button(
						button.WithType("submit"),
						button.WithTone(button.ToneAlternate),
						button.WithAttrs(templ.Attributes{"name": "action", "value": "back"}),
					) {
						Back
					}
				} else {
					@link.Link(workflowBackURL(meta.Appearance, view)) {
						Cancel
					}
				}
				@button.Button(
					button.WithType("submit"),
					button.WithTone(button.TonePrimary),
					button.WithLoadingText("Submitting…"),
					button.WithAttrs(templ.Attributes{"name": "action", "value": "continue"}),
				) {
					{ workflowButtonLabel(view) }
				}
			</div>
		</form>
	}
}

func workflowState(view workflowView) string {
	switch {
	case view.Success:
		return "success"
	case view.Error != "":
		return "error"
	default:
		return "ready"
	}
}
