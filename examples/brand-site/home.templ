package main

templ Home() {
	<!doctype html>
	<html lang="en" data-theme="brand">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="A deliberately small static brand-site starter."/>
			<title>Northstar — independent software</title>
			<link rel="stylesheet" href="/assets/goshtoso.css"/>
			<link rel="stylesheet" href="/assets/brand.css"/>
		</head>
		<body>
			<header class="site-frame site-nav">
				<a class="wordmark" href="#top">Northstar</a>
				<nav aria-label="Primary navigation"><a href="#work">Work</a><a href="#contact">Contact</a></nav>
			</header>
			<main id="top" class="site-frame">
				<section class="hero" aria-labelledby="hero-title">
					<p class="eyebrow">Independent software studio</p>
					<h1 id="hero-title">Useful systems, built to last.</h1>
					<p class="lede">This starter keeps art direction, copy, typography, and content rhythm in the product. Goshtoso supplies tokens and durable control styles.</p>
					<a class="action" href="#work">See selected work <span aria-hidden="true">↓</span></a>
				</section>
				<section id="work" class="work" aria-labelledby="work-title">
					<p class="eyebrow">Selected work</p>
					<h2 id="work-title">What we make</h2>
					<a class="work-row" href="#contact"><span>01</span><strong>Monitoring that stays legible under pressure.</strong><em>Control plane</em></a>
					<a class="work-row" href="#contact"><span>02</span><strong>Workflows with durable evidence and review.</strong><em>Developer tools</em></a>
					<a class="work-row" href="#contact"><span>03</span><strong>Documentation that treats readers as collaborators.</strong><em>Publishing</em></a>
				</section>
			</main>
			<footer id="contact" class="site-frame footer"><p>Northstar, 2026</p><a href="mailto:hello@example.com">hello@example.com</a></footer>
		</body>
	</html>
}
