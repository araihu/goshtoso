		{
			ImgSrc:      "/assets/images/carousel/slide-1.webp",
			ImgAlt:      "Abstract blue painting",
			Title:       "Abstract Blue Series",
			Description: "Limited edition canvas print. $49.99",
		},
		{
			ImgSrc:      "/assets/images/carousel/slide-2.webp",
			ImgAlt:      "Abstract red painting",
			Title:       "Sunset Collection",
			Description: "Hand-painted original. $129.99",
		},
		{
			ImgSrc:      "/assets/images/carousel/slide-3.webp",
			ImgAlt:      "Abstract purple painting",
			Title:       "Purple Dreams",
			Description: "Digital art print. $29.99",
		},
	}
}
