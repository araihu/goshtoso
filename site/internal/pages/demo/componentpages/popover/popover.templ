package popoverpage

import (
 "fmt"
	"github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/popover"
 "github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// PopoverDemoPage renders the Popover component demo.
templ PopoverDemoPage() {
	@demo.Layout("Popover", "popover", popoverDemoContent())
}

templ popoverDemoContent() {
	<div id="popover-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Popover",
				Description: "Compose a positioned surface from a consumer-owned trigger and arbitrary content. Choose click, hover, or context activation and add the semantics your surface needs.",
			},
			popoverDefaultPreview(),
			`@popover.Popover(popover.Config{
    ID:        "filters-popover",
    Trigger:   filterTrigger(),
    Content:   filterContent(),
    Role:      "dialog",
    Label:     "Filters",
    TrapFocus: true,
})`,
		)

        @demo.DemoSection(
            demo.DemoSectionProps{Title: "Popover inside a sidebar", Description: "An account popover owns its trigger independently of the containing sidebar."},
            sidebarPopoverPreview(),
            `@sidebar.Overlay(sidebar.OverlayConfig{Sidebar: sidebar.Config{FooterSlot: accountPopover}})`,
        )
        @demo.DemoSection(
            demo.DemoSectionProps{Title: "Viewport collision handling", Description: "Panels prefer their configured placement, flip or shift at viewport edges, and scroll when content is too tall. The native top layer escapes clipping and transformed ancestors without moving content out of its Alpine scope."},
            collisionPreview(),
            `@popover.Popover(popover.Config{Placement: popover.PlacementBottomEnd, Trigger: trigger, Content: content})`,
        )
		@demo.ExpressionOverridesNote("Popover")
  @demo.DemoSection(demo.DemoSectionProps{Title:"Nested action menu",Description:"Escape closes the innermost open surface first and restores its trigger. Press Escape again to close the enclosing popover."},nestedPopoverPreview(),`@popover.Popover(popover.Config{Content: dropdownMenu})`)


		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Hover activation",
				Description: "Use ActivationHover for lightweight, non-modal supporting content while keeping the trigger and panel consumer-owned.",
			},
			popoverHoverPreview(),
			`@popover.Popover(popover.Config{
    Activation: popover.ActivationHover,
    Placement:  popover.PlacementBottomEnd,
    Trigger:    trigger,
    Content:    content,
})`,
		)
	</div>
}

templ popoverDefaultPreview() {
	<div id="popover-default" class="w-full max-w-xl mx-auto">
		<div class="flex justify-center py-8">
			@popover.Popover(popover.Config{
				ID:        "filters-popover",
				Trigger:   filterTrigger(),
				Content:   filterContent(),
				Role:      "dialog",
				Label:     "Filters",
				TrapFocus: true,
			})
		</div>
	</div>
}

templ popoverHoverPreview() {
	<div id="popover-hover" class="w-full max-w-xl mx-auto">
		<div class="flex justify-center py-8">
			@popover.Popover(popover.Config{
				ID:         "help-popover",
				Activation: popover.ActivationHover,
				Placement:  popover.PlacementBottomEnd,
				Trigger:    helpTrigger(),
				Content:    helpContent(),
				Role:       "note",
				Label:      "Helpful context",
			})
		</div>
	</div>
}

templ filterTrigger() {
	@button.Button() {
		@filterIcon()
		<span>Open filters</span>
	}
}

templ filterContent() {
	<div class="grid gap-3 p-4 text-sm text-on-surface dark:text-on-surface-dark">
		<p class="font-semibold">Filter results</p>
		<label class="grid gap-1">
			<span class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Status</span>
			<select class="rounded-radius border border-outline bg-surface px-2 py-1.5 dark:border-outline-dark dark:bg-surface-dark">
				<option>All statuses</option>
				<option>Ready</option>
				<option>Draft</option>
			</select>
		</label>
	</div>
}

templ helpTrigger() {
	@button.Button(button.WithTone(button.ToneAlternate)) {
		@helpIcon()
		<span>Show help</span>
	}
}

templ helpContent() {
	<div class="max-w-xs p-4 text-sm text-on-surface dark:text-on-surface-dark">
		<p class="font-semibold">Need a hand?</p>
		<p class="mt-1 text-on-surface-muted dark:text-on-surface-dark-muted">Popover content can be prose, forms, menus, or any other consumer-owned templ component.</p>
	</div>
}

templ filterIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4">
		<path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16M7 12h10m-7 7h4"></path>
	</svg>
}

templ helpIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4">
		<circle cx="12" cy="12" r="9"></circle>
		<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9a2.25 2.25 0 1 1 3.73 1.7c-.84.72-1.48 1.18-1.48 2.55M12 16.75h.01"></path>
	</svg>
}

templ nestedPopoverPreview() {
 @popover.Popover(popover.Config{ID:"nested-inbox",Trigger:nestedInboxTrigger(),Content:nestedInboxContent(),Role:"dialog",Label:"Nested inbox",TrapFocus:true})
}

templ nestedInboxTrigger() {
 @button.Button(button.WithID("nested-inbox-trigger")) { Open inbox }
}

templ nestedInboxContent() {
 <p>Inbox with a nested action menu.</p>
 @dropdown.Dropdown(dropdown.Config{ID:"nested-inbox-actions",Label:"Inbox actions",Sections:[]dropdown.Section{{Items:[]dropdown.Item{{Label:"Inspect notification",Href:"#"}}}}})
}

// An intentionally clipped and transformed scrolling fixture, also useful to
// consumers reproducing edge positioning without a separate application.
templ collisionPreview() {
 <div id="popover-collision-scroll" style="height: 220px; overflow: auto; transform: translateZ(0); border: 1px solid currentColor; padding: 12px;">
  <div style="height: 520px; display: flex; align-items: flex-end; justify-content: space-between;">
   @popover.Popover(popover.Config{ID: "popover-collision-start", Role: "menu", Label: "Panel actions", Placement: popover.PlacementBottomEnd, Trigger: collisionTrigger("Left edge"), Content: collisionContent()})
   @dropdown.Dropdown(dropdown.Config{ID: "dropdown-collision-end", Label: "Right edge", Sections: []dropdown.Section{{Items: []dropdown.Item{{Label: "First action", Href: "#first-action"}, {Label: "Second action", Href: "#second-action"}}}}})
  </div>
 </div>
}

templ collisionTrigger(label string) {
 @button.Button() { { label } }
}

templ collisionContent() {
 <div style="padding: 12px; width: 260px; max-width: 100%;">
  <p>Scrollable panel content</p>
  for n := range 30 {
   <button type="button" role="menuitem" style="display: block; padding: 8px;">Action { fmt.Sprint(n + 1) }</button>
  }
 </div>
}

templ sidebarPopoverPreview() {
    <div id="sidebar-popover-example">
        @sidebar.Overlay(sidebar.OverlayConfig{
            ID: "account-navigation",
            TriggerLabel: "Open account navigation",
            Trigger: sidebarPopoverLabel(),
            Sidebar: sidebar.Config{
                LogoText: "Account navigation",
                DisableSkipLink: true,
                FooterSlot: sidebarAccountPopover(),
            },
        })
    </div>
}

templ sidebarPopoverLabel() {
    <span>Open account navigation</span>
}

templ sidebarAccountPopover() {
    @popover.Popover(popover.Config{
        ID: "sidebar-account",
        Trigger: sidebarAccountTrigger(),
        Content: sidebarAccountContent(),
        Role: "dialog",
        Label: "Account choices",
        Placement: popover.PlacementTopStart,
    })
}

templ sidebarAccountTrigger() {
    @button.Button(button.WithID("sidebar-account-trigger")) { Choose account }
}

templ sidebarAccountContent() {
    <button type="button" id="sidebar-account-close" x-on:click="closeAndFocus()">Close account choices</button>
}
