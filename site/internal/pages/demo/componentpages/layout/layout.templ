package layoutpage

import (
 "github.com/araihu/goshtoso/components/layout"
 "github.com/araihu/goshtoso-charts/components/line"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/panel"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/site/internal/pages/demo"
)

templ layoutDemoContent() {
 <div id="layout-fragment">
 @demo.ComponentDemo(demo.ComponentDemoProps{Title:"Layout",Description:"Arrange arbitrary content in Stack, Grid or Masonry. Drag non-interactive content or use grip handles to reorder or transfer items. Each icon keeps a named movement label for assistive technology. A ghost follows the pointer and an insertion gap shows where the item will land. Text dragging moves items in this opt-in demo. Links and inputs remain usable. Touch uses the handles. Changes affect this preview only."}, mixedPreview(), `@layout.Container(layout.Config{
    ID: "operations", Label: "Operations", Mode: layout.ModeMasonry, Columns: 2,
    Reorder: &layout.ReorderConfig{Group: "widgets"},
    Items: []layout.Item{
        {ID: "service", Label: "Service", Content: serviceCard()},
        {ID: "notes", Label: "Notes", Content: notes()},
    },
}).WithContentDrag(true)`)
 @demo.DemoSection(demo.DemoSectionProps{Title:"Nested groups",Description:"An outer group controls its own columns. Drag a group background or padding to move the group. Inner items keep their own bounds and movement scope."}, nestedPreview(), `@layout.Container(layout.Config{
    ID: "groups", Label: "Groups", Mode: layout.ModeGrid, Columns: 2,
    Reorder: &layout.ReorderConfig{Group: "groups"},
    Items: []layout.Item{
        {ID: "nested", Label: "Nested group", Content: innerLayout()},
    },
}).WithContentDrag(true)`)
 @demo.DemoSection(demo.DemoSectionProps{Title:"Stack",Description:"Single-column reading order without movement handles."}, stackPreview(), `@layout.Container(layout.Config{ID: "reading", Label: "Reading", Items: items})`)
 @demo.ExpressionOverridesNote("Layout")
 </div>
}

templ mixedPreview() {
 <div x-data class="w-full space-y-6">
 <p class="text-sm">Alt+Up/Down reorders immediately. Alt+Home/End moves first or last. Alt+PageUp/PageDown transfers between compatible groups. Escape cancels dragging. Mouse and pen drags auto-scroll near a scroll edge, and gaps choose the nearest insertion slot.</p>
 @button.Button(button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-layout-demo-transfer":""})) { <span>Move service to inbox</span> }
 <div x-data class="space-y-4">
 @layout.Container(layout.Config{ID:"layout-mixed",Label:"Operations",Mode:layout.ModeMasonry,Columns:2,Reorder:&layout.ReorderConfig{Group:"demo-widgets"},Items:[]layout.Item{
 {ID:"service",Label:"Service",Content:card.Card(card.Config{Title:"Media service",Description:"Healthy. Content keeps its own card presentation."})},
 {ID:"notes",Label:"Notes",Content:notes("layout-note")},
 {ID:"metrics",Label:"Metrics",Content:panel.Panel(panel.Config{Body:metrics()})},
 {ID:"chart",Label:"Trend",Content:line.Line(line.Config{Label:"Storage trend",Labels:[]string{"Mon","Tue","Wed"},Series:[]line.Series{{Name:"Used",Values:[]float64{40,42,45}}},Width:400,Height:240})},
 {ID:"short",Label:"Short note",Content:shortNote()},
 }}).WithContentDrag(true)
 <h3 class="font-semibold">Inbox</h3>
 @layout.Container(layout.Config{ID:"layout-inbox",Label:"Inbox",Mode:layout.ModeGrid,Columns:2,Reorder:&layout.ReorderConfig{Group:"demo-widgets"},RootClass:"min-h-24 border border-dashed border-outline p-4 dark:border-outline-dark"}).WithContentDrag(true)
 </div>
 </div>
}

templ notes(id string) {
 <div class="space-y-3"><h3 class="font-semibold">Maintenance notes</h3><p>This is plain content without a card wrapper. The renderer owns its natural height.</p><a href="#layout-fragment" class="underline">Read notes</a>@textinput.TextInput(textinput.Config{ID:id,Name:"draft-note",Label:"Draft note",Value:"Keep this draft"})</div>
}
templ shortNote() { <p>A short plain note.</p> }
templ metrics() { <div><h3>Storage usage</h3><table class="w-full"><caption class="sr-only">Storage usage by pool</caption><thead><tr><th>Pool</th><th>Used</th></tr></thead><tbody><tr><td>Fast</td><td>42%</td></tr><tr><td>Archive</td><td>71%</td></tr></tbody></table></div> }
templ nestedPreview() {
 <div class="w-full">
 @layout.Container(layout.Config{ID:"layout-groups",Label:"Groups",Mode:layout.ModeGrid,Columns:2,Reorder:&layout.ReorderConfig{Group:"demo-groups"},Items:[]layout.Item{{ID:"group-a",Label:"First group",Content:innerLayout()},{ID:"group-b",Label:"Second group",Content:notes("layout-group-note")}}}).WithContentDrag(true)
 </div>
}
templ innerLayout() {
 @layout.Container(layout.Config{ID:"layout-nested",Label:"Inner widgets",Mode:layout.ModeMasonry,Columns:3,Reorder:&layout.ReorderConfig{Group:"inner-only"},Items:[]layout.Item{{ID:"inner-a",Label:"Inner note",Content:shortNote()},{ID:"inner-b",Label:"Inner metrics",Content:metrics()}}})
}
templ stackPreview() {
 <div class="w-full">@layout.Container(layout.Config{ID:"layout-stack",Label:"Reading",Items:[]layout.Item{{ID:"stack-a",Label:"First",Content:shortNote()},{ID:"stack-b",Label:"Second",Content:metrics()}}})</div>
}
