package iconpage

import (
	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/radio"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// IconDemoPage renders a working sprite workbench: scan bundled glyphs, then
// configure one in the same focus-trapped modal used throughout Goshtoso.
templ IconDemoPage() {
	@demo.Layout("Icon", "icon", iconDemoContent())
}

templ iconDemoContent() {
	<div id="icon-fragment" x-data="iconCatalog" data-component-page>
		<div class="mb-8 max-w-3xl">
			<p class="mb-2 text-sm font-medium text-primary dark:text-primary-dark">Sprite icons</p>
			<h1 id="icon" data-toc-heading class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Icon</h1>
			<p data-component-description class="mt-3 text-lg text-on-surface-muted dark:text-on-surface-dark-muted">
				Browse bundled, typed symbols. Pick one to tune its exact <code class="font-mono text-sm">icon.Config</code> and copy a paste-ready <code class="font-mono text-sm">.templ</code> example.
			</p>
		</div>

		@iconUsageBasics()
		@iconPackExtension()
		@iconCatalogGrid()
		@iconPickerModal()
	</div>
}

templ iconUsageBasics() {
	<section data-component-preview class="mb-10 rounded-radius border border-outline bg-surface-alt/50 p-5 dark:border-outline-dark dark:bg-surface-dark-alt/40" aria-labelledby="icon-basics-title">
		<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
			<div>
				<h2 id="icon-basics-title" data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Accessible defaults, visible behavior</h2>
				<p class="mt-1 max-w-2xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">A label makes an image. An empty label or <code class="font-mono">Decorative: true</code> hides the SVG from assistive technology. Sprite paths inherit <code class="font-mono">currentColor</code>; Goshtoso never forces fill or stroke.</p>
			</div>
			<span class="shrink-0 rounded-full border border-outline bg-surface px-3 py-1 text-xs font-medium text-on-surface-muted dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-muted">67 bundled glyphs</span>
		</div>
		<dl class="mt-5 grid divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark md:grid-cols-3 md:divide-x md:divide-y-0">
			<div data-testid="icon-variant-accessible" class="flex items-center gap-3 py-3 md:pr-4">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidCheckCircle, Label: "Approved", RootClass: "text-success"})
				<div><dt class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Labelled image</dt><dd class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Announced as Approved</dd></div>
			</div>
			<div data-testid="icon-variant-decorative" class="flex items-center gap-3 py-3 md:px-4">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidSparkles, Decorative: true, RootClass: "text-primary"})
				<div><dt class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Decorative accent</dt><dd class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Hidden from assistive tech</dd></div>
			</div>
			<div data-testid="icon-variant-current-color" class="flex items-center gap-3 py-3 text-secondary md:pl-4 dark:text-secondary-dark">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidPaintBrush, Decorative: true})
				<div><dt class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">currentColor</dt><dd class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Color comes from its parent</dd></div>
			</div>
		</dl>
		<div class="mt-4 flex flex-wrap items-center gap-4 text-primary dark:text-primary-dark" aria-label="Icon size scale">
			<span class="mr-1 text-xs font-medium text-on-surface-muted dark:text-on-surface-dark-muted">Size scale</span>
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeXS})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeSM})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeMD})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeLG})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeXL})
		</div>
	</section>
}

templ iconPackExtension() {
	<section class="mb-10" aria-labelledby="iconpack-title">
		<div class="mb-4 max-w-3xl">
			<p class="mb-2 text-sm font-medium text-primary dark:text-primary-dark">Consumer-local extension</p>
			<h2 id="iconpack-title" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Generate an attributed icon pack</h2>
			<p class="mt-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
				Select assets from the <code class="font-mono">ui/heroicons</code> and <code class="font-mono">brand/developer-icons</code> families by exact Arai Hu Assets canonical name. <code class="font-mono">iconpack</code> verifies a release root or archive, then publishes a parallel consumer-owned sprite, typed Go component, manifest, provenance, and licenses. The curated embedded package stays unchanged.
			</p>
		</div>
		<div data-component-code>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "bash",
				Label: "Generate from a verified release archive",
				Code: `go run github.com/araihu/goshtoso/cmd/iconpack@v0.2.0 \
	-release-archive ./araihu-assets-v0.2.0.tar.gz \
	-archive-sha256 dcb97bbbbf98fb2e3c0e96b63eefb17b9b60eb2b3d8097fa6b4e2876f3f19271 -release v0.2.0 \
	-catalog-sha256 a0e8e5c8928e37de979ce9a60f3d66fad1aa1b4c7d2904f9275f0be9932a33d6 \
	-release-json-sha256 0650e51dd2b7ec7797622b3cdd9ff75dfd53cb1914155931014223bbd1684fa6 \
	-checksums-sha256 86dac118901d423117e20bd14ce6ed30717fca9c2a8244909c2be4b926ce1c4e \
	-name brand-developer-icons-tRPC \
	-out ./internal/appicons -package appicons \
	-const-prefix Icon -sprite-url /assets/icons/app.svg`,
			})
		</div>
		<p class="mt-3 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			JSON selection manifests are canonical; YAML compatibility is accepted. Read the <a href="https://github.com/araihu/goshtoso/blob/v0.2.0/docs/ICONPACK.md" target="_blank" rel="noreferrer">iconpack guide</a> covering release verification, output, attribution, and failure-safety contracts.
		</p>
	</section>
}

templ iconCatalogGrid() {
	<section aria-labelledby="icon-catalog-title">
		<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 id="icon-catalog-title" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Bundled symbol catalog</h2>
				<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Every card comes from <code class="font-mono">heroicons.Glyphs</code>, not a second hand-written list.</p>
			</div>
			<a href="https://github.com/tailwindlabs/heroicons/blob/master/LICENSE" target="_blank" rel="noreferrer" class="text-sm font-medium text-primary underline underline-offset-4 dark:text-primary-dark">Heroicons MIT license</a>
		</div>
		<div data-testid="icon-catalog-grid" class="grid grid-cols-1 sm:grid-cols-3 xl:grid-cols-6 gap-3">
			for _, glyph := range heroicons.Glyphs {
				@iconCatalogCard(glyph)
			}
		</div>
	</section>
}

templ iconCatalogCard(glyph heroicons.Glyph) {
	<button
		type="button"
		data-icon-card={ glyph.GoName }
		data-icon-name={ glyph.GoName }
		data-icon-symbol={ string(glyph.Symbol) }
		@click="selectGlyph($el)"
		class="group min-h-36 rounded-radius border border-outline bg-surface p-4 text-left transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark dark:focus-visible:outline-primary-dark"
	>
		<span class="mx-auto mb-5 flex size-11 items-center justify-center rounded-radius bg-primary/10 text-primary transition-transform group-hover:scale-105 dark:bg-primary-dark/15 dark:text-primary-dark">
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: glyph.Symbol, Decorative: true, RootClass: "size-6"})
		</span>
		<span class="block truncate font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong" title={ glyph.GoName }>{ glyph.GoName }</span>
		<span class="mt-1 block truncate font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ glyph.Symbol }</span>
	</button>
}

// iconPickerModal preserves the Goshtoso modal contract: x-trap brings focus
// containment and inert/noscroll behavior, Escape and backdrop dismiss it.
templ iconPickerModal() {
	<div
		x-cloak
		x-show="open"
		x-transition.opacity.duration.200ms
		x-trap.inert.noscroll="open"
		x-on:keydown.esc.window="close()"
		x-on:click.self="close()"
		class="fixed inset-0 z-30 flex items-end justify-center bg-black/20 p-4 pb-8 backdrop-blur-md sm:items-center lg:p-8"
		data-testid="icon-picker-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="icon-picker-title"
	>
		<div x-show="open" x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity" x-transition:enter-start="opacity-0 scale-50" x-transition:enter-end="opacity-100 scale-100" class="flex max-h-full w-full max-w-3xl flex-col overflow-auto rounded-radius border border-outline bg-surface text-on-surface dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark">
			<div class="flex items-center justify-between border-b border-outline bg-surface-alt/60 p-4 dark:border-outline-dark dark:bg-surface-dark/20">
				<div><p class="text-xs font-medium text-primary dark:text-primary-dark">Icon workbench</p><h2 id="icon-picker-title" class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong" x-text="selected.name"></h2></div>
				<button data-testid="icon-modal-close" type="button" @click="close()" aria-label="Close icon workbench" class="rounded-radius p-1 text-on-surface-muted hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-on-surface-dark-muted dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark">
					<span aria-hidden="true" class="text-xl leading-none">×</span>
				</button>
			</div>
			<div class="grid gap-6 p-5 md:grid-cols-[minmax(0,1fr)_18rem]">
				<div>
					<div class="flex min-h-44 items-center justify-center rounded-radius border border-dashed border-outline bg-surface-alt/40 text-primary dark:border-outline-dark dark:bg-surface-dark/30 dark:text-primary-dark">
						<svg data-testid="icon-live-preview" xmlns="http://www.w3.org/2000/svg" x-bind:class="previewClass" x-bind:aria-hidden="isDecorative" x-bind:role="isDecorative ? null : 'img'" x-bind:aria-label="isDecorative ? null : label" viewBox="0 0 24 24"><use x-bind:href="spriteHref"></use></svg>
					</div>
					<p class="mt-3 font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted" x-text="selected.symbol"></p>
					<div data-component-code class="mt-4" x-effect="document.querySelector('#icon-workbench-code code').textContent = code">
						@codeblock.CodeBlock(codeblock.Config{
							ID: "icon-workbench-code",
							Language: "templ",
							Label: "Paste into a .templ file",
							Code: `@icon.Icon(icon.Config{
	SpriteURL: heroicons.SpriteURL,
	Symbol:    heroicons.Icon16SolidArrowDown,
	Size:      icon.SizeXL,
	RootClass: "text-danger",
})`,
						})
					</div>
				</div>
				<div class="space-y-4">
					<div>
						<span id="icon-size-label" class="mb-1 block text-sm font-medium">Size</span>
						<div data-testid="icon-size-selector" role="group" aria-labelledby="icon-size-label">
							@radio.RadioBar() {
								@iconSizeOption("xs", "xs", "icon-size-xs")
								@iconSizeOption("sm", "sm", "icon-size-sm")
								@iconSizeOption("", "md", "icon-size-md")
								@iconSizeOption("lg", "lg", "icon-size-lg")
								@iconSizeOption("xl", "xl", "icon-size-xl")
							}
						</div>
						<span class="sr-only" data-testid="icon-size-selected" x-text="size || 'md'"></span>
					</div>
					<div>
						@textinput.TextInput(textinput.Config{
							ID: "icon-label",
							Name: "icon-label",
							Label: "Label",
							Placeholder: "e.g. Search",
							InputAttrs: templpkg.Attributes{
								"x-model": "label",
								"x-bind:disabled": "decorative",
							},
						})
						<p class="mt-1 text-xs text-on-surface-muted dark:text-on-surface-dark-muted" x-show="!decorative && !label.trim()">Blank label renders a decorative icon.</p>
					</div>
					<div class="rounded-radius border border-outline p-3 dark:border-outline-dark">
						@checkbox.Checkbox(checkbox.Config{
							ID: "icon-decorative",
							Name: "icon-decorative",
							Label: "Decorative",
							HelperText: "Clears label and hides SVG from assistive technology.",
							HelperTextID: "icon-decorative-helper",
							InputAttrs: templpkg.Attributes{"x-model": "decorative"},
						})
					</div>
					@selectfield.Select(selectfield.Config{
						ID: "icon-root-class",
						Name: "icon-root-class",
						Label: "Color",
						Options: []selectfield.Option{
							{Value: "text-primary", Label: "Primary", Selected: true},
							{Value: "text-secondary", Label: "Secondary"},
							{Value: "text-success", Label: "Success"},
							{Value: "text-warning", Label: "Warning"},
							{Value: "text-danger", Label: "Danger"},
						},
						Alpine: &selectfield.AlpineConfig{Model: "rootClass"},
					})
					<p class="rounded-radius border border-outline bg-surface-alt/50 p-3 text-xs text-on-surface-muted dark:border-outline-dark dark:bg-surface-dark/30 dark:text-on-surface-dark-muted"><code class="font-mono">SpriteURL</code> is <code class="font-mono">heroicons.SpriteURL</code>; <code class="font-mono">ModeExternal</code> is its zero-value default.</p>
				</div>
			</div>
		</div>
	</div>
}

templ iconSizeOption(value, label, id string) {
	@radio.Radio(radio.Config{
		ID: id,
		Name: "icon-size",
		Value: value,
		Label: label,
		Checked: value == "xl",
		Segmented: true,
		Alpine: &radio.AlpineConfig{
			BindChecked: "size === '" + value + "'",
			OnChange: "size = '" + value + "'",
		},
	})
}
