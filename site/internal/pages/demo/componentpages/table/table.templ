templ tableEditButton() {
	@button.Button(
		button.WithSize(button.SizeSmall),
		button.WithRootClass("!rounded-radius !border-transparent !bg-transparent !p-0.5 !text-primary dark:!text-primary-dark cursor-pointer"),
	) {
		Edit
	}
}

func actionRows() []table.Row {
	return []table.Row{
		{ID: "2335", Cells: map[string]table.Cell{
			"id":     {Text: "2335"},
			"name":   {Text: "Alice Brown"},
			"email":  {Text: "alice.brown@gmail.com"},
			"action": {Component: tableEditButton()},
		}},
		{ID: "2338", Cells: map[string]table.Cell{
			"id":     {Text: "2338"},
			"name":   {Text: "Bob Johnson"},
			"email":  {Text: "johnson.bob@outlook.com"},
			"action": {Component: tableEditButton()},
		}},
		{ID: "2342", Cells: map[string]table.Cell{
			"id":     {Text: "2342"},
			"name":   {Text: "Sarah Adams"},
			"email":  {Text: "s.adams@gmail.com"},
			"action": {Component: tableEditButton()},
		}},
	}
}

func linkedActionRows() []table.Row {
	rows := defaultRows()
	for index := range rows {
		rows[index].Link = "/components/table#table-linked-actions"
		rows[index].LinkMode = table.LinkFull
		rows[index].Actions = tableEditButton()
	}
	return rows
}

func checkboxRows() []table.Row {
	return []table.Row{
		{ID: "2335", Cells: map[string]table.Cell{
			"id":     {Text: "2335"},
			"name":   {Text: "Alice Brown"},
			"email":  {Text: "alice.brown@gmail.com"},
			"action": {Component: tableEditButton()},
		}},
		{ID: "2338", Cells: map[string]table.Cell{
			"id":     {Text: "2338"},
			"name":   {Text: "Bob Johnson"},
			"email":  {Text: "johnson.bob@outlook.com"},
			"action": {Component: tableEditButton()},
