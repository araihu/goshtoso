package searchpage

import (
	"github.com/araihu/goshtoso/components/search"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// SearchDemoPage renders the Search component demo.
templ SearchDemoPage() {
	@demo.Layout("Search", "search", searchDemoContent())
}

templ searchDemoContent() {
	<div id="search-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Search",
				Description: "Open a command-palette style search dialog from a compact trigger. Result data is supplied by the caller.",
			},
			searchDefaultPreview(),
			`@search.Search(search.Config{
    ID:          "component-search",
    Label:       "Search",
    Placeholder: "Search docs...",
    Items: []search.Item{
        {Title: "Sidebar", Description: "Navigation with grouped sections.", Href: "/components/sidebar", Section: "Navigation"},
        {Title: "List teams", Description: "Operation result with method and route metadata.", Href: "/api/teams", Kind: "Operation", Method: "GET", Path: "/teams", Section: "API"},
        {Title: "KBD", Description: "Semantic keyboard shortcuts.", Href: "/components/kbd", Section: "Display"},
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Custom Results",
				Description: "Use Item fields and Attrs to decide where results navigate and how they integrate with the host app.",
			},
			searchCustomPreview(),
			`@search.Search(search.Config{
    ID:           "custom-search",
    Label:        "Search patterns",
    Placeholder:  "Try form, modal, or nav",
    ShortcutText: "Ctrl K",
    Items: []search.Item{
        {Title: "Form controls", Section: "Guide", Keywords: []string{"input select checkbox"}},
        {Title: "Overlay flows", Section: "Guide", Keywords: []string{"modal drawer search"}},
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Fuzzy Results",
				Description: "Set MatchModeFuzzy to rank deterministic compact subsequence matches after exact substring matches.",
			},
			searchFuzzyPreview(),
			`@search.Search(search.Config{
    ID:        "fuzzy-search",
    MatchMode: search.MatchModeFuzzy,
    Items: []search.Item{
        {Title: "Search result map", Href: "/components/search"},
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Remote Results",
				Description: "Load result records from a JSON endpoint, then fuzzy-rank and navigate in the browser.",
			},
			searchRemotePreview(),
			`@search.Search(search.Config{
    ID:          "remote-search",
    Label:       "Remote search",
    Placeholder: "Search fetched results",
    ItemsURL:    "/api/components/search/items",
	MatchMode:    search.MatchModeFuzzy,
})`,
		)
	</div>
}

templ searchDefaultPreview() {
	<div id="search-default" class="mx-auto w-full max-w-sm">
		@search.Search(search.Config{
			ID:          "component-search",
			Label:       "Search",
			Placeholder: "Search docs...",
			Items: []search.Item{
				{ID: "search-demo-sidebar", Title: "Sidebar", Description: "Navigation with grouped sections and optional search slot.", Href: "/components/sidebar", Section: "Navigation", Keywords: []string{"menu docs"}},
				{ID: "search-demo-list-teams", Title: "List teams", Description: "Operation result with method and route metadata.", Href: "/api/teams", Kind: "Operation", Method: "GET", Path: "/teams", Section: "API", Keywords: []string{"teams operation"}},
				{ID: "search-demo-dependencies", Title: "Dependencies", Description: "Local CSS and JavaScript runtime tags.", Href: "/components/dependencies", Section: "Display", Keywords: []string{"head assets runtime"}},
				{ID: "search-demo-kbd", Title: "KBD", Description: "Semantic keyboard shortcut hints.", Href: "/components/kbd", Section: "Display", Keywords: []string{"shortcut key"}},
				{ID: "search-demo-text-input", Title: "Text Input", Description: "Inputs with search, password, masks, and validation states.", Href: "/components/text-input", Section: "Form", Keywords: []string{"field"}},
			},
		})
	</div>
}

templ searchRemotePreview() {
	<div id="search-remote" class="mx-auto w-full max-w-sm">
		@search.Search(search.Config{
			ID:          "remote-search",
			Label:       "Remote search",
			Placeholder: "Search fetched results",
			ItemsURL:    "/api/components/search/items",
			MatchMode:   search.MatchModeFuzzy,
		})
	</div>
}

templ searchFuzzyPreview() {
	<div id="search-fuzzy" class="mx-auto w-full max-w-sm">
		@search.Search(search.Config{
			ID:          "fuzzy-search",
			Label:       "Fuzzy search",
			Placeholder: "Try srm",
			MatchMode:   search.MatchModeFuzzy,
			Items: []search.Item{
				{ID: "search-fuzzy-result", Title: "Search result map", Description: "A compact subsequence can match across words.", Href: "/components/search", Section: "Fuzzy"},
			},
		})
	</div>
}

templ searchCustomPreview() {
	<div id="search-custom" class="mx-auto w-full max-w-sm">
		@search.Search(search.Config{
			ID:           "custom-search",
			Label:        "Search patterns",
			Placeholder:  "Try form, modal, or nav",
			ShortcutText: "Ctrl K",
			Items: []search.Item{
				{ID: "search-pattern-form", Title: "Form controls", Description: "Inputs, selects, comboboxes, and validation patterns.", Href: "/components/form", Section: "Guide", Keywords: []string{"input select checkbox"}},
				{ID: "search-pattern-schema-form", Title: "Schema Form", Description: "Generate complete forms from JSON Schema defaults, submitted values, and allow-list rules.", Href: "/components/schema-form", Section: "Guide", Keywords: []string{"schema form values"}},
				{ID: "search-pattern-overlay", Title: "Overlay flows", Description: "Modal-like surfaces, focus traps, and keyboard dismissal.", Href: "/components/drawer", Section: "Guide", Keywords: []string{"modal drawer command palette"}},
				{ID: "search-pattern-navigation", Title: "Navigation surfaces", Description: "Sidebar, navbar, breadcrumbs, and page-to-page movement.", Href: "/components/sidebar", Section: "Guide", Keywords: []string{"nav menu docs"}},
			},
		})
	</div>
}
