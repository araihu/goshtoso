package modulespages

import (
	templpkg "github.com/a-h/templ"
	"github.com/araihu/goshtoso-app-shells/componentpage"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/pageheader"
)

templ appShellsComponentPageContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Component Page",
		Description: "A component reference page with previews, code samples, variants, and usage notes.",
		RootAttrs:   templpkg.Attributes{"class": "mx-auto max-w-4xl"},
		Primary: componentpage.Example{
			PreviewLabel: "Page header",
			Preview:      appShellsComponentPagePreview(),
			Code:         appShellsComponentPageCode(),
		},
		Sections: []componentpage.Example{
			{
				Title:       "Disabled state",
				Description: "Add a section for each state readers need to see, such as a disabled button.",
				Preview:     appShellsComponentPageStatesPreview(),
				Code:        appShellsComponentPageStatesCode(),
			},
		},
		After: appShellsComponentPageGuidance(),
	})
}

templ appShellsComponentPagePreview() {
	<div class="space-y-5">
		@pageheader.PageHeader(pageheader.Config{
			Title:       "Deployments",
			Description: "View deployments and create a new one.",
			Actions:     appShellsPreviewAction(),
		})
		<div class="divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark">
			<div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6">
				<span class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Preview</span>
				<span class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">Show the component as it appears in your application.</span>
			</div>
			<div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6">
				<span class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Source</span>
				<span class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">Place copyable Go and templ code beside the preview.</span>
			</div>
			<div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-6">
				<span class="text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Guidance</span>
				<span class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">Explain when to use the component and which options to set.</span>
			</div>
		</div>
	</div>
}

templ appShellsComponentPageStatesPreview() {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-outline pb-4 dark:border-outline-dark">
			<div>
				<p class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Button</p>
				<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">The Continue button is disabled.</p>
			</div>
			@button.Button(button.Disabled()) { Continue }
		</div>
		<p class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">Each example accepts a description, preview, code sample, and heading anchor.</p>
	</div>
}

templ appShellsPreviewAction() {
	@button.Button(button.WithSize(button.SizeSmall)) { Create deployment }
}

templ appShellsComponentPageGuidance() {
	<section class="space-y-4 border-t border-outline pt-8 dark:border-outline-dark" aria-labelledby="component-page-install-title">
		<h2 id="component-page-install-title" data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Install and use</h2>
		@codeblock.CodeBlock(codeblock.Config{
			ID:       "app-shells-component-page-install",
			Language: "bash",
			Label:    "Install",
			Code:     "go get github.com/araihu/goshtoso-app-shells/componentpage@" + appShellsVersion,
			Density:  codeblock.DensityCompact,
		})
		<p class="max-w-3xl text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted"><code class="font-mono">componentpage</code> renders content inside a document shell. Load the runtime scripts and mount the asset handlers in that shell.</p>
	</section>
	<section class="border-t border-outline pt-8 dark:border-outline-dark" aria-labelledby="component-page-boundary-title">
		<h2 id="component-page-boundary-title" data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">What you provide</h2>
		<p class="mt-2 max-w-3xl leading-7 text-on-surface dark:text-on-surface-dark">Pass your previews, code samples, descriptions, and controls to the frame. It arranges them into sections with labels, spacing, and formatted code.</p>
	</section>
}

templ appShellsComponentDocsShellContent() {
	@appShellPackagePage(
		"Component Docs Shell",
		"componentdocshell",
		"A documentation layout with sidebar search, section navigation, and a table of contents.",
		"app-shells-component-docs-shell",
		appShellsComponentDocsShellPreview(),
		appShellsComponentDocsShellCode(),
		"https://pkg.go.dev/github.com/araihu/goshtoso-app-shells@" + appShellsVersion + "/componentdocshell",
		appShellsComponentDocsFragmentGuidance(),
	)
}

templ appShellsConsoleShellContent() {
	@appShellPackagePage(
		"Console Shell",
		"consoleshell",
		"An application layout with a persistent header and sidebar, a mobile drawer, and HTMX page navigation.",
		"app-shells-console-shell",
		appShellsConsoleShellPreview(),
		appShellsConsoleShellCode(),
		"https://pkg.go.dev/github.com/araihu/goshtoso-app-shells@" + appShellsVersion + "/consoleshell",
		appShellsConsoleFragmentGuidance(),
	)
}

templ appShellsLandingShellContent() {
	@appShellPackagePage(
		"Landing Shell",
		"landingshell",
		"A landing page layout with a responsive header, theme controls, a hero section, and footer links.",
		"app-shells-landing-shell",
		appShellsLandingShellPreview(),
		appShellsLandingShellCode(),
		"https://pkg.go.dev/github.com/araihu/goshtoso-app-shells@" + appShellsVersion + "/landingshell",
		appShellsLandingResponseGuidance(),
	)
}

templ appShellPackagePage(title, packageName, description, codeID string, preview templpkg.Component, code, packageURL string, responseGuidance templpkg.Component) {
	<div class="mx-auto max-w-4xl space-y-10">
		<header class="space-y-4">
			<p class="text-sm font-semibold text-primary dark:text-primary-dark">Goshtoso App Shells</p>
			<h1 class="font-title text-3xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">{ title }</h1>
			<p class="max-w-3xl text-lg leading-8 text-on-surface dark:text-on-surface-dark">{ description }</p>
			<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
				<code class="font-mono text-primary dark:text-primary-dark">{ packageName }</code>
				<a href={ templpkg.SafeURL(packageURL) } target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2 dark:text-primary-dark">Open API documentation</a>
			</div>
		</header>

		<section class="space-y-4" aria-labelledby={ codeID + "-preview-title" }>
			<div>
				<h2 id={ codeID + "-preview-title" } data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Try it live</h2>
				<p class="mt-2 max-w-3xl text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">A working example with its own navigation, theme controls, and viewport.</p>
			</div>
			<div data-app-shell-package={ packageName } class="overflow-hidden rounded-radius border border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark">
				@preview
			</div>
		</section>

		<details class="rounded-radius border border-outline p-5 dark:border-outline-dark">
			<summary class="cursor-pointer text-lg font-semibold">Setup and integration</summary>
			<div class="mt-6 space-y-8">
		<section class="space-y-4" aria-labelledby={ codeID + "-code-title" }>
			<h2 id={ codeID + "-code-title" } data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Install and use</h2>
			@codeblock.CodeBlock(codeblock.Config{
				ID:       codeID + "-install",
				Language: "bash",
				Label:    "Install",
				Code:     "go get github.com/araihu/goshtoso-app-shells/" + packageName + "@" + appShellsVersion,
				Density:  codeblock.DensityCompact,
			})
			@codeblock.CodeBlock(codeblock.Config{
				ID:       codeID + "-code",
				Language: "go",
				Label:    "Asset handlers and layout",
				Code:     code,
			})
		</section>

		if responseGuidance != nil {
			@responseGuidance
		}

		<section class="border-t border-outline pt-8 dark:border-outline-dark" aria-labelledby={ codeID + "-boundary-title" }>
			<h2 id={ codeID + "-boundary-title" } data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">What you provide</h2>
			<p class="mt-2 max-w-3xl leading-7 text-on-surface dark:text-on-surface-dark">Configure the brand, navigation links, and page metadata, then pass in your content. Your application handles routes, permissions, and data.</p>
		</section>
			</div>
		</details>
	</div>
}

templ appShellsComponentDocsShellPreview() {
 @appShellLivePreview("componentdocshell", "Navigate between Overview and Activity, search the sidebar, and try the mobile drawer.")
}

templ appShellsComponentDocsFragmentGuidance() {
 <p class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">Add your application’s global search to <code>HeaderActions</code>. The shell’s sidebar search filters local navigation.</p>
	@appShellsFragmentGuidance(
		"app-shells-component-docs-shell-fragments",
		"Return Layout for ordinary browser requests. With EnableHTMX enabled, return Fragment when HX-Request-Type is partial. This updates the current page without inserting a second HTML document.",
		"Component Docs Shell Fragment updates the document title and replaces the main content, scoped sidebar, and family navigation out of band, including their active links.",
		appShellsComponentDocsShellFragmentCode(),
	)
}

templ appShellsConsoleFragmentGuidance() {
	@appShellsFragmentGuidance(
		"app-shells-console-shell-fragments",
		"Return Layout for ordinary browser requests. With EnableHTMX enabled, return Fragment when HX-Request-Type is partial. This updates the current page without inserting a second HTML document.",
		"Console Shell Fragment updates the document title and main content. Enable NavigationOOB to replace the sidebar in the same response and update its active link.",
		appShellsConsoleShellFragmentCode(),
	)
}

templ appShellsFragmentGuidance(id, summary, contract, code string) {
	<section class="space-y-4 border-t border-outline pt-8 dark:border-outline-dark" aria-labelledby={ id + "-title" }>
		<div class="space-y-2">
			<h2 id={ id + "-title" } data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Full documents and HTMX fragments</h2>
			<p class="max-w-3xl leading-7 text-on-surface dark:text-on-surface-dark">{ summary }</p>
			<p class="max-w-3xl text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">{ contract }</p>
		</div>
		@codeblock.CodeBlock(codeblock.Config{
			ID:       id + "-code",
			Language: "go",
			Label:    "HTTP response selection",
			Code:     code,
		})
	</section>
}

templ appShellsLandingResponseGuidance() {
	<section class="space-y-2 border-t border-outline pt-8 dark:border-outline-dark" aria-labelledby="app-shells-landing-response-title">
		<h2 id="app-shells-landing-response-title" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Full-document response</h2>
		<p class="max-w-3xl leading-7 text-on-surface dark:text-on-surface-dark"><code class="font-mono">landingshell</code> has no <code class="font-mono">Fragment</code> API in v0.1.9-0.20260910224508-5b2222e54637. Use <code class="font-mono">Layout</code> to render complete public pages; render any HTMX fragments within your page content.</p>
	</section>
}

templ appShellsConsoleShellPreview() {
 @appShellLivePreview("consoleshell", "Switch routes without losing the application frame. Try the navigation menu at mobile size.")
}

templ appShellsLandingShellPreview() {
 @appShellLivePreview("landingshell", "Explore the header links, appearance controls, mobile menu, and footer.")
}

// Frames isolate shell layout, focus, navigation and styles from the documentation.
templ appShellLivePreview(family, hint string) {
 <div x-data="shellPreview">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-outline bg-surface-alt p-3 dark:border-outline-dark dark:bg-surface-dark-alt">
   <div class="flex gap-2" role="group" aria-label="Preview viewport">
    <button type="button" class="rounded-radius border border-outline px-3 py-2 text-sm dark:border-outline-dark" x-on:click="mobile = false" x-bind:class="mobile ? '' : 'bg-surface dark:bg-surface-dark'" x-bind:aria-pressed="!mobile">Desktop</button>
    <button type="button" class="rounded-radius border border-outline px-3 py-2 text-sm dark:border-outline-dark" x-on:click="mobile = true" x-bind:class="mobile ? 'bg-surface dark:bg-surface-dark' : ''" x-bind:aria-pressed="mobile">Mobile</button>
   </div>
   <a href={templpkg.URL("/modules/app-shells/live/"+family+"/overview")} target="_blank" rel="noopener" class="text-sm font-semibold text-primary underline underline-offset-2 dark:text-primary-dark">Open full example ↗</a>
  </div>
  <div x-ref="stage" class="relative w-full overflow-hidden bg-surface-alt dark:bg-surface-dark-alt" x-bind:style="stageStyle" style="min-height: 240px;">
   <iframe src={templpkg.URL("/modules/app-shells/live/"+family+"/overview")} title={family+" live example"} loading="lazy" class="border-0" x-bind:style="frameStyle"></iframe>
  </div>
  <p class="border-t border-outline p-4 text-sm leading-6 text-on-surface-muted dark:border-outline-dark dark:text-on-surface-dark-muted">{hint}</p>
 </div>
}
