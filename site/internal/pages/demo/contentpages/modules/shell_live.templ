package modulespages


templ shellDocsContent(active string) {
 <div class="mx-auto max-w-3xl space-y-8 p-6">
  <header class="space-y-3"><p class="text-sm font-semibold text-primary dark:text-primary-dark">ATLAS / DOCUMENTATION</p><h1 class="text-3xl font-bold">{ shellExampleTitle(active, "Build your first workspace", "What’s new in Atlas") }</h1><p class="text-on-surface-muted dark:text-on-surface-dark-muted">Everything your team needs to get from a first idea to a shared project.</p></header>
  <section class="space-y-3"><h2 id="quick-start" data-toc-heading class="text-xl font-semibold">Quick start</h2><p>Create a workspace, invite your team, and give your first project a home.</p><pre class="overflow-auto rounded-radius bg-surface-alt p-5 dark:bg-surface-dark-alt"><code>atlas init my-workspace</code></pre></section>
  <section class="space-y-4"><h2 id="next-steps" data-toc-heading class="text-xl font-semibold">Next steps</h2><div class="grid gap-4 sm:grid-cols-2"><article class="rounded-radius border border-outline p-5 dark:border-outline-dark"><h3 class="font-semibold">Invite your team</h3><p class="mt-2 text-sm">Bring your collaborators into one shared space.</p></article><article class="rounded-radius border border-outline p-5 dark:border-outline-dark"><h3 class="font-semibold">Ship your first project</h3><p class="mt-2 text-sm">Keep decisions, milestones, and updates together.</p></article></div></section>
  <section class="space-y-3"><h2 id="workflow" data-toc-heading class="text-xl font-semibold">A simpler workflow</h2><p>Start small. Add context as your project grows, and keep the next step visible to everyone.</p></section>
 </div>
}

templ shellConsoleContent(active string) {
 <div class="space-y-8 p-6">
  <header class="flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Workspace / Production</p><h1 class="mt-2 text-3xl font-bold">{ shellExampleTitle(active,"Project overview","Recent activity") }</h1></div><span class="rounded-radius border border-success px-3 py-2 text-sm text-success-text dark:text-success-text-dark">All systems operational</span></header>
  <div class="grid gap-4 sm:grid-cols-3">
   for _, stat := range []struct{Label,Value string}{{"Active projects","12"},{"Deployments this week","48"},{"Availability","99.98%"}} {
    <article class="rounded-radius border border-outline bg-surface-alt p-5 dark:border-outline-dark dark:bg-surface-dark-alt"><p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{stat.Label}</p><p class="mt-3 text-3xl font-bold">{stat.Value}</p></article>
   }
  </div>
  <section class="overflow-hidden rounded-radius border border-outline dark:border-outline-dark"><h2 class="border-b border-outline p-5 text-lg font-semibold dark:border-outline-dark">Latest deployments</h2><div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="bg-surface-alt dark:bg-surface-dark-alt"><th class="p-4">Project</th><th class="p-4">Environment</th><th class="p-4">Status</th><th class="p-4">Updated</th></tr></thead><tbody>
   for _, project := range []string{"Atlas API","Customer portal","Documentation"} {
    <tr class="border-t border-outline dark:border-outline-dark"><td class="p-4 font-medium">{project}</td><td class="p-4">Production</td><td class="p-4 text-success-text dark:text-success-text-dark">Ready</td><td class="p-4">A few minutes ago</td></tr>
   }
  </tbody></table></div></section>
 </div>
}

templ shellLandingHero(base, active string) {
 <div class="mx-auto max-w-4xl space-y-6 px-6 py-16 text-center">
  <p class="text-sm font-semibold uppercase tracking-widest text-primary dark:text-primary-dark">A little less busywork</p><h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{shellExampleTitle(active,"Good work starts with a clear space.","Small steps. Meaningful progress.")}</h1><p class="mx-auto max-w-2xl text-lg leading-8 text-on-surface-muted dark:text-on-surface-dark-muted">Bring your projects, people, and next steps together. Atlas makes room for the work that matters.</p><a href={templ.URL(base+"activity")} class="inline-flex rounded-radius bg-primary px-6 py-3 font-semibold text-on-primary dark:bg-primary-dark dark:text-on-primary-dark"><span class="text-on-primary dark:text-on-primary-dark">Explore the workspace →</span></a>
 </div>
}

templ shellLandingContent() {
 <section class="mx-auto grid max-w-5xl gap-6 px-6 pb-16 sm:grid-cols-3">
  for _, feature := range []struct{Title,Description string}{{"One shared home","Keep projects and decisions easy to find."},{"A clear next step","Turn good conversations into meaningful progress."},{"Built around your team","Make space for the way you already work."}} {
   <article class="rounded-radius border border-outline p-6 dark:border-outline-dark"><h2 class="text-lg font-semibold">{feature.Title}</h2><p class="mt-3 text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">{feature.Description}</p></article>
  }
 </section>
}

func shellExampleTitle(active, overview, activity string) string {
 if active == "activity" { return activity }
 return overview
}
