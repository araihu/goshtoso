package modulespages

import (
	"github.com/araihu/goshtoso-charts/components/dependencies"
	"github.com/araihu/goshtoso/components/head"
	siteassets "github.com/araihu/goshtoso/site/assets"
)

templ ChartsShowcaseFrame() {
	@ChartsShowcaseFrameFor(chartsShowcaseLine3D)
}

templ ChartsShowcaseFrameFor(kind chartsShowcaseKind) {
	<iframe
		id={ "charts-showcase-frame-" + string(kind) }
		data-charts-showcase-frame={ string(kind) }
		title={ chartsShowcaseTitle(kind) }
		src={ templ.SafeURL("/playground/extensions/charts?variant=" + string(kind)) }
		loading="eager"
		scrolling="no"
		class="block h-[30rem] w-full overflow-hidden bg-transparent"
	></iframe>
}

templ ChartsShowcasePage() {
	@ChartsShowcasePageFor(chartsShowcaseLine3D)
}

templ ChartsShowcasePageFor(kind chartsShowcaseKind) {
	<!DOCTYPE html>
	<html lang="en" data-theme="araihu" class="dark overflow-hidden" data-charts-showcase data-charts-showcase-kind={ string(kind) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="robots" content="noindex"/>
			<title>Goshtoso Charts extension showcase</title>
			@head.DependenciesMinimal(head.WithLocalRuntime())
			<link rel="stylesheet" href="/componentdocshell/assets/araihu.css"/>
			@dependencies.Dependencies()
			<style>
				[data-charts-showcase] body { margin: 0; overflow: hidden; }
				[data-charts-showcase] [data-line3d-exact-data],
				[data-charts-showcase] details { display: none; }
				[data-charts-showcase] figure { max-width: 100%; }
				[data-charts-showcase] svg { max-width: 100%; height: auto; }
				[data-charts-showcase] [data-chart-fallback][hidden] { display: none; }
			</style>
		</head>
		<body class="bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			<main class="relative min-h-screen overflow-hidden rounded-radius border border-outline bg-surface p-4 dark:border-outline-dark dark:bg-surface-dark sm:p-6" aria-labelledby="charts-showcase-title">
				<header class="mb-3">
					<div>
						<p class="text-xs font-bold uppercase text-primary dark:text-primary-dark">Live extension</p>
						<h1 id="charts-showcase-title" class="mt-1 font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ chartsShowcaseHeading(kind) }</h1>
					</div>
				</header>
				<section data-showcase-chart={ string(kind) } aria-label={ chartsShowcaseTitle(kind) }>
					if kind == chartsShowcaseStatic {
						@chartsShowcaseStaticLine()
					} else if kind == chartsShowcaseInteractive {
						@chartsShowcaseInteractiveLine()
					} else {
						@chartsShowcaseLine()
					}
				</section>
				if kind != chartsShowcaseStatic {
					<div data-chart-fallback class="absolute inset-4 flex items-center justify-center rounded-radius border border-outline bg-surface p-6 text-center dark:border-outline-dark dark:bg-surface-dark sm:inset-6">
						<p class="max-w-md text-sm leading-6 text-on-surface dark:text-on-surface-dark">Loading local interactive charts.</p>
					</div>
				}
			</main>
			if kind != chartsShowcaseStatic {
				<script src={ siteassets.ChartsShowcaseBundleURL }></script>
			}
		</body>
	</html>
}
