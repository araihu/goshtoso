package charts

import (
	"fmt"

	"github.com/araihu/goshtoso-charts/components/bar"
	"github.com/araihu/goshtoso-charts/components/heatmap"
	"github.com/araihu/goshtoso-charts/components/line"
	"github.com/araihu/goshtoso-charts/components/pie"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/form"
)

templ paletteChartControlSection(state paletteChartControlState) {
	<article class="min-w-0 space-y-5" data-chart-control-demo="palette-grid">
		<div class="space-y-2">
			<h3 class="font-title text-xl font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">One palette, four chart semantics</h3>
			<p class="max-w-3xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">One chart palette changes a line stroke and area, two bar-series fills, ordered pie sectors, and a cold-to-warm heat-map gradient together. Theme tokens are the default; the custom option sends four validated colors while exact values remain adjacent to every chart.</p>
			<p class="max-w-3xl text-xs text-on-surface-muted dark:text-on-surface-dark-muted">The Goshtoso swatch palette is an event-driven color-name picker. Native palette and color inputs are used here so the same server form remains editable without JavaScript.</p>
		</div>
		@paletteChartControlExample(state)
		<div class="min-w-0" data-chart-control-source="palette-grid">
			@codeblock.CodeBlock(codeblock.Config{ID: "palette-chart-control-source", Language: "templ", Label: "Palette form and four charts · templ", Code: paletteChartControlSource, MaxHeight: "42rem"})
		</div>
	</article>
}

templ paletteChartControlExample(state paletteChartControlState) {
	<div id={ paletteChartControlTarget } class="min-w-0 space-y-5 rounded-radius border border-outline p-4 sm:p-5 dark:border-outline-dark" data-chart-control-example="palette-grid" data-chart-palette={ state.PaletteValue }>
		@form.Form(form.Config{
			ID:                 "palette-chart-control-form",
			Action:             "/modules/charts/docs/chart-controls#" + paletteChartControlTarget,
			Method:             "get",
			PreventEnterSubmit: boolPointer(false),
			RootClass:          "space-y-4",
			HTMX: &form.HTMXConfig{
				Get:    "/modules/charts/docs/chart-controls",
				Target: "#" + paletteChartControlTarget,
				Swap:   "outerHTML focus-scroll:false",
			},
		}) {
			<input type="hidden" name="palette_present" value="1"/>
			<fieldset class="m-0 grid min-w-0 gap-4 border-0 p-0 lg:grid-cols-[minmax(12rem,1.25fr)_repeat(4,minmax(7rem,1fr))_auto] lg:items-end">
				<legend class="sr-only">Shared chart palette controls</legend>
				@form.FieldGroup(form.FieldGroupConfig{ID: "chart-palette", RootID: "chart-palette-field", Label: "Chart palette", Hints: []string{"Built-ins keep chart theme classes and tokens. Custom validates four explicit colors."}}) {
					<select id="chart-palette" name="chart_palette" aria-describedby="chart-palette-hints" class="min-h-11 w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface-strong focus-visible:outline-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark" { chartControlHTMXAttrs(paletteChartControlTarget)... }>
						<option value="theme" selected?={ state.PaletteValue == "theme" }>Theme tokens</option>
						<option value="araihu" selected?={ state.PaletteValue == "araihu" }>Arai Hû</option>
						<option value="bold" selected?={ state.PaletteValue == "bold" }>Bold</option>
						<option value="neutral" selected?={ state.PaletteValue == "neutral" }>Neutral</option>
						<option value="pastel" selected?={ state.PaletteValue == "pastel" }>Pastel</option>
						<option value="status" selected?={ state.PaletteValue == "status" }>Status</option>
						<option value="custom" selected?={ state.PaletteValue == "custom" }>Custom four colors</option>
					</select>
				}
				for index, color := range state.Colors {
					<div class="space-y-2">
						<label for={ fmt.Sprintf("palette-color-%d", index+1) } class="block text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">{ paletteColorLabel(index) }</label>
						<input id={ fmt.Sprintf("palette-color-%d", index+1) } type="color" name={ fmt.Sprintf("palette_color_%d", index+1) } value={ color } disabled?={ !state.Custom } aria-describedby={ fmt.Sprintf("palette-color-%d-help", index+1) } class="min-h-11 w-full min-w-0 cursor-pointer rounded-radius border border-outline bg-surface p-1 disabled:cursor-not-allowed disabled:opacity-50 dark:border-outline-dark dark:bg-surface-dark" { chartControlHTMXAttrs(paletteChartControlTarget)... }/>
						<p id={ fmt.Sprintf("palette-color-%d-help", index+1) } class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ color }</p>
					</div>
				}
				@button.Button(button.WithType("submit"), button.WithID("palette-apply"), button.WithRootClass("w-full lg:w-auto"), button.WithLoadingText("Applying…")) { Apply palette }
			</fieldset>
			if len(state.Errors) > 0 {
				<p role="alert" aria-live="polite" class="rounded-radius border border-danger bg-danger/10 px-4 py-3 text-sm text-danger-text dark:border-danger dark:bg-danger/15 dark:text-danger-text-dark" data-chart-control-errors="palette-grid">{ joinedErrors(state.Errors) }</p>
			}
			<p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong" aria-live="polite" data-chart-control-state="palette-grid">Applied: { paletteAppliedText(state) }.</p>
		}
		<div class="grid min-w-0 gap-5 lg:grid-cols-2" data-palette-chart-grid>
			<div class="min-w-0 rounded-radius border border-outline p-3 dark:border-outline-dark" data-palette-chart="line">
				@line.Line(paletteLineConfig(state))
			</div>
			<div class="min-w-0 rounded-radius border border-outline p-3 dark:border-outline-dark" data-palette-chart="bar">
				@bar.Bar(paletteBarConfig(state))
			</div>
			<div class="min-w-0 rounded-radius border border-outline p-3 dark:border-outline-dark" data-palette-chart="pie">
				@pie.Pie(palettePieConfig(state))
			</div>
			<div class="min-w-0 rounded-radius border border-outline p-3 dark:border-outline-dark" data-palette-chart="heatmap">
				@heatmap.HeatMap(paletteHeatMapConfig(state))
			</div>
		</div>
	</div>
}
