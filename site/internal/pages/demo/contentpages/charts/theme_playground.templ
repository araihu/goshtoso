package charts

import (
	shellassets "github.com/araihu/goshtoso-app-shells/componentdocshell/assets"
	"github.com/araihu/goshtoso-charts/components/dependencies"
	"github.com/araihu/goshtoso-charts/components/interactive"
	interactiveradar "github.com/araihu/goshtoso-charts/components/interactive/radar"
	"github.com/araihu/goshtoso-charts/components/line"
	"github.com/araihu/goshtoso-charts/components/pie"
	"github.com/araihu/goshtoso/components/head"
	selectfield "github.com/araihu/goshtoso/components/select"
)

templ ThemePlaygroundPage(fragment bool) {
	@chartsLayout("Theme playground", "theme-playground", themePlaygroundContent(), fragment)
}

templ themePlaygroundContent() {
	<div class="mx-auto max-w-6xl space-y-6" data-theme-playground-parent>
		<header class="space-y-3">
			<p class="text-sm font-semibold text-primary dark:text-primary-dark">Appearance</p>
			<h1 class="font-title text-4xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong">Theme playground</h1>
			<p class="max-w-3xl text-lg text-on-surface-muted dark:text-on-surface-dark-muted">Compare four chart shapes in an isolated preview. Theme changes stay inside the frame, so the documentation shell remains Arai Hû.</p>
		</header>
		<iframe
			src="/modules/charts/docs/theme-playground/frame"
			title="Theme playground chart preview"
			loading="eager"
			class="block w-full rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt"
			style="height: 62rem"
			data-theme-playground-frame-host
		></iframe>
	</div>
}

templ ThemePlaygroundFrame() {
	<!doctype html>
	<html lang="en" data-theme="araihu" x-data={ themePlaygroundShellData() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Theme playground preview · Goshtoso Charts</title>
			<script defer src={ shellassets.ScriptURL("/componentdocshell/assets/") }></script>
			@head.DependenciesMinimal(head.WithLocalRuntime())
			@dependencies.Dependencies()
			<link rel="stylesheet" href={ shellassets.AraiHuThemeURL("/componentdocshell/assets/") }/>
		</head>
		<body class="min-h-screen bg-surface p-4 text-on-surface dark:bg-surface-dark dark:text-on-surface-dark sm:p-6">
			<main class="mx-auto max-w-6xl space-y-5" data-theme-playground-frame>
				<header class="flex flex-wrap items-end justify-between gap-4 rounded-radius border border-outline bg-surface-alt p-4 dark:border-outline-dark dark:bg-surface-dark-alt">
					<div class="space-y-1">
						<h1 class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Live theme preview</h1>
						<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">One picker updates static vector and interactive charts together.</p>
						<p class="max-w-2xl text-xs text-on-surface-muted dark:text-on-surface-dark-muted">All 16 built-in Goshtoso themes provide chart tokens. Application CSS can still override them on a chart root.</p>
					</div>
					<div class="w-44">
						@selectfield.Select(selectfield.Config{
							ID: "theme-playground-theme",
							Name: "theme",
							Label: "Theme",
							Options: themePlaygroundThemes(),
							Alpine: &selectfield.AlpineConfig{Model: "theme"},
							TriggerAttrs: templ.Attributes{"aria-label": "Theme"},
						})
					</div>
				</header>
				<div class="grid grid-cols-2 gap-4" data-theme-playground-grid>
					@themePlaygroundChartCard("Static line", "vector", line.Line(themePlaygroundStaticLine()))
					@themePlaygroundChartCard("Static pie", "vector", pie.Pie(themePlaygroundStaticPie()))
					@themePlaygroundChartCard("Interactive bar", "interactive", interactive.Bar(themePlaygroundInteractiveBar()))
					@themePlaygroundChartCard("Interactive radar", "interactive", interactiveradar.Radar(themePlaygroundInteractiveRadar()))
				</div>
			</main>
		</body>
	</html>
}

templ themePlaygroundChartCard(title string, renderer string, chart templ.Component) {
	<section class="min-w-0 overflow-hidden rounded-radius border border-outline bg-surface-alt p-3 dark:border-outline-dark dark:bg-surface-dark-alt" data-theme-playground-chart={ renderer }>
		<div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
			<h2 class="font-title text-base font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2>
			<span class="text-xs font-semibold uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ renderer }</span>
		</div>
		@chart
	</section>
}
