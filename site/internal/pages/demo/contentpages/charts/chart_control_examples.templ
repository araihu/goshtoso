package charts

import (
	"strconv"

	"github.com/araihu/goshtoso-charts/components/interactive"
	"github.com/araihu/goshtoso-charts/components/line"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/form"
	rangeinput "github.com/araihu/goshtoso/components/range"
)

templ chartControlExamples(examples ChartControlExamples) {
	<section class="space-y-6" data-chart-control-examples>
		<div class="space-y-3">
			<h2 id="live-form-examples" data-toc-heading class="scroll-mt-8 font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Change charts with form values</h2>
			<p class="max-w-3xl text-on-surface-muted dark:text-on-surface-dark-muted">These forms map request values to typed chart configuration on the server. Changing a field swaps only its example through HTMX; Apply performs the same GET without JavaScript. Each source block includes both paths.</p>
			<p class="max-w-3xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Native select controls keep lifecycle and orientation editable in the no-JavaScript path. The surrounding form, range, checkbox, button, and source presentation use Goshtoso components.</p>
		</div>

		<article class="min-w-0 space-y-5" data-chart-control-demo="static">
			<div class="space-y-2">
				<h3 class="font-title text-xl font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Static/vector line</h3>
				<p class="max-w-3xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Change server-rendered SVG options and all four wrapper lifecycle states. The dataset and filled-area intent follow the centrally recorded Line example.</p>
			</div>
			@staticChartControlExample(examples.static)
			<div class="min-w-0" data-chart-control-source="static">
				@codeblock.CodeBlock(codeblock.Config{ID: "static-chart-control-source", Language: "templ", Label: "Static form and chart · templ", Code: staticChartControlSource, MaxHeight: "36rem"})
			</div>
		</article>

		<article class="min-w-0 space-y-5" data-chart-control-demo="interactive">
			<div class="space-y-2">
				<h3 class="font-title text-xl font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Interactive bar</h3>
				<p class="max-w-3xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Change orientation, data scale, and visible labels while the replacement initializes one responsive canvas and retains its exact-value disclosure.</p>
			</div>
			@interactiveChartControlExample(examples.interactive)
			<div class="min-w-0" data-chart-control-source="interactive">
				@codeblock.CodeBlock(codeblock.Config{ID: "interactive-chart-control-source", Language: "templ", Label: "Interactive form and chart · templ", Code: interactiveChartControlSource, MaxHeight: "36rem"})
			</div>
		</article>

		@paletteChartControlSection(examples.palette)
	</section>
}

templ staticChartControlExample(state staticChartControlState) {
	<div id={ staticChartControlTarget } class="min-w-0 space-y-5 rounded-radius border border-outline p-4 sm:p-5 dark:border-outline-dark" data-chart-control-example="static" data-chart-control-mode={ state.ModeValue } data-chart-control-stroke={ strconv.Itoa(state.StrokeWidth) } data-chart-control-area={ enabledText(state.Area) }>
		@form.Form(form.Config{
			ID:                 "static-chart-control-form",
			Action:             "/modules/charts/docs/chart-controls#" + staticChartControlTarget,
			Method:             "get",
			PreventEnterSubmit: boolPointer(false),
			RootClass:          "space-y-4",
			HTMX: &form.HTMXConfig{
				Get:    "/modules/charts/docs/chart-controls",
				Target: "#" + staticChartControlTarget,
				Swap:   "outerHTML focus-scroll:false",
			},
		}) {
			<input type="hidden" name="static_present" value="1"/>
			<fieldset class="m-0 grid min-w-0 gap-4 border-0 p-0 lg:grid-cols-3">
				<legend class="sr-only">Static chart form controls</legend>
				@form.FieldGroup(form.FieldGroupConfig{ID: "static-mode", RootID: "static-mode-field", Label: "Wrapper mode", Hints: []string{"Hidden keeps chart state in the DOM; omitted removes only the shared wrapper."}}) {
					<select id="static-mode" name="static_mode" aria-describedby="static-mode-hints" class="min-h-11 w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface-strong focus-visible:outline-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark" { chartControlHTMXAttrs(staticChartControlTarget)... }>
						<option value="enabled" selected?={ selected("enabled", state.ModeValue) }>Enabled</option>
						<option value="disabled" selected?={ selected("disabled", state.ModeValue) }>Disabled</option>
						<option value="hidden" selected?={ selected("hidden", state.ModeValue) }>Hidden</option>
						<option value="omitted" selected?={ selected("omitted", state.ModeValue) }>Omitted</option>
					</select>
				}
				<div class="space-y-2">
					@rangeinput.Range(rangeinput.Config{ID: "static-stroke", Name: "static_stroke", Label: "Stroke width (px)", Value: strconv.Itoa(state.StrokeWidth), Min: "1", Max: "8", Step: "1", ShowTicks: true, InputAttrs: mergeAttributes(chartControlHTMXAttrs(staticChartControlTarget), templ.Attributes{"aria-describedby": "static-stroke-help"})})
					<p id="static-stroke-help" class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Whole pixels from 1 through 8. Applied: { strconv.Itoa(state.StrokeWidth) } px.</p>
				</div>
				<div class="space-y-3">
					@checkbox.Checkbox(checkbox.Config{ID: "static-area", Name: "static_area", Value: "on", Label: "Fill area below line", Checked: state.Area, HelperText: "Unchecked sends omission as off.", HelperTextID: "static-area-help", InputAttrs: chartControlHTMXAttrs(staticChartControlTarget)})
					@button.Button(button.WithType("submit"), button.WithID("static-apply"), button.WithRootClass("w-full lg:w-auto"), button.WithLoadingText("Applying…")) { Apply static controls }
				</div>
			</fieldset>
			if len(state.Errors) > 0 {
				<p role="alert" aria-live="polite" class="rounded-radius border border-danger bg-danger/10 px-4 py-3 text-sm text-danger-text dark:border-danger dark:bg-danger/15 dark:text-danger-text-dark" data-chart-control-errors="static">{ joinedErrors(state.Errors) }</p>
			}
			<p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong" aria-live="polite" data-chart-control-state="static">Applied: { state.ModeValue } wrapper, { strconv.Itoa(state.StrokeWidth) } px stroke, area { enabledText(state.Area) }.</p>
		}
		<div class="min-w-0" data-chart-control-preview="static">
			@line.Line(staticChartControlConfig(state))
		</div>
	</div>
}

templ interactiveChartControlExample(state interactiveChartControlState) {
	<div id={ interactiveChartControlTarget } class="min-w-0 space-y-5 rounded-radius border border-outline p-4 sm:p-5 dark:border-outline-dark" data-chart-control-example="interactive" data-chart-control-orientation={ string(state.Orientation) } data-chart-control-scale={ strconv.Itoa(state.Scale) } data-chart-control-labels={ enabledText(state.ShowLabels) }>
		@form.Form(form.Config{
			ID:                 "interactive-chart-control-form",
			Action:             "/modules/charts/docs/chart-controls#" + interactiveChartControlTarget,
			Method:             "get",
			PreventEnterSubmit: boolPointer(false),
			RootClass:          "space-y-4",
			HTMX: &form.HTMXConfig{
				Get:    "/modules/charts/docs/chart-controls",
				Target: "#" + interactiveChartControlTarget,
				Swap:   "outerHTML focus-scroll:false",
			},
		}) {
			<input type="hidden" name="interactive_present" value="1"/>
			<fieldset class="m-0 grid min-w-0 gap-4 border-0 p-0 lg:grid-cols-3">
				<legend class="sr-only">Interactive chart form controls</legend>
				@form.FieldGroup(form.FieldGroupConfig{ID: "interactive-orientation", RootID: "interactive-orientation-field", Label: "Orientation", Hints: []string{"Moves categories between horizontal and vertical axes."}}) {
					<select id="interactive-orientation" name="interactive_orientation" aria-describedby="interactive-orientation-hints" class="min-h-11 w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface-strong focus-visible:outline-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark" { chartControlHTMXAttrs(interactiveChartControlTarget)... }>
						<option value="vertical" selected?={ state.Orientation == interactive.BarOrientationVertical }>Vertical</option>
						<option value="horizontal" selected?={ state.Orientation == interactive.BarOrientationHorizontal }>Horizontal</option>
					</select>
				}
				<div class="space-y-2">
					@rangeinput.Range(rangeinput.Config{ID: "interactive-scale", Name: "interactive_scale", Label: "Value scale (%)", Value: strconv.Itoa(state.Scale), Min: "50", Max: "150", Step: "10", ShowTicks: true, InputAttrs: mergeAttributes(chartControlHTMXAttrs(interactiveChartControlTarget), templ.Attributes{"aria-describedby": "interactive-scale-help"})})
					<p id="interactive-scale-help" class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">10% steps from 50% through 150%. Applied: { strconv.Itoa(state.Scale) }%.</p>
				</div>
				<div class="space-y-3">
					@checkbox.Checkbox(checkbox.Config{ID: "interactive-labels", Name: "interactive_labels", Value: "on", Label: "Show value labels", Checked: state.ShowLabels, HelperText: "Exact values remain in the disclosure either way.", HelperTextID: "interactive-labels-help", InputAttrs: chartControlHTMXAttrs(interactiveChartControlTarget)})
					@button.Button(button.WithType("submit"), button.WithID("interactive-apply"), button.WithRootClass("w-full lg:w-auto"), button.WithLoadingText("Applying…")) { Apply interactive controls }
				</div>
			</fieldset>
			if len(state.Errors) > 0 {
				<p role="alert" aria-live="polite" class="rounded-radius border border-danger bg-danger/10 px-4 py-3 text-sm text-danger-text dark:border-danger dark:bg-danger/15 dark:text-danger-text-dark" data-chart-control-errors="interactive">{ joinedErrors(state.Errors) }</p>
			}
			<p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong" aria-live="polite" data-chart-control-state="interactive">Applied: { string(state.Orientation) }, { strconv.Itoa(state.Scale) }% scale, labels { enabledText(state.ShowLabels) }.</p>
		}
		<div class="min-w-0" data-chart-control-preview="interactive">
			@interactive.Bar(interactiveChartControlConfig(state))
		</div>
	</div>
}
