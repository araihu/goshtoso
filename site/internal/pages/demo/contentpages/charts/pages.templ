templ GettingStartedPage(fragment bool) {
	@chartsLayout("Getting started", "getting-started", gettingStartedContent(), fragment)
}

templ gettingStartedContent() {
	<div class="max-w-3xl space-y-12">
		<section class="space-y-4">
			<p class="text-sm font-semibold text-primary dark:text-primary-dark">Goshtoso Charts</p>
			<h1 class="font-title text-4xl font-bold tracking-tight text-on-surface-strong dark:text-on-surface-dark-strong">Add your first chart</h1>
			<p class="text-lg text-on-surface-muted dark:text-on-surface-dark-muted">Render a static SVG chart in an existing Goshtoso application, then add the local browser runtime only if the chart needs interaction.</p>
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="install-the-module" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">1. Install the module</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Add Goshtoso Charts to an existing Go and templ application.</p>
			@codeblock.CodeBlock(gettingStartedCodeBlock("bash", "bash", gettingStartedInstallCode))
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="mount-chart-assets" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">2. Mount chart assets</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Shared controls and interactive charts use versioned assets embedded in the module. Mount the handler at its exported prefix; the handler removes that prefix itself.</p>
			@codeblock.CodeBlock(gettingStartedCodeBlock("go", "Go", gettingStartedAssetsCode))
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="render-a-static-chart" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">3. Render a static chart</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Static/vector components render on the server and need no browser chart runtime.</p>
			@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedStaticCode))
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="include-chart-dependencies" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">4. Add interactive dependencies</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">For interactive charts, render the dependency component once in the document head before chart initialization. Local vendored delivery is the default.</p>
			@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedDependenciesCode))
			<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Third-party delivery is explicit: use <code class="font-mono">dependencies.WithCDN()</code> only when the application accepts that network and CSP boundary.</p>
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="render-an-interactive-chart" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">5. Render an interactive chart</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Interactive examples focus on visual behavior, exploration, and composition.</p>
			@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "templ", gettingStartedInteractiveCode))
		</section>
		<section class="space-y-4" data-getting-started-step>
			<h2 id="choose-delivery-and-wrapper-behavior" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">6. Choose delivery and wrapper behavior</h2>
			<p class="text-on-surface-muted dark:text-on-surface-dark-muted">Static/vector and interactive charts solve different jobs. Use the <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/docs/chart-modes">static/vector and interactive guide</a> to choose delivery, then configure shared controls and an initial enabled, disabled, hidden, or omitted wrapper state with the <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/docs/chart-controls">chart controls guide</a>.</p>
			<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Browse categorized <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/components/line">static/vector</a>, <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/components/interactive/bar">interactive Cartesian</a>, and <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/components/interactive/graph">relationship</a> charts. The <a class="font-semibold text-primary underline dark:text-primary-dark" href="/modules/charts/examples/live-availability">Live availability</a> example shows a current status snapshot.</p>
		</section>
	</div>
}

templ LinePage(fragment bool) {
	@chartsLayout("Line chart", "line", lineContent(), fragment)
}

templ BarPage(fragment bool) {
	@chartsLayout("Bar chart", "bar", barContent(), fragment)
}

templ barContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Bar chart",
		Description: "Static/vector categorical comparisons in vertical, horizontal, grouped, or stacked layouts.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuide("Compare and rank named values across discrete categories, including grouped and stacked totals.", "Use when bar length makes difference, order, or contribution easy to scan; choose horizontal bars for longer category labels.", "Avoid when the key task is showing continuous change, dense distributions, or precise point-to-point relationships.", "Exact labels, category tables, and reference evidence accompany treatments that require precise reading without color alone."),
			Preview:      bar.Bar(sampleBasicBar()),
			Code:         basicBarCode(),
		},
		Sections: []componentpage.Example{
			{
				Title:       "Thickness and group spacing",
				Description: "Compare automatic geometry, bars using 15% of each allotted slot, and grouped bars without an inter-series gap.",
				Preview:     barGeometryComparison(false),
				Code:        geometryBarCode(false),
			},
			{
				Title:       "Rounded caps and value-label anchors",
				Description: "Rounded value-end caps work with exact labels at either the value end or category-axis start.",
				Preview:     roundedBarLabelComparison(),
				Code:        roundedBarLabelsCode(),
			},
			{
				Title:       "Statistical reference annotations",
				Description: "Average lines and minimum/maximum points add context. Exact values and computed references remain adjacent without relying on color.",
				Preview:     bar.Bar(sampleBarReferences()),
				Code:        barReferencesCode(),
			},
			{
				Title:       "Stacked totals",
				Description: "Stacked bars preserve component contributions while a maximum line and global maximum point identify the largest total.",
				Preview:     bar.Bar(sampleStackedBar()),
				Code:        stackedBarCode(),
			},
			{
				Title:       "Horizontal orientation",
				Description: "Use horizontal bars when category labels read more naturally beside values. Vertical remains the default.",
				Preview:     bar.Bar(sampleHorizontalWorldPopulation()),
				Code:        horizontalBarCode(),
			},
			{
				Title:       "Horizontal thickness and group spacing",
				Description: "The same automatic, thin, and no-gap geometry options apply after changing orientation.",
				Preview:     barGeometryComparison(true),
				Code:        geometryBarCode(true),
			},
			{
				Title:       "Horizontal maximum references",
				Description: "Maximum reference lines remain aligned with the numeric axis after orientation changes.",
				Preview:     bar.Bar(sampleHorizontalBarReferences()),
				Code:        horizontalBarReferencesCode(),
			},
			{
				Title:       "Stacked horizontal values",
				Description: "Stacked horizontal bars can show exact segment labels and hide the redundant numeric axis.",
				Preview:     bar.Bar(sampleHorizontalStackedBar()),
				Code:        horizontalStackedBarCode(),
			},
		},
		After: chartDocumentation("Static/vector behavior", "Bar renders inline SVG on the server, supports SVG and PNG download through the shared wrapper, and remains useful in print or no-JavaScript output. Review the shared chart-mode and control guides for delivery and wrapper choices.", "bar"),
	})
}

templ barGeometryComparison(horizontal bool) {
	{{ automatic, thin, noGap := sampleBarGeometryComparison(horizontal) }}
	<div class="grid min-w-0 gap-4 xl:grid-cols-3">
		<div class="min-w-0">@bar.Bar(automatic)</div>
		<div class="min-w-0">@bar.Bar(thin)</div>
		<div class="min-w-0">@bar.Bar(noGap)</div>
	</div>
}

templ roundedBarLabelComparison() {
	<div class="grid min-w-0 gap-4 lg:grid-cols-2">
		<div class="min-w-0">@bar.Bar(sampleRoundedBarLabels(bar.DataLabelPositionEnd))</div>
		<div class="min-w-0">@bar.Bar(sampleRoundedBarLabels(bar.DataLabelPositionStart))</div>
	</div>
}

