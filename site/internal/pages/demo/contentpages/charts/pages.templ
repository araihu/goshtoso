templ InteractiveLine3DPage(fragment bool) {
	@chartsLayout("Interactive line 3D", "interactive-line-3d", interactiveLine3DContent(), fragment)
}

templ interactiveLine3DContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive line 3D",
		Description: "Ordered paths through three measures when overall trajectory matters more than individual coordinates.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Trace one ordered path through three quantitative dimensions.", "Path shape matters more than precise point-by-point comparison.", "Readers need exact coordinates or cannot use a rotatable view.", "The formula, domains, and CSV provide a non-visual equivalent; reduced motion keeps the view still."),
			Preview:      interactiveLine3DVariants(),
			Code:         interactiveLine3DCode(),
		},
		After: interactiveDocumentation(demoNote("Motion", "Auto-rotation is optional exploration. The stationary treatment remains available, including for reduced-motion preferences.")),
	})
}

templ interactiveLine3DVariants() {
	<div class="space-y-10" data-line3d-variants>
		<div data-line3d-variant="base">
			@sampleInteractiveLine3D("basic line3d example", "basic-line3d-example", false)
		</div>
		<div data-line3d-variant="auto-rotate">
			@sampleInteractiveLine3D("auto rotating", "auto-rotating", true)
		</div>
	</div>
}

templ interactiveSurface3DContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive surface 3D",
		Description: "Sampled mathematical surfaces and closed parametric meshes for seeing overall three-dimensional shape.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Explore a sampled height field or closed parametric mesh.", "Overall shape, peaks, valleys, or connected volume matter more than a single exact sample.", "Users need to compare individual values or cannot use a three-dimensional view.", "Formula, topology, domains, sample count, and downloadable CSV expose the full dataset."),
			Preview:      interactiveSurface3DVariants(),
			Code:         interactiveSurface3DCode(),
		},
		After: interactiveDocumentation(demoNote("Surface variants", "Height fields keep unique X/Y samples. Closed meshes add explicit row-major topology and may repeat seam or pole coordinates.")),
	})
}

templ interactiveSurface3DVariants() {
	<div class="space-y-10" data-surface3d-variants>
		<div data-surface3d-variant="base">
			@sampleInteractiveSurface3D("basic surface3D example", interactiveSurface3DBaseFormula, "basic-surface3d-example", interactiveSurface3DBasePoints)
		</div>
		<div data-surface3d-variant="rose">
			@sampleInteractiveSurface3D("Rose style", interactiveSurface3DRoseFormula, "rose-style", interactiveSurface3DRosePoints)
		</div>
		<div data-surface3d-variant="heart">
			@sampleInteractiveSurface3DHeart()
		</div>
	</div>
}

templ interactiveBar3DContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive bar 3D",
		Description: "Category-grid comparisons where height gives a compact overview of two intersecting dimensions.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Compare values at intersections of two ordered categories with height.", "A compact overview of a small category grid is useful.", "Exact cell comparison or many categories matter; a heat map or table reads better.", "The adjacent disclosure lists every category pair and exact value."),
			Preview:      interactiveBar3DVariants(),
			Code:         interactiveBar3DCode(),
		},
		After: interactiveDocumentation(demoNote("View treatments", "Rotation and shading change presentation, not values. Use the exact-cell disclosure to compare values.")),
	})
}

templ interactiveBar3DVariants() {
	<div class="space-y-10" data-bar3d-variants>
		<div data-bar3d-variant="base">
			@sampleInteractiveBar3D("basic bar3d example", interactive.Bar3DGridSize{Width: 200, Depth: 80}, nil, interactive.Bar3DShadingDefault)
		</div>
		<div data-bar3d-variant="auto-rotate">
			@sampleInteractiveBar3D("auto rotating", interactive.Bar3DGridSize{Width: 160, Depth: 80}, &interactive.Bar3DView{AutoRotate: interactive.Bool(true)}, interactive.Bar3DShadingDefault)
		</div>
		<div data-bar3d-variant="faster">
			@sampleInteractiveBar3D("rotating faster", interactive.Bar3DGridSize{Width: 160, Depth: 80}, &interactive.Bar3DView{AutoRotate: interactive.Bool(true), AutoRotateSpeed: 200}, interactive.Bar3DShadingDefault)
		</div>
		<div data-bar3d-variant="lambert">
			@sampleInteractiveBar3D("Bar3D-shading(lambert)", interactive.Bar3DGridSize{Width: 200, Depth: 80}, nil, interactive.Bar3DShadingLambert)
		</div>
	</div>
}

templ InteractivePiePage(fragment bool) {
	@chartsLayout("Interactive pie", "interactive-pie", interactiveChartPieContent(), fragment)
}

templ interactiveChartPieContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive pie",
		Description: "Compact part-to-whole views for a few named categories and their shares of one total.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Summarize a small named distribution as parts of a total.", "Few categories and approximate share comparison are the goal.", "There are many slices or close values; use bars for reliable comparison.", "Pair the chart with exact values and shares in text or a table."),
			Preview:      interactivePieVariants(),
			Code:         interactiveChartPieCode(),
		},
		After: templ.Join(interactivePieUsage(), goAPIReference("interactive/pie")),
	})
}

templ interactivePieVariants() {
	<div class="space-y-10" data-pie-variants>
		<div data-pie-variant="base">
			@interactivepie.Pie(sampleInteractivePie())
		</div>
		<div data-pie-variant="labels">
			@interactivepie.Pie(sampleInteractivePieLabels())
		</div>
		<div data-pie-variant="radius">
			@interactivepie.Pie(sampleInteractivePieRadius())
		</div>
		<div data-pie-variant="padded">
			@interactivepie.Pie(sampleInteractivePiePadded())
		</div>
		<div class="space-y-10" data-pie-rose-variants>
			<div data-pie-variant="rose-area">
				@interactivepie.Pie(sampleInteractivePieRoseArea())
			</div>
			<div data-pie-variant="rose-radius">
				@interactivepie.Pie(sampleInteractivePieRoseRadius())
			</div>
			<div data-pie-variant="paired-roses">
				@interactivepie.Pie(sampleInteractivePiePairedRoses())
			</div>
		</div>
		<div data-pie-variant="nested">
			@interactivepie.Pie(sampleInteractivePieNested())
		</div>
		<div data-pie-variant="auto-emphasis">
			@interactivepie.Pie(sampleInteractivePieAutoEmphasis())
		</div>
		<div data-pie-variant="selected">
			@interactivepie.Pie(sampleInteractivePieSelected())
		</div>
	</div>
}

templ interactivePieUsage() {
	<div class="space-y-4">
		@demoNote("Accessibility", "The figure name comes from Label and Caption remains visible. Every example includes a keyboard-accessible exact-value disclosure with series, sector, value, and share; do not make hover, motion, or color the only route to meaning.")
		@demoNote("Choose the encoding", "A standard pie maps value to angle. A donut reserves a non-data center. Area roses use equal angles and encode values by sector area; radius roses retain proportional angles and add radial variation. Side-by-side and nested series need clearly separated centers or non-overlapping radii.")
		@demoNote("Interactive capabilities", "Hover tooltips, selectable sectors, typed emphasis, and optional rotating emphasis support exploration. Rotating emphasis stops for reduced-motion users. Exact values and shares remain in the adjacent disclosure rather than depending on hover, motion, or color.")
		@demoNote("Shared controls and modes", "Expand, fullscreen, PNG export, hidden/disabled/unwrapped lifecycle modes, resize events, and HTMX replacement behavior come from the shared chart wrapper. Static/vector pie is the better choice for print, server-only delivery, SVG output, or a page that must work without the browser runtime.")
	</div>
}

templ InteractiveRadarPage(fragment bool) {
	@chartsLayout("Interactive radar", "interactive-radar", interactiveChartRadarContent(), fragment)
}

templ interactiveChartRadarContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive radar",
		Description: "Aligned multidimensional profiles for comparing broad shapes over the same bounded indicators.",
		Primary: componentpage.Example{
			Title:        "Daily Beijing air quality",
			AbovePreview: visualizationGuidance("Compare repeated observations over the same bounded dimensions.", "A few dimensions share stable maxima and the profile shape matters more than precise pairwise ranking.", "Exact ranking, many dimensions, incompatible scales, or small differences are the goal; use bars, parallel coordinates, or a table.", "Every chart is followed by a keyboard-accessible exact-value table with the city, day, and six pollutant values."),
			Preview:      interactiveRadarVariant("base", interactiveradar.Radar(sampleInteractiveRadarBase())),
			Code:         interactiveRadarBaseCode(),
		},
		Sections: []componentpage.Example{
			{Title: "Circular style", Description: "Shape, split count, split-line treatment, line opacity, and area opacity remain typed options on the same Radar component.", Preview: interactiveRadarVariant("style", interactiveradar.Radar(sampleInteractiveRadarStyle())), Code: interactiveRadarStyleCode()},
			{Title: "Multiple-series legend", Description: "All three city profiles may remain visible or be toggled independently.", Preview: interactiveRadarVariant("legend-multiple", interactiveradar.Radar(sampleInteractiveRadarLegendMulti())), Code: interactiveRadarLegendCode(chart.LegendSelectionMultiple)},
			{Title: "Single-series legend", Description: "Exclusive legend selection reduces overlap while retaining all source observations in the exact-value table.", Preview: interactiveRadarVariant("legend-single", interactiveradar.Radar(sampleInteractiveRadarLegendSingle())), Code: interactiveRadarLegendCode(chart.LegendSelectionSingle)},
		},
		After: templ.Join(interactiveRadarUsage(), goAPIReference("interactive/radar")),
	})
}

templ interactiveRadarVariant(name string, chart templ.Component) {
	<div data-radar-variant={ name }>
		@chart
	</div>
}

templ interactiveRadarUsage() {
	<div class="space-y-4">
		@demoNote("When radar works", "Use a small, stable set of bounded indicators when the broad profile shape is meaningful. Polygon and circular coordinates change presentation, not values.")
		@demoNote("When radar fails", "Overplotting, many dimensions, unequal scales, and close values make radar charts hard to compare. Prefer bars, parallel coordinates, or the exact-value table in those cases.")
		@demoNote("Accessibility", "Hover and color are exploratory aids. Each example includes an exact radar values disclosure with every city, day, indicator, and value.")
		@demoNote("Shared controls and modes", "Expand, fullscreen, PNG export, hidden/disabled/unwrapped lifecycle modes, resize events, and HTMX replacement behavior come from the shared chart wrapper. See chart controls and static/vector and interactive capabilities below.")
	</div>
}

templ InteractiveHeatMapPage(fragment bool) {
	@chartsLayout("Interactive heatmap", "interactive-heatmap", interactiveChartHeatMapContent(), fragment)
}

templ interactiveChartHeatMapContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive heatmap",
		Description: "Intensity patterns across category grids or ordered calendar dates.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Reveal concentration, gaps, and repeated time patterns across two categorical dimensions.", "Relative intensity across a manageable grid is the question.", "Exact cell comparison, sequence, or color-independent interpretation is primary; use a table instead.", "The disclosure below preserves every category pair, value, and explicit no-data cell."),
			Preview:      interactiveheatmap.HeatMap(sampleInteractiveHeatMap()),
			Code:         interactiveChartHeatMapCode(),
		},
		Sections: []componentpage.Example{
			{
				Title:       "Calendar coordinates",
				Description: "A full deterministic year preserves the source date range, value domain, cell borders, and explicit no-data days while using responsive cell sizing.",
				Preview:     interactiveheatmap.HeatMap(sampleInteractiveCalendarHeatMap()),
				Code:        interactiveCalendarHeatMapCode(),
			},
		},
		After: templ.Join(interactiveHeatMapUsage(), goAPIReference("interactive/heatmap")),
	})
}

templ interactiveHeatMapUsage() {
	<div class="space-y-4">
		@demoNote("Use a category grid", "Choose Cartesian coordinates for two finite category sets such as weekday and hour. Split areas help readers track dense rows and columns.")
		@demoNote("Use a calendar", "Choose calendar coordinates when adjacency and seasonal gaps matter. Keep the date range explicit and use responsive cell sizing inside flexible layouts.")
		@demoNote("Cold to warm", "The default scale follows theme-aware low, middle, and high tokens. Explicit chart colors remain caller-owned when a specialized scale is required.")
		@demoNote("Missing is not zero", "Mark absent observations with Missing. Zero remains a valid measured value; both states stay distinct in the chart data and exact-value table.")
		@demoNote("Equivalent data", "Every example includes a bounded, scrollable exact-value table. Use that table alone when exact comparison matters more than spatial pattern.")
	</div>
}

