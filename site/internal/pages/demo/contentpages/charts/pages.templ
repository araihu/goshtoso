templ InteractiveCandlestickPage(fragment bool) {
	@chartsLayout("Interactive candlestick", "interactive-candlestick", interactiveCandlestickContent(), fragment)
}

templ interactiveCandlestickContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive candlestick",
		Description: "Open, high, low, and close movement across ordered periods, with range and direction in view.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Inspect open, high, low, and close movement across ordered dates.", "Range and direction over time matter, with a limited enough period to inspect.", "Readers only need one measure or exact comparisons; use a line or OHLC table.", "The adjacent table gives exact OHLC values and text direction without color."),
			Preview:      sampleInteractiveCandlestick(),
			Code:         interactiveCandlestickCode(),
		},
		Sections: []componentpage.Example{
			{
				Title:       "Inside zoom",
				Description: "Inside gestures explore a bounded date window without adding a visible slider.",
				Preview:     sampleInteractiveCandlestickInsideZoom(),
				Code:        interactiveCandlestickInsideZoomCode(),
			},
			{
				Title:       "Inside and slider zoom",
				Description: "Inside gestures and a visible slider control the same bounded date window.",
				Preview:     sampleInteractiveCandlestickBothZooms(),
				Code:        interactiveCandlestickBothZoomsCode(),
			},
			{
				Title:       "Y-axis slider zoom",
				Description: "A vertical slider narrows the visible value range while preserving the ordered dates.",
				Preview:     sampleInteractiveCandlestickYAxisZoom(),
				Code:        interactiveCandlestickYAxisZoomCode(),
			},
			{
				Title:       "Direction style and extrema",
				Description: "Theme-token classes distinguish rising and falling periods; highest and lowest marks add range references while the exact-value table preserves meaning without color alone.",
				Preview:     sampleInteractiveCandlestickUpstreamStyle(),
				Code:        interactiveCandlestickStyleCode(),
			},
		},
		After: interactiveCandlestickDocumentation(),
	})
}

templ interactiveCandlestickDocumentation() {
	<div class="space-y-4">
		@demoNote("Ranges and zoom", "Each candle has a low, open, close, and high value. Zoom supports exploration; the table remains source for exact values.")
		@goAPIReference("interactive/candlestick")
	</div>
}

templ interactiveChartBoxPlotContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive box plot",
		Description: "Distribution centers, spread, and range across categories through five-number summaries.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Compare distribution centers, spreads, and ranges across categories.", "Five-number summaries reveal how groups differ.", "Individual observations or unusual distribution shape must be inspected.", "Preserve five-number summaries in nearby content for exact comparison."),
			Preview:      interactiveboxplot.BoxPlot(sampleInteractiveBoxPlot()),
			Code:         interactiveChartBoxPlotCode(),
		},
		After: templ.Join(demoNote("Five-number summary", "Read minimum, first quartile, median, third quartile, and maximum together; this summary does not reveal individual observations."), goAPIReference("interactive/boxplot")),
	})
}

templ InteractiveGaugePage(fragment bool) {
	@chartsLayout("Interactive gauge", "interactive-gauge", interactiveChartGaugeContent(), fragment)
}

templ interactiveChartGaugeContent() {
	@componentpage.Page(componentpage.Config{
		Title:       "Interactive gauge",
		Description: "Current bounded readings where range context and status matter more than history.",
		Primary: componentpage.Example{
			AbovePreview: visualizationGuidance("Show one or more current readings against an explicit bounded range.", "A small number of status-like readings need range context.", "Trend, history, or precise comparison is central; use a line or table instead.", "State the exact reading, range, and status in nearby text; do not rely on color or fill level."),
			Preview:      interactiveGaugeVariants(),
			Code:         interactiveChartGaugeCode(),
		},
		After: templ.Join(interactiveGaugeUsage(), goAPIReference("interactive/gauge")),
	})
}

templ interactiveGaugeVariants() {
	<div class="space-y-8">
		<div data-gauge-variant="progress">
			@interactivegauge.Gauge(sampleInteractiveGauge())
		</div>
		<div class="flex flex-wrap gap-6" data-gauge-liquid-variants>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="basic">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("basic liquid example", interactivegauge.LiquidShapeCircle, false, false, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="label">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("show label", interactivegauge.LiquidShapeCircle, true, false, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="outline">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("show outline", interactivegauge.LiquidShapeCircle, true, true, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="static">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("disable wave animation", interactivegauge.LiquidShapeCircle, true, true, chart.Bool(false)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="diamond">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("shape(Diamond)", interactivegauge.LiquidShapeDiamond, false, false, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="pin">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("shape(Pin)", interactivegauge.LiquidShapePin, false, false, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="arrow">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("shape(Arrow)", interactivegauge.LiquidShapeArrow, false, false, chart.Bool(true)))
			</div>
			<div class="min-w-0 flex-[1_1_20rem]" data-gauge-liquid-variant="triangle">
				@interactivegauge.Gauge(sampleInteractiveLiquidGauge("shape(Triangle)", interactivegauge.LiquidShapeTriangle, false, false, chart.Bool(true)))
			</div>
		</div>
	</div>
}

templ interactiveGaugeUsage() {
	<div class="space-y-4">
		@demoNote("Gauge treatments", "Progress and liquid treatments change presentation only. Keep each reading's numeric value and range visible.")
		@codeblock.CodeBlock(gettingStartedCodeBlock("templ", "Liquid Gauge usage", interactiveGaugeLiquidCode()))
	</div>
}

