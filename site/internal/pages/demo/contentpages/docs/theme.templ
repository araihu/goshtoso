package docspages
import("github.com/araihu/goshtoso/site/internal/pages/demo"; startpages "github.com/araihu/goshtoso/site/internal/pages/demo/contentpages/start")
templ ThemeDemoPage(){
 @demo.Layout("Theme","theme",themeDemoContent())
}
templ themeDemoContent(){
 <h1 class="font-title text-3xl">Theme editor and playground</h1>
 <p>Preview every preset in an isolated document. Changes stay in the draft. Use the Light/Dark Preview mode segments to inspect both color sets. Import or export a theme CSS file, or connect the public events to your application.</p>
 @startpages.ThemeToolsDemo()
}
