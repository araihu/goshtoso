package docspages

import (
	"fmt"

	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

templ AgentsPage() {
	@demo.Layout("AI Agents", "agents", agentsContent())
}

templ agentsContent() {
	<div id="agents-fragment" class="mx-auto max-w-4xl space-y-10">
		<header class="space-y-3">
			<p class="text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">AI agents</p>
			<h1 class="text-3xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Using Goshtoso With AI Agents</h1>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">
				Goshtoso ships an installable consumer skill for AI coding tools. It covers deterministic integration and a compact design-intelligence path so an agent can infer the task, choose an application pattern, compose supported primitives, reject generic UI reflexes, and verify the result in a browser.
			</p>
		</header>

			<section id="install-skill" class="space-y-3">
				<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Install the Skill</h2>
				<p class="text-on-surface dark:text-on-surface-dark">
					Use the open <code class="font-mono">npx skills</code> CLI to install only the Goshtoso consumer-integration skill from the public repository.
				</p>
			@codeblock.CodeBlock(codeblock.Config{Language: "bash", Code: agentsInstallCode()})
		</section>

			<section id="use-without-installing" class="space-y-3">
				<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Use Without Installing</h2>
				<p class="text-on-surface dark:text-on-surface-dark">
					For one-off prompts, stream the skill instructions directly into a supported agent instead of copying files into the project.
				</p>
			@codeblock.CodeBlock(codeblock.Config{Language: "bash", Code: agentsUseCode()})
		</section>

		<section id="what-it-teaches" class="space-y-4">
			<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">A Progressive Path</h2>
			<ol class="divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark">
				for index, item := range agentSkillTopics() {
					<li class="flex gap-4 py-4">
						<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-alt text-sm font-semibold text-on-surface-strong dark:bg-surface-dark-alt dark:text-on-surface-dark-strong">{ fmt.Sprintf("%d", index+1) }</span>
						<div>
							<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ item.Title }</h3>
							<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ item.Body }</p>
						</div>
					</li>
				}
			</ol>
		</section>

		<section id="build-applications" class="space-y-4">
			<div class="space-y-2">
				<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">From First Component to Application</h2>
				<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">
					The installed skill first routes operations, dashboards, detail, workflow, settings, onboarding, and content/marketing briefs through a short surface brief. It then composes four task-oriented patterns: App Shell, Operations List, Detail Workspace, and Multi-step Workflow. This is a decision system, not a category-to-style preset.
				</p>
			</div>
			<div class="flex flex-wrap gap-3 text-sm font-medium">
				<a href="https://github.com/araihu/goshtoso/blob/main/.agents/skills/using-goshtoso/references/design-intelligence.md" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 dark:text-primary-dark">Start with design intelligence</a>
				<a href="https://github.com/araihu/goshtoso/blob/main/.agents/skills/using-goshtoso/references/application-patterns.md" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 dark:text-primary-dark">Read application patterns</a>
				<a href="https://github.com/araihu/goshtoso/blob/main/.agents/skills/using-goshtoso/references/adversarial-acceptance.md" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 dark:text-primary-dark">Build the invariant ledger</a>
				<a href="https://github.com/araihu/goshtoso/blob/main/.agents/skills/using-goshtoso/references/visual-acceptance.md" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 dark:text-primary-dark">Use the visual checklist</a>
			</div>
		</section>

		<section id="reusable-documentation-shells" class="space-y-3">
			<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Reusable documentation shells</h2>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">
				Start with the <a href="/modules/app-shells" class="text-primary underline underline-offset-2 dark:text-primary-dark">App Shells module guide</a> instead of copying this site's frame. It shows the current <code class="font-mono">goshtoso-app-shells</code> packages—<code class="font-mono">componentdocshell</code>, <code class="font-mono">componentpage</code>, and <code class="font-mono">consoleshell</code>—plus the boundary between shell-owned behavior and consumer-owned application content.
			</p>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">
				Use the sidebar's <strong>Modules → App Shells</strong> entry for the live showcase, repository links, and package documentation.
			</p>
		</section>

		<section id="runtime-contracts" class="space-y-3">
			<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Runtime Contracts the Browser Must Prove</h2>
			<ul class="list-disc space-y-2 pl-5 text-on-surface dark:text-on-surface-dark">
				<li>A strict CSP can load every local file and still block the bundled standard Alpine runtime. Test the real policy; the default runtime needs dynamic evaluation and inline style mutation.</li>
				<li>After an HTMX validation or mutation swap, restore focus on <code class="font-mono">htmx:afterSettle</code> to an explicit autofocus target or the FormErrors summary, then assert <code class="font-mono">document.activeElement</code>.</li>
				<li>For queue/detail swaps, assert one selected identity across the URL, rendered detail, focus, visible row styling, and <code class="font-mono">aria-current</code> or <code class="font-mono">aria-selected</code>. A correct detail with a stale queue highlight is a state-integrity failure.</li>
				<li>Hold real mutation requests in flight. For a form-owned request, pair <code class="font-mono">button.WithLoadingText</code> with form-level <code class="font-mono">hx-disabled-elt</code>, then assert pending copy and duplicate prevention.</li>
				<li>Expose one primary mobile navigation trigger, close it with Escape, and keep its name and <code class="font-mono">aria-expanded</code> truthful. After PRG, compare Back-restored status with a fresh server read.</li>
				<li>Keep mobile drawers viewport-owned (typically <code class="font-mono">fixed top-16 bottom-0</code>). At 390 px, open the panel and assert its bounding box intersects the viewport with positive height.</li>
				<li>For consequential mutations, test the transition table with two stale tabs, the offered conflict action, a repeated terminal action, and the actual side-effect count.</li>
				<li>Turn every consequential state/action pair into an invariant-ledger row. Attempt hidden and forged actions against server truth; verify retained input, focus, receipt identity, and effect count.</li>
				<li>Exercise a real transport failure and loading deduplication. A visible simulated 503 does not prove that an offline request has recovery.</li>
				<li>Run the 390-pixel matrix on every distinct step or detail state. A clean first route does not prove that a later action label, composite control, or sticky footer fits.</li>
			</ul>
		</section>

			<section id="scope" class="space-y-3">
				<h2 class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Scope</h2>
				<div class="rounded-radius border border-outline bg-surface p-4 dark:border-outline-dark dark:bg-surface-dark">
					<p class="font-medium text-on-surface-strong dark:text-on-surface-dark-strong">This skill is for consumer agents.</p>
					<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">
					It does not teach agents how to maintain Goshtoso itself, edit component internals, run the release process, or operate an MCP server. Those workflows are intentionally separate so consumer agents get a compact, trustworthy integration guide.
				</p>
			</div>
		</section>

	</div>
}

type agentSkillTopic struct {
	Title string
	Body  string
}

func agentSkillTopics() []agentSkillTopic {
	return []agentSkillTopic{
		{Title: "Integrate deterministically", Body: "Add the Go module, mount assets.Handler(), and use head.Dependencies() so styles and runtime scripts stay version-aligned."},
		{Title: "Write the surface brief", Body: "Infer task, usage scene, product or brand register, archetype, information priority, states, density, and a deliberate visual direction before choosing components."},
		{Title: "Render typed components", Body: "Use public packages and the generated component reference without generating code inside the dependency or importing site/."},
		{Title: "Choose the application pattern", Body: "Route the task into App Shell, Operations List, Detail Workspace, or Multi-step Workflow; use Panel for neutral regions and Card only for card-like content."},
		{Title: "Model the state matrix", Body: "Design loading, empty, error, and success before polishing the happy path; add domain states when they can occur."},
		{Title: "Derive adversarial tests", Body: "Write one invariant-ledger row per state and action, then prove server truth, retained input, focus, destination identity, and effect count."},
		{Title: "Own the CSS boundary", Body: "Use the embedded contract for official recipes and give the app a Tailwind build when it needs a broader utility vocabulary."},
		{Title: "Validate the complete surface", Body: "Check viewports, themes, light and dark, keyboard behavior, browser console, accessibility, and recovery flows."},
		{Title: "Prove runtime policy", Body: "Exercise the real CSP and restore HTMX focus after settle so local assets, Alpine behavior, and validation recovery are verified rather than assumed."},
	}
}

func agentsInstallCode() string {
	return `# Install into the current project/agent
npx skills add araihu/goshtoso --skill using-goshtoso

# Codex-specific install
npx skills add araihu/goshtoso --skill using-goshtoso --agent codex

# Global Codex install
npx skills add araihu/goshtoso --skill using-goshtoso --agent codex -g`
}

func agentsUseCode() string {
	return `npx skills use araihu/goshtoso --skill using-goshtoso`
}
