package docspages

import (
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/site/internal/demoicons/bootstrapicons"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

templ IconpackPage() {
	@demo.Layout("Icon Packs", "iconpack", iconpackContent())
}

templ iconpackContent() {
	<div id="iconpack-fragment" class="mx-auto max-w-5xl space-y-12">
		<header class="space-y-4">
			<h1 class="text-3xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">Icon Packs</h1>
			<p class="max-w-3xl text-lg leading-relaxed text-on-surface dark:text-on-surface-dark">
				Use <code class="font-mono">iconpack</code> to generate a Go package and SVG sprite from the icons you choose. The generated package renders through Goshtoso’s Icon component and lives in your application, alongside the source records and licenses.
			</p>
			<div class="flex flex-wrap gap-4 text-sm font-semibold">
				<a href="https://github.com/araihu/goshtoso/blob/main/docs/ICONPACK.md" target="_blank" rel="noopener" class="text-primary underline underline-offset-2 dark:text-primary-dark">Iconpack command reference</a>
			</div>
		</header>
		@iconpackGeneratedProof()
		<section id="generate" class="space-y-5" aria-labelledby="generate-title">
			<div>
				<h2 id="generate-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Generate from an Assets release</h2>
				<p class="mt-2 max-w-3xl text-on-surface dark:text-on-surface-dark">You can generate a pack from an Arai Hû Assets release or define your own sources in <code class="font-mono">.iconpack.yaml</code>, as shown in the next section. For a release archive, supply its SHA-256 checksum and the checksums for its catalog and release metadata. Each <code class="font-mono">-name</code> must match a <code class="font-mono">canonicalName</code> in the catalog.</p>
			</div>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "bash",
				Label:    "Generate appicons",
				Code: `go run github.com/araihu/goshtoso/cmd/iconpack@latest \
  -release-archive ./araihu-assets-v0.2.0.tar.gz \
  -archive-sha256 "$ASSETS_ARCHIVE_SHA256" \
  -release v0.2.0 \
  -catalog-sha256 "$CATALOG_SHA256" \
  -release-json-sha256 "$RELEASE_JSON_SHA256" \
  -checksums-sha256 "$CHECKSUMS_SHA256" \
  -name brand-developer-icons-tRPC \
  -name ui-hi-16-solid-check \
  -out ./internal/appicons \
  -package appicons \
  -const-prefix Icon \
  -sprite-url /assets/icons/appicons/sprite.svg`,
			})
			<p class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">For a verified extracted release root, use <code class="font-mono">-release-root</code> instead of <code class="font-mono">-release-archive</code>. Create the parent directory, <code class="font-mono">internal</code> in this example, before running the command. The generator writes the output directory atomically.</p>
		</section>
		<section id="iconpack-config" class="space-y-5" aria-labelledby="iconpack-config-title">
			<div>
				<h2 id="iconpack-config-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Define sources with .iconpack.yaml</h2>
				<p class="mt-2 max-w-3xl text-on-surface dark:text-on-surface-dark">To combine icons from GitHub repositories or individual SVG URLs, list the sources in <code class="font-mono">.iconpack.yaml</code>. The example below selects one Heroicons icon and one Bootstrap icon, with a license for each source.</p>
			</div>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "yaml",
				Label:    ".iconpack.yaml",
				Code: `schemaVersion: 1
sources:
  - id: heroicons
    url: https://github.com/tailwindlabs/heroicons/tree/master/src
    packName: heroicons
    paths:
      - 16/solid/academic-cap.svg
    license: MIT
    licensePath: LICENSE
    licenseUrl: https://raw.githubusercontent.com/tailwindlabs/heroicons/master/LICENSE
  - id: bootstrap
    kind: file
    url: https://raw.githubusercontent.com/twbs/icons/v1.11.3/icons/alarm.svg
    path: alarm.svg
    license: MIT
    licensePath: LICENSE
    licenseUrl: https://raw.githubusercontent.com/twbs/icons/v1.11.3/LICENSE.md`,
			})
			@codeblock.CodeBlock(codeblock.Config{
				Language: "bash",
				Label:    "Record source checksums and generate",
				Code: `go run github.com/araihu/goshtoso/cmd/iconpack@latest \
	  -config ./.iconpack.yaml -trust \
	  -out ./internal/appicons -package appicons \
	  -const-prefix Icon -sprite-url /assets/icons/appicons/sprite.svg`,
			})
			<p class="text-on-surface dark:text-on-surface-dark">The first run uses <code class="font-mono">-trust</code> to record the downloaded sources in <code class="font-mono">.iconpack.lock.yaml</code>. Review and retain that lock file, then omit <code class="font-mono">-trust</code> on subsequent runs. The tool checks later downloads against the recorded bytes and fails if they change.</p>
			<p class="text-on-surface dark:text-on-surface-dark">For a GitHub source, <code class="font-mono">paths</code> selects individual SVGs; omitting it includes every SVG in the tree. Names combine the pack name and normalized path, such as <code class="font-mono">heroicons-16-solid-academic-cap</code>. If you omit <code class="font-mono">packName</code>, GitHub sources use the repository name and other sources use their <code class="font-mono">id</code>.</p>
		</section>
		<section id="serve-and-render" class="space-y-5" aria-labelledby="serve-and-render-title">
			<div>
				<h2 id="serve-and-render-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Serve and render icons</h2>
				<p class="mt-2 max-w-3xl text-on-surface dark:text-on-surface-dark">Serve the generated sprite at the same-origin URL passed to the generator. Import the generated package and pass a symbol to its <code class="font-mono">Icon</code> function. Replace <code class="font-mono">example.com/myapp</code> below with your module path. This example uses the tRPC icon selected from the Assets release above.</p>
			</div>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "go",
				Label:    "Use the generated typed symbol",
				Code: `import (
    "github.com/araihu/goshtoso/components/icon"
    "example.com/myapp/internal/appicons"
)

// Route /assets/icons/appicons/sprite.svg to ./internal/appicons/sprite.svg.
templ ProviderIcon() {
    @appicons.Icon(appicons.Config{
        Symbol:    appicons.IconBrandDeveloperIconsTRPC,
        Size:      icon.SizeLG,
        Label:     "tRPC",
        RootClass: "text-primary",
    })
}`,
			})
			<p class="text-on-surface dark:text-on-surface-dark">Use the generated constants directly. The generator converts catalog names into valid Go identifiers while preserving the original names and sprite symbols in their values. For example, <code class="font-mono">NameBrandDeveloperIconsTRPC</code> contains <code class="font-mono">brand-developer-icons-tRPC</code>, and <code class="font-mono">IconBrandDeveloperIconsTRPC</code> identifies the catalog’s <code class="font-mono">devicon-trpc</code> symbol.</p>
		</section>
		<section id="lookup" class="space-y-5" aria-labelledby="lookup-title">
			<h2 id="lookup-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Look up icons by name</h2>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">If your application stores icon names in configuration, convert the value to the generated <code class="font-mono">Name</code> type and call <code class="font-mono">Lookup</code>. It returns the glyph and a boolean indicating whether the pack contains that name. This example treats a missing icon as a configuration error.</p>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "go",
				Label:    "Resolve an exact canonical name",
				Code: `func IconForName(name appicons.Name) icon.Instance {
    glyph, ok := appicons.Lookup(name)
    if !ok {
        panic("icon is not in this generated pack")
    }
    return appicons.Icon(appicons.Config{
        Symbol: glyph.Symbol,
        Label:  string(glyph.CanonicalName),
    })
}`,
			})
		</section>
		<section id="generic-source" class="space-y-5" aria-labelledby="generic-source-title">
			<div>
				<h2 id="generic-source-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Use an existing source manifest</h2>
				<p class="mt-2 max-w-3xl text-on-surface dark:text-on-surface-dark">If you already have a JSON or YAML source manifest with per-file SHA-256 checksums, you can continue using it. For a new pack, use <code class="font-mono">.iconpack.yaml</code> to download and verify sources with the same command.</p>
			</div>
			@codeblock.CodeBlock(codeblock.Config{
				Language: "bash",
				Label:    "Generate from an existing hashed source manifest",
				Code: `go run github.com/araihu/goshtoso/cmd/iconpack@latest \
	-source-root ./vendor/bootstrap-icons \
	-source-manifest ./bootstrap-icons.goshtoso.json \
	-name bootstrap-icons-alarm \
	-out ./internal/bootstrapicons -package bootstrapicons \
	-const-prefix Icon -sprite-url /assets/icons/bootstrapicons/sprite.svg`,
			})
			<p class="text-sm leading-6 text-on-surface-muted dark:text-on-surface-dark-muted">The generator verifies each source file against the SHA-256 checksum in the manifest.</p>
		</section>
		<section id="manifest-and-licenses" class="space-y-5" aria-labelledby="manifest-and-licenses-title">
			<h2 id="manifest-and-licenses-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Generated files</h2>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">Keep the generated files with your application. They contain the icons, Go API, source records, and license notices needed to use and redistribute the pack.</p>
			<dl class="space-y-4">
				@iconpackOutputFile("sprite.svg", "Only the selected SVG symbols, with the catalog sprite symbols preserved literally.")
				@iconpackOutputFile("icons_gen.go", "Typed Name, Glyph, icon.Symbol constants, Lookup, Config, SpriteURL, and Icon.")
				@iconpackOutputFile("manifest.json", "Release, source kind, archive identity, selected assets, generated identifiers, and output hashes.")
				@iconpackOutputFile("provenance.json + PROVENANCE/", "Per-family source and license references copied from the verified release.")
				@iconpackOutputFile("licenses/ + NOTICE", "The notices required to redistribute the selected assets.")
			</dl>
		</section>
		<section id="runtime-contract" class="space-y-5" aria-labelledby="runtime-contract-title">
			<h2 id="runtime-contract-title" data-toc-heading class="text-2xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Accessibility, color, and updates</h2>
			<ul class="list-disc space-y-3 pl-5 text-on-surface dark:text-on-surface-dark">
				<li>Use a relative same-origin sprite URL. HTTPS pages must not depend on an HTTP sprite or cross-origin <code class="font-mono">&lt;use&gt;</code> behavior.</li>
				<li>Give icons that convey meaning a descriptive <code class="font-mono">Label</code>. Set <code class="font-mono">Decorative: true</code> on purely visual icons; this hides them from assistive technology.</li>
				<li>Do not recolor protected brand assets. Monochrome assets can inherit <code class="font-mono">currentColor</code> through your normal Goshtoso classes.</li>
				<li>When updating, generate a new versioned output and sprite route, verify the new manifest, then switch the application import and route together. Retain the previous output as a rollback artifact until the deployment is confirmed.</li>
			</ul>
			<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">See the <a class="underline" href="/components/icon">Icon documentation</a>{ " for sizing, labels, and decorative icons." }</p>
		</section>
	</div>
}

templ iconpackGeneratedProof() {
	<section data-component-preview data-testid="bootstrap-iconpack-preview" class="rounded-radius border border-outline bg-surface-alt/50 p-5 dark:border-outline-dark dark:bg-surface-dark-alt/40" aria-labelledby="bootstrap-iconpack-title">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 id="bootstrap-iconpack-title" data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Example: Bootstrap Icons</h2>
				<p class="mt-1 max-w-2xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">These icons come from a generated Bootstrap Icons package. The alarm has an accessible label; the Bootstrap logo is decorative because the adjacent text supplies its meaning.</p>
			</div>
			<a href="https://icons.getbootstrap.com/" target="_blank" rel="noreferrer" class="text-sm font-medium text-primary underline underline-offset-4 dark:text-primary-dark">Bootstrap Icons</a>
		</div>
		<div class="mt-5 flex flex-wrap items-center gap-5" data-testid="bootstrap-iconpack-icons">
			<div data-testid="bootstrap-icon-labelled" class="flex items-center gap-2 text-primary dark:text-primary-dark">
				@bootstrapicons.Icon(bootstrapicons.Config{Symbol: bootstrapicons.IconBootstrapIconsAlarm, Label: "Alarm"})
				<span class="text-sm">Alarm</span>
			</div>
			<div data-testid="bootstrap-icon-decorative" class="flex items-center gap-2 text-secondary dark:text-secondary-dark">
				@bootstrapicons.Icon(bootstrapicons.Config{Symbol: bootstrapicons.IconBootstrapIconsBootstrap, Decorative: true})
				<span class="text-sm">Bootstrap</span>
			</div>
		</div>
	</section>
}

templ iconpackOutputFile(name, description string) {
	<div>
		<dt class="font-mono text-sm font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ name }</dt>
		<dd class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ description }</dd>
	</div>
}
