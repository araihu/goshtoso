package examples

import (
	"fmt"

	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/steps"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/components/toast"
	"github.com/araihu/goshtoso/site/internal/examples/wizard"
)

// wizardSwapTarget is the DOM id of the swappable wizard body. Every step
// form/back/confirm posts here with outerHTML swap, so a single round-trip
// re-renders the progress indicator and the active step together. The toast
// container lives outside it so OOB toasts always have a stable target.
const wizardSwapTarget = "wizard-app"

// errState maps a field error message to a textinput validation state.
func errState(msg string) textinput.State {
	if msg != "" {
		return textinput.StateError
	}
	return textinput.StateDefault
}

// stepLabels names the four steps in order for the progress indicator.
var stepLabels = []string{"Account", "Address", "Plan", "Review"}

// stepStatus returns the steps.Status for step number n given the current step.
func stepStatus(n, current int, done bool) steps.Status {
	switch {
	case done:
		return steps.StatusCompleted
	case n < current:
		return steps.StatusCompleted
	case n == current:
		return steps.StatusCurrent
	default:
		return steps.StatusUpcoming
	}
}

// planPrice formats a plan's integer-cents price for display ("Free" or "$N/mo").
func planPrice(p wizard.Plan) string {
	if p.PriceCents == 0 {
		return "Free"
	}
	return fmt.Sprintf("$%d/mo", p.PriceCents/100)
}

// countryOptions builds the step-2 country select, preselecting the stored value.
func countryOptions(current string) []selectfield.Option {
	names := []string{"United States", "United Kingdom", "Germany", "France", "Brazil", "Japan", "Australia"}
	opts := make([]selectfield.Option, 0, len(names))
	for _, n := range names {
		opts = append(opts, selectfield.Option{Value: n, Label: n, Selected: n == current})
	}
	return opts
}

// stepsIndicator renders the progress bar from the current step.
templ stepsIndicator(s wizard.WizardState) {
	@steps.Steps(steps.Config{
		ID:         "wizard-steps",
		ShowLabels: true,
		AriaLabel:  "Onboarding progress",
		LiveRegion: true,
		Steps:      wizardStepItems(s),
	})
}

// wizardStepItems builds the []steps.Step slice for the indicator.
func wizardStepItems(s wizard.WizardState) []steps.Step {
	items := make([]steps.Step, 0, len(stepLabels))
	for i, label := range stepLabels {
		n := i + 1
		items = append(items, steps.Step{
			ID:     fmt.Sprintf("wizard-step-%d", n),
			Label:  label,
			Number: n,
			Status: stepStatus(n, s.Step, s.Done),
		})
	}
	return items
}

// stepFooter renders the Back / Next (or Confirm) control row shared by steps.
// showBack hides the Back button on step 1; nextLabel is the primary action's
// text; nextPost is the endpoint the primary action posts to.
templ stepFooter(showBack bool, nextLabel, nextPost string) {
	<div class="mt-6 flex items-center justify-between gap-3 border-t border-outline pt-4 dark:border-outline-dark">
		if showBack {
			@button.Button(
				button.WithTone(button.ToneSecondary),
				button.WithHTMX(&button.HTMXConfig{
					Post:   "/api/examples/wizard/back",
					Target: "#" + wizardSwapTarget,
					Swap:   "outerHTML",
				}),
			) {
				Back
			}
		} else {
			<span></span>
		}
		@button.Button(button.WithType("submit")) {
			{ nextLabel }
		}
	</div>
}

// requiredLegend is the muted "* required" note shown above each input step.
templ requiredLegend() {
	<p class="-mt-1 text-xs text-on-surface-muted dark:text-on-surface-dark-muted">
		Fields marked <span class="text-danger dark:text-danger">*</span> are required.
	</p>
}

// accountStep is step 1: name, email, password.
templ accountStep(s wizard.WizardState, errs map[string]string) {
	<form
		novalidate
		class="flex flex-col gap-4"
		hx-post="/api/examples/wizard/next"
		hx-target={ "#" + wizardSwapTarget }
		hx-swap="outerHTML"
	>
		<h2 class="text-lg font-semibold text-on-surface dark:text-on-surface-dark">Create your account</h2>
		@requiredLegend()
		@textinput.TextInput(textinput.Config{
			Name: "name", Label: "Full name *", Required: true, Placeholder: "Ada Lovelace",
			Value: s.Account.Name, State: errState(errs["name"]), HelperText: errs["name"],
		})
		@textinput.TextInput(textinput.Config{
			Name: "email", Label: "Email *", Required: true, Type: textinput.TypeEmail, Placeholder: "ada@example.com",
			Value: s.Account.Email, State: errState(errs["email"]), HelperText: errs["email"],
		})
		@textinput.TextInput(textinput.Config{
			Name: "password", Label: "Password *", Required: true, Type: textinput.TypePassword, Placeholder: "At least 8 characters",
			Value: s.Account.Password, State: errState(errs["password"]), HelperText: errs["password"],
		})
		@stepFooter(false, "Continue", "")
	</form>
}

// addressStep is step 2: line1, city, country, postal.
templ addressStep(s wizard.WizardState, errs map[string]string) {
	<form
		novalidate
		class="flex flex-col gap-4"
		hx-post="/api/examples/wizard/next"
		hx-target={ "#" + wizardSwapTarget }
		hx-swap="outerHTML"
	>
		<h2 class="text-lg font-semibold text-on-surface dark:text-on-surface-dark">Where are you?</h2>
		@requiredLegend()
		@textinput.TextInput(textinput.Config{
			Name: "line1", Label: "Address *", Required: true, Placeholder: "1 Analytical Way",
			Value: s.Address.Line1, State: errState(errs["line1"]), HelperText: errs["line1"],
		})
		<div class="flex flex-col gap-4 sm:flex-row">
			<div class="flex-1">
				@textinput.TextInput(textinput.Config{
					Name: "city", Label: "City *", Required: true, Placeholder: "London",
					Value: s.Address.City, State: errState(errs["city"]), HelperText: errs["city"],
				})
			</div>
			<div class="sm:w-40">
				@textinput.TextInput(textinput.Config{
					Name: "postal", Label: "Postal code *", Required: true, Placeholder: "EC1A",
					Value: s.Address.Postal, State: errState(errs["postal"]), HelperText: errs["postal"],
				})
			</div>
		</div>
		@selectfield.Select(selectfield.Config{
			ID: "wizard-country", Name: "country", Label: "Country *", Placeholder: "Select a country",
			Options: countryOptions(s.Address.Country),
			State:   selectErrState(errs["country"]), HelperText: errs["country"],
		})
		@stepFooter(true, "Continue", "")
	</form>
}

// selectErrState maps a field error to a select validation state.
func selectErrState(msg string) selectfield.State {
	if msg != "" {
		return selectfield.StateError
	}
	return selectfield.StateDefault
}

// planCard renders one selectable plan as a native radio inside a label so the
// browser owns the checked state; a Badge shows the price.
templ planCard(p wizard.Plan, selected bool) {
	<label
		class="flex cursor-pointer items-start gap-3 rounded-radius border border-outline bg-surface p-4 hover:border-primary has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark"
	>
		<input
			type="radio"
			name="plan"
			value={ p.Key }
			checked?={ selected }
			class="mt-1 size-4 shrink-0 accent-primary dark:accent-primary-dark"
		/>
		<span class="flex flex-1 flex-col gap-1">
			<span class="flex items-center justify-between gap-2">
				<span class="font-semibold text-on-surface dark:text-on-surface-dark">{ p.Name }</span>
				@badge.Badge(badge.Config{Tone: planBadgeVariant(p), Label: planPrice(p)})
			</span>
			<span class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ p.Blurb }</span>
		</span>
	</label>
}

// planBadgeVariant tints the price badge: paid tiers stand out, free is muted.
func planBadgeVariant(p wizard.Plan) badge.Tone {
	if p.PriceCents == 0 {
		return badge.ToneSecondary
	}
	return badge.ToneSuccess
}

// planStep is step 3: choose a plan.
templ planStep(s wizard.WizardState, errs map[string]string) {
	<form
		novalidate
		class="flex flex-col gap-4"
		hx-post="/api/examples/wizard/next"
		hx-target={ "#" + wizardSwapTarget }
		hx-swap="outerHTML"
	>
		<h2 class="text-lg font-semibold text-on-surface dark:text-on-surface-dark">Pick a plan</h2>
		if errs["plan"] != "" {
			<p class="text-sm text-danger dark:text-danger">{ errs["plan"] }</p>
		}
		<div class="flex flex-col gap-3">
			for _, p := range wizard.Plans {
				@planCard(p, s.Plan == p.Key)
			}
		</div>
		@stepFooter(true, "Continue", "")
	</form>
}

// summaryRow renders one label/value pair in the review list.
templ summaryRow(label, value string) {
	<div class="flex items-baseline justify-between gap-4 border-b border-outline py-2 last:border-0 dark:border-outline-dark">
		<dt class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ label }</dt>
		<dd class="text-right text-sm font-medium text-on-surface dark:text-on-surface-dark">{ value }</dd>
	</div>
}

// reviewStep is step 4: read-only summary + Confirm.
templ reviewStep(s wizard.WizardState) {
	<form
		novalidate
		class="flex flex-col gap-4"
		hx-post="/api/examples/wizard/confirm"
		hx-target={ "#" + wizardSwapTarget }
		hx-swap="outerHTML"
	>
		<h2 class="text-lg font-semibold text-on-surface dark:text-on-surface-dark">Review &amp; confirm</h2>
		<dl class="rounded-radius border border-outline bg-surface px-4 dark:border-outline-dark dark:bg-surface-dark">
			@summaryRow("Name", s.Account.Name)
			@summaryRow("Email", s.Account.Email)
			@summaryRow("Address", s.Address.Line1)
			@summaryRow("City", s.Address.City)
			@summaryRow("Country", s.Address.Country)
			@summaryRow("Postal code", s.Address.Postal)
			@summaryRow("Plan", planSummary(s.Plan))
		</dl>
		@stepFooter(true, "Confirm", "")
	</form>
}

// planSummary renders the chosen plan as "Name — price" for the review list.
func planSummary(key string) string {
	p, ok := wizard.PlanByKey(key)
	if !ok {
		return "—"
	}
	return fmt.Sprintf("%s · %s", p.Name, planPrice(p))
}

// WizardSuccess is the confirmed state shown after step 4.
templ WizardSuccess(s wizard.WizardState) {
	<div class="flex flex-col items-center gap-4 rounded-radius border border-outline bg-surface px-6 py-12 text-center dark:border-outline-dark dark:bg-surface-dark">
		@badge.Badge(badge.Config{Tone: badge.ToneSuccess, Label: "All set"})
		<h2 class="text-xl font-semibold text-on-surface dark:text-on-surface-dark">You're onboarded, { firstName(s.Account.Name) }!</h2>
		<p class="max-w-md text-on-surface-muted dark:text-on-surface-dark-muted">
			Your { planSummary(s.Plan) } account is ready. Every step was validated on the
			server, and the whole flow lived in a single cookie — no session storage.
		</p>
		@button.Button(
			button.WithHTMX(&button.HTMXConfig{
				Post:   "/api/examples/wizard/reset",
				Target: "#" + wizardSwapTarget,
				Swap:   "outerHTML",
			}),
		) {
			Start over
		}
	</div>
}

// firstName returns the first whitespace-delimited token of a name, or "there".
func firstName(name string) string {
	for i, r := range name {
		if r == ' ' {
			return name[:i]
		}
	}
	if name == "" {
		return "there"
	}
	return name
}

// WizardBody is the swappable region (#wizard-app): the progress indicator plus
// the active step (or the success screen). errs carries per-field validation
// messages when re-rendering a failed step; it is nil on a clean render.
templ WizardBody(s wizard.WizardState, errs map[string]string) {
	<div id={ wizardSwapTarget } class="rounded-radius border border-outline bg-surface-alt p-6 dark:border-outline-dark dark:bg-surface-dark-alt">
		<div class="mb-8 overflow-x-auto px-1 py-2">
			@stepsIndicator(s)
		</div>
		if s.Done {
			@WizardSuccess(s)
		} else {
			switch s.Step {
				case 2:
					@addressStep(s, errs)
				case 3:
					@planStep(s, errs)
				case 4:
					@reviewStep(s)
				default:
					@accountStep(s, errs)
			}
		}
	</div>
}

// WizardApp is the full example page: intro header, the swappable body, and a
// persistent toast container (kept outside #wizard-app so OOB toasts survive
// every step swap).
templ WizardApp(s wizard.WizardState, errs map[string]string) {
	<div id="wizard-fragment" class="mx-auto max-w-2xl">
		<header class="mb-6">
			<h1 class="text-2xl font-bold text-on-surface dark:text-on-surface-dark">Onboarding Wizard</h1>
			<p class="mt-2 text-on-surface-muted dark:text-on-surface-dark-muted">
				A four-step account setup that validates every step on the server. State lives in a
				single cookie, and each Back/Next is an HTMX fragment swap that returns rendered HTML.
			</p>
			<ul class="mt-3 list-disc pl-5 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
				<li>Per-step server-side validation with inline field errors and a toast</li>
				<li>Back/Next without losing entered data (cookie-backed, zero in-memory state)</li>
				<li>Steps progress indicator, plan cards, and a read-only review before confirm</li>
			</ul>
		</header>
		@WizardBody(s, errs)
		@toast.ToastContainer(toast.ContainerConfig{})
	</div>
}

// WizardContent is the registry entry point: renders a fresh first-step wizard
// for direct nav when no cookie exists.
templ WizardContent() {
	@WizardApp(wizard.WizardState{Step: wizard.FirstStep}, nil)
}
