package components

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/components/toolbar"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// ToolbarDemoPage renders the Toolbar component demo.
templ ToolbarDemoPage() {
	@demo.Layout("Toolbar", "toolbar", toolbarDemoContent())
}

templ toolbarDemoContent() {
	<div id="toolbar-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Toolbar",
				Description: "Group search, filters, and collection actions in a responsive control surface with an accessible name.",
			},
			toolbarDefaultPreview(),
			`@toolbar.Toolbar(toolbar.Config{
    Label:   "Incident tools",
    Search:  incidentSearch(),
    Filters: incidentFilters(),
    Actions: incidentActions(),
})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Sticky filter bar",
				Description: "Set Sticky when the toolbar should remain visible inside the page scroll container.",
			},
			toolbarStickyPreview(),
			`@toolbar.Toolbar(toolbar.Config{
    Label:   "Service tools",
    Search:  serviceSearch(),
    Filters: serviceFilters(),
    Sticky:  true,
})`,
		)
	</div>
}

templ toolbarDefaultPreview() {
	<div id="toolbar-default" class="w-full">
		@toolbar.Toolbar(toolbar.Config{
			Label:   "Incident tools",
			Search:  toolbarSearch(),
			Filters: toolbarFilters(),
			Actions: toolbarActions(),
		})
	</div>
}

templ toolbarStickyPreview() {
	<div id="toolbar-sticky" class="h-72 w-full overflow-y-auto rounded-radius border border-outline p-4 dark:border-outline-dark">
		@toolbar.Toolbar(toolbar.Config{
			Label:   "Service tools",
			Search:  toolbarServiceSearch(),
			Filters: toolbarFilters(),
			Sticky:  true,
		})
		<div class="space-y-3 pt-4">
			for _, service := range []string{"gateway-api", "billing-worker", "identity", "events", "notifications", "reporting"} {
				<div class="rounded-radius border border-outline bg-surface p-4 text-sm dark:border-outline-dark dark:bg-surface-dark">
					{ service }
				</div>
			}
		</div>
	</div>
}

templ toolbarSearch() {
	@textinput.TextInput(textinput.Config{
		ID:          "toolbar-incident-search",
		Name:        "search",
		Label:       "Search incidents",
		Placeholder: "Search incidents",
		Type:        textinput.TypeSearch,
	})
}

templ toolbarServiceSearch() {
	@textinput.TextInput(textinput.Config{
		ID:          "toolbar-service-search",
		Name:        "search",
		Label:       "Search services",
		Placeholder: "Search services",
		Type:        textinput.TypeSearch,
	})
}

templ toolbarFilters() {
	<button type="button" class="rounded-radius border border-outline bg-surface px-3 py-2 text-sm dark:border-outline-dark dark:bg-surface-dark">
		All severities
	</button>
	<button type="button" class="rounded-radius border border-outline bg-surface px-3 py-2 text-sm dark:border-outline-dark dark:bg-surface-dark">
		Open
	</button>
}

templ toolbarActions() {
	@button.Button() {
		Create incident
	}
}
