package components

import (
	linkcomponent "github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// LinkDemoPage renders the Link component demo.
templ LinkDemoPage() {
	@demo.Layout("Link", "link", linkDemoContent())
}

templ linkDemoContent() {
	<div id="link-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Link",
				Description: "Direct users to another page, section, or resource with themed focus, hover, and optional button styling.",
			},
			linkDefaultPreview(),
			`@link.Link("#") {
    Read if bored
}`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Link Within Text",
				Description: "Render an inline link inside body copy without breaking text flow.",
			},
			linkInlinePreview(),
			`<p>
    Follow us on @link.Link("#") { social media }
    and become our virtual BFF.
</p>`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Link With Icon",
				Description: "Pass an icon component to add a compact directional cue.",
			},
			linkIconPreview(),
			`@link.Link("#", link.WithIcon(linkArrowIcon())) {
    about our company
}`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Button Link",
				Description: "Use AppearanceButton when navigation should visually match a primary action. It remains a native link unless you set a role explicitly.",
			},
			linkButtonPreview(),
			`@link.Link("#", link.WithAppearance(link.AppearanceButton)) {
    I'm a link
}`,
		)
	</div>
}

templ linkDefaultPreview() {
	<div id="link-default" class="flex w-full justify-center">
		@linkcomponent.Link("#") {
			Read if bored
		}
	</div>
}

templ linkInlinePreview() {
	<div id="link-inline" class="mx-auto max-w-2xl text-center text-on-surface dark:text-on-surface-dark">
		<p>
			{ "Follow us on " }
			@linkcomponent.Link("#") {
				social media
			}
			{ " and become our virtual BFF. We promise to send only the useful updates." }
		</p>
	</div>
}

templ linkIconPreview() {
	<div id="link-icon" class="flex w-full justify-center">
		<p class="text-on-surface dark:text-on-surface-dark">
			{ "Find out more " }
			@linkcomponent.Link("#", linkcomponent.WithIcon(linkArrowIcon())) {
				about our company
			}
		</p>
	</div>
}

templ linkButtonPreview() {
	<div id="link-button" class="flex w-full justify-center">
		@linkcomponent.Link("#", linkcomponent.WithAppearance(linkcomponent.AppearanceButton)) {
			I'm a link
		}
	</div>
}

templ linkArrowIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true" stroke="currentColor" class="size-4">
		<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
	</svg>
}
