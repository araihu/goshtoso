package components

import (
	rootcomponents "github.com/araihu/goshtoso/components"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

var tableAPISections = []demo.APISection{
	demo.StructAPI[table.Config](
		rootcomponents.KindTable,
		"Config",
		"table.Table(cfg Config) Instance",
		"Configures static rows and optional sorting, loading, filtering, and pagination behavior.",
		[]demo.APIPropDoc{
			{Name: "ID", Default: `"table"`, Description: "Table ID and prefix for tbody, thead, filter, pagination, and sentinel IDs."},
			{Name: "Caption", Default: `"" (omitted)`, Description: "Screen-reader-only table caption."},
			{Name: "Columns", Default: "nil", Description: "Ordered column definitions.", Required: true},
			{Name: "Rows", Default: "nil", Description: "Rows rendered initially; may be empty for lazy loading."},
			{Name: "Appearance", Default: "AppearanceDefault", Allowed: []string{"AppearanceDefault", "AppearanceStriped"}, Description: "Default or zebra-striped row treatment."},
			{Name: "ShowCheckbox", Default: "false", Description: "Adds a leading select-all and per-row checkbox column."},
			{Name: "RootClass", Default: `""`, Description: "Additional CSS classes on the table container."},
			{Name: "SortBy", Default: `"" (unsorted)`, Description: "Currently sorted column key."},
			{Name: "SortDir", Default: "SortNone", Allowed: []string{"SortNone", "SortAsc", "SortDesc"}, Description: "Current sort direction."},
			{Name: "HTMX", Default: "nil", Description: "Optional endpoint configuration used by sorting, loading, filters, and pagination."},
			{Name: "LazyLoad", Default: "false", Description: "Renders a loading tbody that requests HTMX.Endpoint."},
			{Name: "LazyTrigger", Default: `"load"`, Description: "HTMX trigger used when LazyLoad is enabled."},
			{Name: "Pagination", Default: "nil", Description: "Traditional or infinite-scroll pagination state."},
			{Name: "InfiniteScroll", Default: "nil", Description: "Deprecated compatibility state; prefer Pagination with PaginationInfiniteScroll."},
			{Name: "Filters", Default: "nil", Description: "Optional filter controls rendered above the table."},
			{Name: "ExtraQueryParams", Default: `""`, Description: "Additional query parameters merged into generated sorting and pagination URLs."},
		},
	),
	demo.StructAPI[table.Column](
		"",
		"Column",
		"",
		"Defines one header and how its cells align.",
		[]demo.APIPropDoc{
			{Name: "Key", Default: `""`, Description: "Lookup key in Row.Cells and sorting parameter.", Required: true},
			{Name: "Label", Default: `""`, Description: "Visible header text.", Required: true},
			{Name: "Sortable", Default: "false", Description: "Makes the header sortable when Config.HTMX.Endpoint is non-empty."},
			{Name: "Width", Default: `""`, Description: "Optional Tailwind width class applied to header and body cells."},
			{Name: "Align", Default: `"left"`, Allowed: []string{"left", "center", "right"}, Description: "Cell alignment; unknown values also render left-aligned."},
		},
	),
	demo.StructAPI[table.Cell](
		"",
		"Cell",
		"",
		"Defines one cell. Component takes precedence over every other field.",
		[]demo.APIPropDoc{
			{Name: "Text", Default: `""`, Description: "Plain text cell content."},
			{Name: "Component", Default: "nil", Description: "Custom cell component; use badge.Badge for status and button.Button for actions."},
			{Name: "Description", Default: `""`, Description: "Muted secondary line beneath Text."},
			{Name: "BadgeColor", Default: `"" (plain text)`, Allowed: []string{"success", "danger", "warning", "info", "neutral", "primary", "secondary"}, Description: "Legacy text-badge shortcut; prefer Component with badge.Badge for canonical status composition."},
			{Name: "Code", Default: "false", Description: "Renders Text with monospace code styling."},
		},
	),
	demo.StructAPI[table.Row](
		"",
		"Row",
		"",
		"Defines one row, its cells, and optional row-level interaction.",
		[]demo.APIPropDoc{
			{Name: "ID", Default: `""`, Description: "Row identifier used by selection and expandable detail state."},
			{Name: "Cells", Default: "nil", Description: "Maps Column.Key values to cell content.", Required: true},
			{Name: "Link", Default: `""`, Description: "Makes the whole row navigate; takes precedence over OnClick and HTMX."},
			{Name: "LinkMode", Default: "LinkSPA", Allowed: []string{"LinkSPA", "LinkBoost", "LinkFull"}, Description: "Selects partial HTMX, full-body HTMX, or native navigation for Link."},
			{Name: "OnClick", Default: `""`, Description: "JavaScript click expression used when Link is empty."},
			{Name: "HTMX", Default: "nil", Description: "Row-level GET or POST action used when Link and OnClick are empty."},
			{Name: "AlpineAttrs", Default: "nil", Description: "Per-row Alpine attributes passed through to the tr element."},
			{Name: "Expandable", Default: "false", Description: "Adds a disclosure control and optional detail row."},
			{Name: "Detail", Default: "nil", Description: "Expandable detail content rendered when Expandable is true."},
			{Name: "Actions", Default: "nil", Description: "Trailing action content; compose controls with button.Button."},
		},
	),
	demo.StructAPI[table.RowHTMXConfig](
		"",
		"RowHTMXConfig",
		"",
		"Configures a row-level HTMX action.",
		[]demo.APIPropDoc{
			{Name: "Get", Default: `""`, Description: "GET URL; wins over Post when both are set."},
			{Name: "Post", Default: `""`, Description: "POST URL used when Get is empty."},
			{Name: "Target", Default: `""`, Description: "CSS selector for the swap target."},
			{Name: "Swap", Default: `"innerHTML"`, Description: "HTMX swap strategy."},
			{Name: "PushURL", Default: "false", Description: "Pushes the request URL into browser history."},
		},
	),
	demo.StructAPI[table.PaginationConfig](
		"",
		"PaginationConfig",
		"",
		"Configures traditional pagination or infinite-scroll state.",
		[]demo.APIPropDoc{
			{Name: "Mode", Default: "PaginationTraditional", Allowed: []string{"PaginationTraditional", "PaginationInfiniteScroll"}, Description: "Selects numbered navigation or an append sentinel."},
			{Name: "CurrentPage", Default: "required 1-based value", Description: "Current page used by navigation and next-page calculations.", Required: true},
			{Name: "TotalPages", Default: "required for numbered navigation", Description: "Number of pages; traditional navigation renders only when greater than one.", Required: true},
			{Name: "PerPage", Default: "omitted from requests when <= 0", Description: "Rows requested per page."},
			{Name: "HasMore", Default: "false", Description: "Controls whether infinite-scroll renders another sentinel."},
			{Name: "ContainerHeight", Default: `"" (nearest page scroller)`, Description: "Raw CSS height that opts infinite scroll into a table-local scroll container."},
		},
	),
	demo.StructAPI[table.InfiniteScrollConfig](
		"",
		"InfiniteScrollConfig",
		"",
		"Deprecated infinite-scroll state retained for compatibility.",
		[]demo.APIPropDoc{
			{Name: "NextPage", Default: "required when enabled", Description: "Next page requested by the legacy sentinel.", Required: true},
			{Name: "HasMore", Default: "false", Description: "Controls whether the legacy sentinel renders."},
		},
	),
	demo.StructAPI[table.FilterConfig](
		"",
		"FilterConfig",
		"",
		"Configures the filter controls rendered above the table.",
		[]demo.APIPropDoc{
			{Name: "Filters", Default: "nil", Description: "Filter controls rendered in order.", Required: true},
			{Name: "Collapsible", Default: "false", Description: "Adds a disclosure header in bar appearance."},
			{Name: "InitiallyExpanded", Default: "false when collapsible; otherwise visible", Description: "Initial disclosure state; inline appearance ignores it."},
			{Name: "Appearance", Default: "FilterAppearanceBar", Allowed: []string{"FilterAppearanceBar", "FilterAppearanceInline"}, Description: "Bordered filter block or plain inline controls."},
			{Name: "HTMX", Default: "nil", Description: "Optional target and swap overrides for filter requests."},
		},
	),
	demo.StructAPI[table.Filter](
		"",
		"Filter",
		"",
		"Defines one search, select, or toggle filter.",
		[]demo.APIPropDoc{
			{Name: "Key", Default: `""`, Description: "Query parameter and Alpine model key.", Required: true},
			{Name: "Label", Default: `""`, Description: "Visible control label."},
			{Name: "Type", Default: `"" (no control)`, Allowed: []string{"FilterSearch", "FilterSelect", "FilterToggle"}, Description: "Control type.", Required: true},
			{Name: "Placeholder", Default: `""`, Description: "Placeholder for search inputs."},
			{Name: "Options", Default: "nil", Description: "Static options for a select filter."},
			{Name: "OptionsHTMX", Default: "nil", Description: "Optional server-loaded select options."},
			{Name: "DefaultValue", Default: `""`, Description: "Initial Alpine model value."},
		},
	),
	demo.StructAPI[table.FilterOption](
		"",
		"FilterOption",
		"",
		"Defines one static select-filter option.",
		[]demo.APIPropDoc{
			{Name: "Value", Default: `""`, Description: "Submitted option value.", Required: true},
			{Name: "Label", Default: `""`, Description: "Visible option label.", Required: true},
		},
	),
	demo.StructAPI[table.FilterOptionsHTMXConfig](
		"",
		"FilterOptionsHTMXConfig",
		"",
		"Loads select options when the filter mounts.",
		[]demo.APIPropDoc{
			{Name: "Get", Default: `""`, Description: "GET URL whose response replaces the select options.", Required: true},
		},
	),
	demo.StructAPI[table.FilterHTMXConfig](
		"",
		"FilterHTMXConfig",
		"",
		"Overrides filter-request swap behavior.",
		[]demo.APIPropDoc{
			{Name: "Target", Default: `"#<table-id>-tbody"`, Description: "CSS selector updated by filter requests."},
			{Name: "Swap", Default: `"innerHTML"`, Description: "HTMX swap strategy used by filter requests."},
		},
	),
	demo.StructAPI[table.HTMXConfig](
		"",
		"HTMXConfig",
		"",
		"Provides the endpoint used by generated table requests.",
		[]demo.APIPropDoc{
			{Name: "Endpoint", Default: `""`, Description: "Base URL for sorting, pagination, loading, and filter requests.", Required: true},
			{Name: "Target", Default: "not applied", Description: "Reserved compatibility field; built-in table requests currently target the derived tbody ID."},
		},
	),
	demo.FunctionsAPI(
		"",
		"Config helpers",
		"",
		"Public helpers for inspecting state and generating server request URLs.",
		[]demo.APIPropDoc{
			{Name: "IsSortedBy", Signature: "func (cfg Config) IsSortedBy(key string) bool", Default: "n/a", Description: "Reports whether key is the active sort column."},
			{Name: "NextSortDir", Signature: "func (cfg Config) NextSortDir(key string) SortDir", Default: "n/a", Description: "Cycles neutral to ascending to descending to neutral."},
			{Name: "SortURL", Signature: "func (cfg Config) SortURL(key string) string", Default: "n/a", Description: "Builds the next sorting URL."},
			{Name: "PageURL", Signature: "func (cfg Config) PageURL(page int) string", Default: "n/a", Description: "Builds a numbered-page URL."},
			{Name: "NextPageURL", Signature: "func (cfg Config) NextPageURL() string", Default: `"" without infinite-scroll state`, Description: "Builds the next infinite-scroll URL."},
		},
	),
	demo.FunctionsAPI(
		rootcomponents.KindTableHeadContent,
		"TableHeadContent",
		"",
		"Renders header-row content without a thead wrapper for HTMX innerHTML swaps.",
		[]demo.APIPropDoc{
			{Name: "TableHeadContent", Signature: "func TableHeadContent(cfg Config) TableHeadContentInstance", Default: "n/a", Description: "Creates renderable table-head content."},
		},
	),
	demo.FunctionsAPI(
		rootcomponents.KindTableRows,
		"TableRows",
		"",
		"Renders row elements without a tbody wrapper for append responses.",
		[]demo.APIPropDoc{
			{Name: "TableRows", Signature: "func TableRows(cfg Config) TableRowsInstance", Default: "n/a", Description: "Creates renderable table rows and an optional infinite-scroll sentinel."},
		},
	),
	demo.FunctionsAPI(
		rootcomponents.KindTableRow,
		"TableRow",
		"",
		"Renders one row and its optional expandable detail row.",
		[]demo.APIPropDoc{
			{Name: "TableRow", Signature: "func TableRow(cfg Config, row Row) TableRowInstance", Default: "n/a", Description: "Creates one renderable table row."},
		},
	),
	demo.FunctionsAPI(
		rootcomponents.KindTablePaginationNav,
		"TablePaginationNav",
		"",
		"Renders only the numbered pagination component for fragment responses.",
		[]demo.APIPropDoc{
			{Name: "TablePaginationNav", Signature: "func TablePaginationNav(cfg Config) TablePaginationNavInstance", Default: "empty when TotalPages <= 1", Description: "Creates renderable pagination navigation."},
		},
	),
	demo.FunctionsAPI(
		rootcomponents.KindTableImageCell,
		"ImageCell",
		"",
		"Composes an avatar, primary label, and secondary detail.",
		[]demo.APIPropDoc{
			{Name: "ImageCell", Signature: "func ImageCell(imageURL string, label string, detail string) ImageCellInstance", Default: "initials avatar when imageURL is empty", Description: "Creates a renderable image cell."},
		},
	),
}

// TableDemoPage renders the Table component demo
templ TableDemoPage() {
	@demo.Layout("Table", "table", tableDemoContent())
}

// tableDemoContent renders the demo. Each table variant lives in its own preview
// frame followed by its own code block (mirrors penguinui.com/components/table).
// The variant set stays wrapped in #table-fragment; each preview wrapper carries a
// unique #table-<variant> id so the e2e suite can scope to it.
templ tableDemoContent() {
	<div id="table-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Table",
				Description: "Tables display structured data in rows and columns, with optional striping, row selection, sorting, lazy loading, pagination, filters, and infinite scroll.",
			},
			tableDefaultPreview(),
			`@table.Table(table.Config{
    Columns: []table.Column{
        {Key: "id", Label: "CustomerID"},
        {Key: "name", Label: "Name"},
        {Key: "email", Label: "Email"},
        {Key: "membership", Label: "Membership"},
    },
    Rows: rows,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Striped Table",
				Description: "Set Appearance: table.AppearanceStriped to zebra-stripe the rows.",
			},
			tableStripedPreview(),
			`@table.Table(table.Config{
    Appearance: table.AppearanceStriped,
    Columns: columns,
    Rows:    rows,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Table with Action",
				Description: "Render an interactive control in a cell via Cell.Component (e.g. button.Button).",
			},
			tableActionPreview(),
			`@table.Table(table.Config{
    Columns: actionColumns(),
    Rows: []table.Row{
        {ID: "2335", Cells: map[string]table.Cell{
            "id":     {Text: "2335"},
            "name":   {Text: "Alice Brown"},
            "email":  {Text: "alice.brown@gmail.com"},
            "action": {Component: tableEditButton()},
        }},
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Selectable Rows",
				Description: "Set ShowCheckbox: true to add row-selection controls with a header check-all toggle.",
			},
			tableCheckboxPreview(),
			`@table.Table(table.Config{
    ShowCheckbox: true,
    Columns:      actionColumns(),
    Rows:         rows,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Users Table",
				Description: "Compose rich cells with table.ImageCell, badge.Badge, and button.Button.",
			},
			tableUsersPreview(),
			`@table.Table(table.Config{
    Columns: usersColumns(),
    Rows: []table.Row{
        {ID: "2335", Cells: map[string]table.Cell{
            "user":   {Component: table.ImageCell("/.../avatar-8.webp", "Alice Brown", "alice.brown@gmail.com")},
            "id":     {Text: "2335"},
            "since":  {Text: "Nov 14, 2021"},
            "status": {Component: badge.Badge(badge.Config{Label: "Active", Tone: badge.ToneSuccess, Size: badge.SizeSM})},
            "action": {Component: tableEditButton()},
        }},
    },
})

templ tableEditButton() {
    @button.Button(button.WithSize(button.SizeSmall)) {
        Edit
    }
}`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Sortable Table (HTMX)",
				Description: "Mark columns Sortable: true and set HTMX.Endpoint. Clicking a header cycles neutral → asc → desc and fetches sorted rows from the server.",
			},
			tableSortablePreview(),
			`@table.Table(table.Config{
    ID:           "sortable-table",
    HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
    SortBy:       "id",
    SortDir:      table.SortAsc,
    Columns: []table.Column{
        {Key: "id", Label: "CustomerID", Sortable: true},
        {Key: "name", Label: "Name", Sortable: true},
        {Key: "email", Label: "Email"},
        {Key: "membership", Label: "Membership", Sortable: true},
    },
    Rows: rows,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Lazy-Loaded Table",
				Description: "Set LazyLoad: true to render a loading tbody, then choose when HTMX fetches rows. The default trigger is page load; this example waits for a button click.",
			},
			tableLazyPreview(),
			`@table.Table(table.Config{
    ID:           "lazy-table",
    HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows?variant=lazy"},
    LazyLoad:     true,
    LazyTrigger:  "click from:#load-lazy-table",
    Columns:      columns,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Paginated Table",
				Description: "Pass a Pagination config; Prev/Next and page links swap the tbody and paginator via HTMX OOB.",
			},
			tablePaginatedPreview(),
			`@table.Table(table.Config{
    ID:           "paginated-table",
    HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
    Columns:      columns,
    Rows:         pageRows(1),
    Pagination:   &table.PaginationConfig{CurrentPage: 1, TotalPages: 4, PerPage: 3},
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Filtered Table",
				Description: "Add a Filters config with search/select/toggle filters. The bar variant renders a collapsible bordered block.",
			},
			tableFilteredPreview(),
			`@table.Table(table.Config{
    ID:           "filtered-table",
    HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
    Columns:      sortableColumns(),
    Rows:         pageRows(1),
    Pagination:   &table.PaginationConfig{CurrentPage: 1, TotalPages: 4, PerPage: 3},
    Filters: &table.FilterConfig{
        Collapsible:       true,
        InitiallyExpanded: true,
        Filters: []table.Filter{
            {Key: "search", Label: "Search", Type: table.FilterSearch, Placeholder: "Search by name or email..."},
            {Key: "membership", Label: "Membership", Type: table.FilterSelect, Options: memberships},
        },
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Inline Filter Appearance",
				Description: "Set Filters.Appearance: table.FilterAppearanceInline for the same controls without the bordered block or collapsible toggle — suited to modal bodies and toolbar strips.",
			},
			tableInlineFilteredPreview(),
			`Filters: &table.FilterConfig{
    Appearance: table.FilterAppearanceInline,
    Filters: []table.Filter{
        {Key: "search", Type: table.FilterSearch, Placeholder: "Search…"},
        {Key: "membership", Type: table.FilterSelect, Options: memberships},
    },
}`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Infinite Scroll Table",
				Description: "Use Pagination.Mode: table.PaginationInfiniteScroll. By default the sentinel watches the page scroller; set Pagination.ContainerHeight only when the table needs its own capped scroll area.",
			},
			tableInfinitePreview(),
			`@table.Table(table.Config{
    ID:           "infinite-table",
    HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows?variant=infinite"},
    Columns:      columns,
    Rows:         initialRows,
    Pagination: &table.PaginationConfig{
        Mode:            table.PaginationInfiniteScroll,
        CurrentPage:     1,
        PerPage:         3,
        HasMore:         true,
        ContainerHeight: "300px",
    },
})`,
		)
	</div>
	// API reference lives outside #table-fragment so its <table>/tbody.divide-y
	// rows don't pollute the page-level "table" selectors the e2e suite counts.
	@demo.StructuredAPIReference(tableAPISections)
}

// tableDefaultPreview renders the default static table.
templ tableDefaultPreview() {
	<div id="table-default" class="w-full">
		@table.Table(table.Config{
			Columns: defaultColumns(),
			Rows:    defaultRows(),
		})
	</div>
}

// tableStripedPreview renders the striped variant.
templ tableStripedPreview() {
	<div id="table-striped" class="w-full">
		@table.Table(table.Config{
			Appearance: table.AppearanceStriped,
			Columns: defaultColumns(),
			Rows:    stripedRows(),
		})
	</div>
}

// tableActionPreview renders a table with an action button column.
templ tableActionPreview() {
	<div id="table-action" class="w-full">
		@table.Table(table.Config{
			Columns: actionColumns(),
			Rows:    actionRows(),
		})
	</div>
}

// tableCheckboxPreview renders row-selection controls.
templ tableCheckboxPreview() {
	<div id="table-checkbox" class="w-full">
		@table.Table(table.Config{
			ShowCheckbox: true,
			Columns:      actionColumns(),
			Rows:         checkboxRows(),
		})
	</div>
}

// tableUsersPreview renders the rich users table (avatars, badges, actions).
templ tableUsersPreview() {
	<div id="table-users" class="w-full">
		@table.Table(table.Config{
			Columns: usersColumns(),
			Rows:    usersRows(),
		})
	</div>
}

// tableSortablePreview renders the HTMX sortable table.
templ tableSortablePreview() {
	<div id="table-sortable" class="w-full">
		@table.Table(table.Config{
			ID:           "sortable-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
			SortBy:       "id",
			SortDir:      table.SortAsc,
			Columns:      sortableColumns(),
			Rows:         stripedRows(),
		})
	</div>
}

// tableLazyPreview renders the lazy-loaded table.
templ tableLazyPreview() {
	<div id="table-lazy" class="w-full space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
				The table renders its headers first. Rows are fetched only after you request them.
			</p>
			@button.Button(button.WithID("load-lazy-table")) {
				Load table
			}
		</div>
		@table.Table(table.Config{
			ID:           "lazy-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows?variant=lazy"},
			LazyLoad:     true,
			LazyTrigger:  "click from:#load-lazy-table",
			Columns:      defaultColumns(),
		})
	</div>
}

// tablePaginatedPreview renders the paginated table.
templ tablePaginatedPreview() {
	<div id="table-paginated" class="w-full">
		@table.Table(table.Config{
			ID:           "paginated-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
			Columns:      defaultColumns(),
			Rows:         paginatedRows(1),
			Pagination:   &table.PaginationConfig{CurrentPage: 1, TotalPages: 4, PerPage: 3},
		})
	</div>
}

// tableFilteredPreview renders the filter-bar (collapsible) table.
templ tableFilteredPreview() {
	<div id="table-filtered" class="w-full">
		@table.Table(table.Config{
			ID:           "filtered-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
			Columns: []table.Column{
				{Key: "id", Label: "CustomerID", Sortable: true},
				{Key: "name", Label: "Name", Sortable: true},
				{Key: "email", Label: "Email"},
				{Key: "membership", Label: "Membership", Sortable: true},
			},
			Rows:       paginatedRows(1),
			Pagination: &table.PaginationConfig{CurrentPage: 1, TotalPages: 4, PerPage: 3},
			Filters: &table.FilterConfig{
				Collapsible:       true,
				InitiallyExpanded: true,
				Filters: []table.Filter{
					{
						Key:         "search",
						Label:       "Search",
						Type:        table.FilterSearch,
						Placeholder: "Search by name or email...",
					},
					{
						Key:   "membership",
						Label: "Membership",
						Type:  table.FilterSelect,
						Options: []table.FilterOption{
							{Value: "", Label: "All Memberships"},
							{Value: "Gold", Label: "Gold"},
							{Value: "Silver", Label: "Silver"},
						},
					},
				},
			},
		})
	</div>
}

// tableInlineFilteredPreview renders the inline filter variant.
templ tableInlineFilteredPreview() {
	<div id="table-inline-filtered" class="w-full">
		@table.Table(table.Config{
			ID:           "inline-filtered-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows"},
			Columns: []table.Column{
				{Key: "id", Label: "CustomerID"},
				{Key: "name", Label: "Name"},
				{Key: "email", Label: "Email"},
				{Key: "membership", Label: "Membership"},
			},
			Rows:       paginatedRows(1),
			Pagination: &table.PaginationConfig{CurrentPage: 1, TotalPages: 4, PerPage: 3},
			Filters: &table.FilterConfig{
				Appearance: table.FilterAppearanceInline,
				Filters: []table.Filter{
					{
						Key:         "search",
						Type:        table.FilterSearch,
						Placeholder: "Search…",
					},
					{
						Key:  "membership",
						Type: table.FilterSelect,
						Options: []table.FilterOption{
							{Value: "", Label: "All"},
							{Value: "Gold", Label: "Gold"},
							{Value: "Silver", Label: "Silver"},
						},
					},
				},
			},
		})
	</div>
}

// tableInfinitePreview renders the infinite-scroll table.
templ tableInfinitePreview() {
	<div id="table-infinite" class="w-full">
		@table.Table(table.Config{
			ID:           "infinite-table",
			HTMX: &table.HTMXConfig{Endpoint: "/api/components/table/rows?variant=infinite"},
			Columns:      defaultColumns(),
			Rows:         infiniteScrollInitialRows(),
			Pagination: &table.PaginationConfig{
				Mode:            table.PaginationInfiniteScroll,
				CurrentPage:     1,
				PerPage:         3,
				HasMore:         true,
				ContainerHeight: "300px",
			},
		})
	</div>
}

