package components

import (
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// DrawerDemoPage renders the Drawer component demo.
templ DrawerDemoPage() {
	@demo.Layout("Drawer", "drawer", drawerDemoContent())
}

templ drawerDemoContent() {
	<div id="drawer-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Drawer",
				Description: "Slide-over panels for detail views, configuration forms, and HTMX-driven workflows that need more room than a modal.",
			},
			drawerDefaultPreview(),
			`@drawer.Drawer(drawer.Config{
    ID:    "projectDetails",
    Title: "Project details",
    Side:  drawer.SideRight,
    Width: drawer.WidthLG,
}) {
    <div id="projectDetails-body">...</div>
}`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Left Side",
				Description: "Set Side: drawer.SideLeft when the panel should enter from the navigation edge.",
			},
			drawerLeftPreview(),
			`@drawer.Drawer(drawer.Config{
    ID:    "filtersDrawer",
    Title: "Filters",
    Side:  drawer.SideLeft,
    Width: drawer.WidthSM,
}) {
    <div id="filtersDrawer-body">...</div>
}`,
		)
	</div>
	@demo.APIReference([]demo.PropDoc{
		{Name: "ID", Type: "string", Default: `""`, Description: "Unique drawer id used for Alpine state, events, body id, and aria-labelledby wiring."},
		{Name: "Title", Type: "string", Default: `""`, Description: "Accessible drawer heading."},
		{Name: "Side", Type: "Side", Default: "SideRight", Description: `Panel edge: "right" or "left".`},
		{Name: "Width", Type: "Width", Default: "WidthMD", Description: "Preset max width: sm, md, lg, xl, or full."},
		{Name: "BodyID", Type: "string", Default: `"{ID}-body"`, Description: "Inner scroll container id, useful as an HTMX target."},
		{Name: "Persistent", Type: "bool", Default: "false", Description: "Disable Esc and backdrop dismissal."},
		{Name: "PanelClass", Type: "string", Default: `""`, Description: "Extra classes on the sliding panel."},
	})
}

templ drawerDefaultPreview() {
	<div id="drawer-default" class="w-full max-w-2xl mx-auto">
		<button
			type="button"
			x-data
			x-on:click="$dispatch('drawer:open', { id: 'projectDetails' })"
			class="inline-flex items-center justify-center rounded-radius bg-primary px-4 py-2 text-sm font-medium text-on-primary hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-primary-dark dark:text-on-primary-dark dark:hover:bg-primary-dark/90"
		>
			Open details
		</button>
		@drawer.Drawer(drawer.Config{
			ID:    "projectDetails",
			Title: "Project details",
			Side:  drawer.SideRight,
			Width: drawer.WidthLG,
		}) {
			<div class="space-y-4 p-4">
				<div>
					<p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Deployment target</p>
					<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Production cluster, rolling update, two approvals required.</p>
				</div>
				<div class="rounded-radius border border-outline p-3 text-sm dark:border-outline-dark">
					<p class="font-medium">Current status</p>
					<p class="mt-1 text-on-surface-muted dark:text-on-surface-dark-muted">Ready for review</p>
				</div>
			</div>
		}
	</div>
}

templ drawerLeftPreview() {
	<div id="drawer-left" class="w-full max-w-2xl mx-auto">
		<button
			type="button"
			x-data
			x-on:click="$dispatch('drawer:open', { id: 'filtersDrawer' })"
			class="inline-flex items-center justify-center rounded-radius border border-outline px-4 py-2 text-sm font-medium text-on-surface hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:text-on-surface-dark dark:hover:bg-surface-dark-alt"
		>
			Open filters
		</button>
		@drawer.Drawer(drawer.Config{
			ID:    "filtersDrawer",
			Title: "Filters",
			Side:  drawer.SideLeft,
			Width: drawer.WidthSM,
		}) {
			<div class="space-y-3 p-4 text-sm">
				<label class="flex items-center gap-2">
					<input type="checkbox" class="size-4 rounded border-outline text-primary dark:border-outline-dark"/>
					<span>Only active records</span>
				</label>
				<label class="flex items-center gap-2">
					<input type="checkbox" class="size-4 rounded border-outline text-primary dark:border-outline-dark"/>
					<span>Needs attention</span>
				</label>
			</div>
		}
	</div>
}
