package components

import "github.com/araihu/goshtoso/site/internal/pages/demo"

// IconDemoPage renders the temporary Icon component documentation route.
// Task 4 replaces this placeholder with the complete sprite showcase.
templ IconDemoPage() {
	@demo.Layout("Icon", "icon", iconDemoContent())
}

templ iconDemoContent() {
	<div id="icon-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Icon",
				Description: "Render accessible SVG sprite symbols from a relative same-origin sprite or the current document.",
			},
			iconPendingPreview(),
			`@icon.Icon(icon.Config{
    SpriteURL: "/assets/icons/app.svg",
    Symbol:    "check",
    Label:     "Approved",
})`,
		)
	</div>
}

templ iconPendingPreview() {
	<div class="w-full rounded-radius border border-outline bg-surface p-5 text-sm text-on-surface dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark">
		The generic sprite renderer is available. Bundled sprite examples and attribution follow in the icon catalog showcase.
	</div>
}
