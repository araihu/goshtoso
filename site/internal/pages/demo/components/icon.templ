package components

import (
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// IconDemoPage renders a working sprite workbench: scan bundled glyphs, then
// configure one in the same focus-trapped modal used throughout Goshtoso.
templ IconDemoPage() {
	@demo.Layout("Icon", "icon", iconDemoContent())
}

templ iconDemoContent() {
	<div id="icon-fragment" x-data="iconCatalog">
		<div class="mb-8 max-w-3xl">
			<p class="mb-2 text-sm font-medium text-primary dark:text-primary-dark">Sprite icons</p>
			<h1 id="icon" data-toc-heading class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Heroicons, ready for Go</h1>
			<p class="mt-3 text-lg text-on-surface-muted dark:text-on-surface-dark-muted">
				Browse bundled, typed symbols. Pick one to tune its exact <code class="font-mono text-sm">icon.Config</code> and copy a standalone Go program.
			</p>
		</div>

		@iconUsageBasics()
		@iconCatalogGrid()
		@iconPickerModal()
	</div>
}

templ iconUsageBasics() {
	<section class="mb-10 rounded-radius border border-outline bg-surface-alt/50 p-5 dark:border-outline-dark dark:bg-surface-dark-alt/40" aria-labelledby="icon-basics-title">
		<div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
			<div>
				<h2 id="icon-basics-title" data-toc-heading class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Accessible defaults, visible behavior</h2>
				<p class="mt-1 max-w-2xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">A label makes an image. An empty label or <code class="font-mono">Decorative: true</code> hides the SVG from assistive technology. Sprite paths inherit <code class="font-mono">currentColor</code>; Goshtoso never forces fill or stroke.</p>
			</div>
			<span class="shrink-0 rounded-full border border-outline bg-surface px-3 py-1 text-xs font-medium text-on-surface-muted dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-muted">67 bundled glyphs</span>
		</div>
		<div class="mt-5 grid gap-3 md:grid-cols-3">
			<div data-testid="icon-variant-accessible" class="flex items-center gap-3 rounded-radius border border-outline bg-surface p-4 dark:border-outline-dark dark:bg-surface-dark">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidCheckCircle, Label: "Approved", RootClass: "text-success"})
				<div><p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Labelled image</p><p class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Announced as Approved</p></div>
			</div>
			<div data-testid="icon-variant-decorative" class="flex items-center gap-3 rounded-radius border border-outline bg-surface p-4 dark:border-outline-dark dark:bg-surface-dark">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidSparkles, Decorative: true, RootClass: "text-primary"})
				<div><p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Decorative accent</p><p class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Hidden from assistive tech</p></div>
			</div>
			<div data-testid="icon-variant-current-color" class="flex items-center gap-3 rounded-radius border border-outline bg-surface p-4 text-secondary dark:border-outline-dark dark:bg-surface-dark dark:text-secondary-dark">
				@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidPaintBrush, Decorative: true})
				<div><p class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">currentColor</p><p class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Color comes from its parent</p></div>
			</div>
		</div>
		<div class="mt-5 flex flex-wrap items-end gap-5 rounded-radius border border-dashed border-outline bg-surface px-4 py-3 text-primary dark:border-outline-dark dark:bg-surface-dark dark:text-primary-dark" aria-label="Icon size scale">
			<span class="mr-1 text-xs font-medium text-on-surface-muted dark:text-on-surface-dark-muted">All sizes</span>
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeXS})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeSM})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeMD})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeLG})
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: heroicons.Icon16SolidStar, Decorative: true, Size: icon.SizeXL})
		</div>
	</section>
}

templ iconCatalogGrid() {
	<section aria-labelledby="icon-catalog-title">
		<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 id="icon-catalog-title" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Bundled symbol catalog</h2>
				<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Every card comes from <code class="font-mono">heroicons.Glyphs</code>, not a second hand-written list.</p>
			</div>
			<a href="/assets/icons/HEROICONS_LICENSE.txt" class="text-sm font-medium text-primary underline underline-offset-4 dark:text-primary-dark">Heroicons MIT notice</a>
		</div>
		<div data-testid="icon-catalog-grid" class="grid grid-cols-1 sm:grid-cols-3 xl:grid-cols-6 gap-3">
			for _, glyph := range heroicons.Glyphs {
				@iconCatalogCard(glyph)
			}
		</div>
	</section>
}

templ iconCatalogCard(glyph heroicons.Glyph) {
	<button
		type="button"
		data-icon-card={ glyph.GoName }
		data-icon-name={ glyph.GoName }
		data-icon-symbol={ string(glyph.Symbol) }
		@click="selectGlyph($el)"
		class="group min-h-36 rounded-radius border border-outline bg-surface p-4 text-left transition-colors hover:border-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:bg-surface-dark dark:hover:border-primary-dark dark:focus-visible:outline-primary-dark"
	>
		<span class="mb-5 flex size-11 items-center justify-center rounded-radius bg-primary/10 text-primary transition-transform group-hover:scale-105 dark:bg-primary-dark/15 dark:text-primary-dark">
			@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: glyph.Symbol, Decorative: true, RootClass: "size-6"})
		</span>
		<span class="block break-words font-mono text-xs font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ glyph.GoName }</span>
		<span class="mt-1 block truncate font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ glyph.Symbol }</span>
	</button>
}

// iconPickerModal preserves the Goshtoso modal contract: x-trap brings focus
// containment and inert/noscroll behavior, Escape and backdrop dismiss it.
templ iconPickerModal() {
	<div
		x-cloak
		x-show="open"
		x-transition.opacity.duration.200ms
		x-trap.inert.noscroll="open"
		x-on:keydown.esc.window="close()"
		x-on:click.self="close()"
		class="fixed inset-0 z-30 flex items-end justify-center bg-black/20 p-4 pb-8 backdrop-blur-md sm:items-center lg:p-8"
		data-testid="icon-picker-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="icon-picker-title"
	>
		<div x-show="open" x-transition:enter="transition ease-out duration-200 delay-100 motion-reduce:transition-opacity" x-transition:enter-start="opacity-0 scale-50" x-transition:enter-end="opacity-100 scale-100" class="flex max-h-full w-full max-w-3xl flex-col overflow-auto rounded-radius border border-outline bg-surface text-on-surface dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark">
			<div class="flex items-center justify-between border-b border-outline bg-surface-alt/60 p-4 dark:border-outline-dark dark:bg-surface-dark/20">
				<div><p class="text-xs font-medium text-primary dark:text-primary-dark">Icon workbench</p><h2 id="icon-picker-title" class="font-title text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong" x-text="selected.name"></h2></div>
				<button data-testid="icon-modal-close" type="button" @click="close()" aria-label="Close icon workbench" class="rounded-radius p-1 text-on-surface-muted hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-on-surface-dark-muted dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark">
					<span aria-hidden="true" class="text-xl leading-none">×</span>
				</button>
			</div>
			<div class="grid gap-6 p-5 md:grid-cols-[minmax(0,1fr)_18rem]">
				<div>
					<div class="flex min-h-44 items-center justify-center rounded-radius border border-dashed border-outline bg-surface-alt/40 text-primary dark:border-outline-dark dark:bg-surface-dark/30 dark:text-primary-dark">
						<svg data-testid="icon-live-preview" xmlns="http://www.w3.org/2000/svg" x-bind:class="previewClass" x-bind:aria-hidden="isDecorative" x-bind:role="isDecorative ? null : 'img'" x-bind:aria-label="isDecorative ? null : label" viewBox="0 0 24 24"><use x-bind:href="spriteHref"></use></svg>
					</div>
					<p class="mt-3 font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted" x-text="selected.symbol"></p>
					<div class="mt-4 overflow-hidden rounded-radius border border-outline bg-slate-950 text-slate-50 dark:border-outline-dark">
						<div class="flex items-center justify-between border-b border-white/10 px-3 py-2"><span class="text-xs font-medium">Standalone Go</span><button type="button" @click="copyCode()" class="rounded-radius px-2 py-1 text-xs font-medium text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><span x-text="copied ? 'Copied Go source' : 'Copy compilable Go'"></span></button></div>
						<pre class="overflow-x-auto p-3 text-xs leading-5"><code x-text="code"></code></pre>
					</div>
					<p class="sr-only" aria-live="polite" x-text="copyAnnouncement"></p>
				</div>
				<div class="space-y-4">
					<div><label for="icon-size" class="mb-1 block text-sm font-medium">Size</label><select id="icon-size" x-model="size" class="w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm dark:border-outline-dark dark:bg-surface-dark"><option value="">md (default)</option><option value="xs">xs</option><option value="sm">sm</option><option value="lg">lg</option><option value="xl">xl</option></select></div>
					<div><label for="icon-label" class="mb-1 block text-sm font-medium">Label</label><input id="icon-label" type="text" x-model="label" :disabled="decorative" placeholder="e.g. Search" class="w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm disabled:cursor-not-allowed disabled:opacity-60 dark:border-outline-dark dark:bg-surface-dark"/><p class="mt-1 text-xs text-on-surface-muted dark:text-on-surface-dark-muted" x-show="!decorative && !label.trim()">Blank label renders a decorative icon.</p></div>
					<label class="flex cursor-pointer items-start gap-3 rounded-radius border border-outline p-3 text-sm dark:border-outline-dark"><input type="checkbox" x-model="decorative" class="mt-0.5 size-4 rounded border-outline text-primary focus:ring-primary dark:border-outline-dark dark:bg-surface-dark dark:text-primary-dark"/><span><span class="block font-medium">Decorative</span><span class="block text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Clears label and hides SVG from assistive technology.</span></span></label>
					<div><label for="icon-root-class" class="mb-1 block text-sm font-medium">Root class</label><input id="icon-root-class" type="text" x-model="rootClass" placeholder="text-primary" class="w-full rounded-radius border border-outline bg-surface px-3 py-2 font-mono text-sm dark:border-outline-dark dark:bg-surface-dark"/></div>
					<p class="rounded-radius border border-outline bg-surface-alt/50 p-3 text-xs text-on-surface-muted dark:border-outline-dark dark:bg-surface-dark/30 dark:text-on-surface-dark-muted"><code class="font-mono">SpriteURL</code> is <code class="font-mono">heroicons.SpriteURL</code>; <code class="font-mono">ModeExternal</code> is its zero-value default.</p>
				</div>
			</div>
		</div>
	</div>
}
