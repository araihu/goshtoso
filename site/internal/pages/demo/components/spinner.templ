package components

import (
	"github.com/araihu/goshtoso/components/radio"
	"github.com/araihu/goshtoso/components/spinner"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// SpinnerDemoPage renders the Spinner component demo
templ SpinnerDemoPage() {
	@demo.Layout("Spinner", "spinner", spinnerDemoContent())
}

// spinnerDemoContent renders the demo. Each spinner variant lives in its own
// preview frame followed by its own code block (mirrors
// penguinui.com/components/spinner). Wrapped in #spinner-fragment.
templ spinnerDemoContent() {
	<div id="spinner-fragment" x-data="{ selected: 'md' }">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Spinner",
				Description: "An animated circular loading indicator in six semantic colors and four sizes.",
			},
			spinnerDefaultPreview(),
			`@spinner.Spinner(spinner.Config{})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Color Variants",
				Description: "Set Variant: Primary, Secondary, Info, Success, Warning, or Danger.",
			},
			spinnerVariantsPreview(),
			`@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary})
@spinner.Spinner(spinner.Config{Tone: spinner.ToneDanger})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:        "Sizes",
				Description:  "Four sizes via Size: SizeSM, SizeMD (default), SizeLG, SizeXL.",
				AbovePreview: spinnerSizeSelector(),
			},
			spinnerSizesPreview(),
			`@spinner.Spinner(spinner.Config{Size: spinner.SizeSM})
@spinner.Spinner(spinner.Config{Size: spinner.SizeXL})`,
		)
	</div>
	// API reference lives outside #spinner-fragment.
	@demo.APIReference([]demo.PropDoc{
		{Name: "Tone", Type: "Tone", Default: "ToneDefault", Description: `Color: "default", "primary", "secondary", "info", "success", "warning", "danger".`},
		{Name: "Size", Type: "Size", Default: "SizeMD", Description: `Size: "sm", "md", "lg", "xl".`},
		{Name: "RootClass", Type: "string", Default: `""`, Description: "Extra classes on the spinner SVG."},
	})
}

// spinnerSizeSelector renders the segmented size control above the sizes
// preview frame.
templ spinnerSizeSelector() {
	<div class="mb-3 flex items-center gap-4">
		<label class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Size</label>
		<div data-testid="spinner-size-selector">
			@radio.RadioBar() {
				@spinnerSizeOption("sm", "sm")
				@spinnerSizeOption("md", "md")
				@spinnerSizeOption("lg", "lg")
				@spinnerSizeOption("xl", "xl")
			}
		</div>
		<span class="sr-only" data-testid="spinner-size-selected" x-text="selected"></span>
	</div>
}

// spinnerSizeOption renders a single segmented pill for the spinner size
// selector.
templ spinnerSizeOption(value, label string) {
	@radio.Radio(radio.Config{
		ID:        "spinner-size-" + value,
		Name:      "spinner-size",
		Value:     value,
		Label:     label,
		Segmented: true,
		Alpine: &radio.AlpineConfig{
			BindChecked: "selected === '" + value + "'",
			OnChange:    "selected = '" + value + "'",
		},
	})
}

// spinnerDefaultPreview renders the default spinner.
templ spinnerDefaultPreview() {
	<div id="spinner-default" class="w-full max-w-md mx-auto">
		<div class="flex items-center justify-center gap-4">
			@spinner.Spinner(spinner.Config{})
		</div>
	</div>
}

// spinnerVariantsPreview renders the six color variants.
templ spinnerVariantsPreview() {
	<div id="spinner-variants" class="w-full max-w-md mx-auto">
		<div class="flex items-center justify-center gap-4">
			@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary})
			@spinner.Spinner(spinner.Config{Tone: spinner.ToneSecondary})
			@spinner.Spinner(spinner.Config{Tone: spinner.ToneInfo})
			@spinner.Spinner(spinner.Config{Tone: spinner.ToneSuccess})
			@spinner.Spinner(spinner.Config{Tone: spinner.ToneWarning})
			@spinner.Spinner(spinner.Config{Tone: spinner.ToneDanger})
		</div>
	</div>
}

// spinnerSizesPreview renders the four sizes.
templ spinnerSizesPreview() {
	<div id="spinner-sizes" class="w-full max-w-md mx-auto">
		<div class="flex items-center justify-center">
			<div data-testid="spinner-size-preview-sm" x-show="selected === 'sm'" x-cloak>
				@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary, Size: spinner.SizeSM})
			</div>
			<div data-testid="spinner-size-preview-md" x-show="selected === 'md'">
				@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary, Size: spinner.SizeMD})
			</div>
			<div data-testid="spinner-size-preview-lg" x-show="selected === 'lg'" x-cloak>
				@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary, Size: spinner.SizeLG})
			</div>
			<div data-testid="spinner-size-preview-xl" x-show="selected === 'xl'" x-cloak>
				@spinner.Spinner(spinner.Config{Tone: spinner.TonePrimary, Size: spinner.SizeXL})
			</div>
		</div>
	</div>
}
