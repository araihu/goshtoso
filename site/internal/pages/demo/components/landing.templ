package components

import (
	"github.com/araihu/goshtoso/assets"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/card"
	"github.com/araihu/goshtoso/components/radio"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/toggle"
	siteassets "github.com/araihu/goshtoso/site/assets"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
	"github.com/araihu/goshtoso/site/internal/themes"
)

type exampleApp struct {
	Title    string
	Tag      string
	Desc     string
	URL      string
	Image    string
	ImageAlt string
}

func getExampleApps() []exampleApp {
	return []exampleApp{
		{Title: "Todo", Tag: "HTMX CRUD", Desc: "Cookie-backed, fully HTMX-driven CRUD with no server-side session state.", URL: "/examples/todo", Image: "/assets/images/homepage/examples/todo.webp", ImageAlt: "Todo app task form, filters, priorities, and task rows"},
		{Title: "Expenses", Tag: "HTMX forms", Desc: "Cookie-backed spend log with search, category filters, pagination, and a live total.", URL: "/examples/expense", Image: "/assets/images/homepage/examples/expense.webp", ImageAlt: "Expense tracker form, category filters, and transaction rows"},
		{Title: "Chat", Tag: "WebSocket", Desc: "Real-time messaging over a WebSocket, server-rendered bubbles.", URL: "/examples/chat", Image: "/assets/images/homepage/examples/chat.webp", ImageAlt: "Live chat app exchanging server-rendered messages with an ELIZA bot"},
		{Title: "Logs", Tag: "Server-sent events", Desc: "Server-push log stream over SSE (htmx-ext-sse) with client-side filtering.", URL: "/examples/logs", Image: "/assets/images/homepage/examples/logs.webp", ImageAlt: "Streaming server log viewer with filters and connection controls"},
		{Title: "Profile", Tag: "IndexedDB", Desc: "An account settings screen composed from form components.", URL: "/examples/profile", Image: "/assets/images/homepage/examples/profile.webp", ImageAlt: "Profile editor with local avatar storage and identity fields"},
		{Title: "Ticker", Tag: "Live SSE", Desc: "A streaming price table that updates rows in place.", URL: "/examples/ticker", Image: "/assets/images/homepage/examples/ticker.webp", ImageAlt: "Live stock cards updating prices over server-sent events"},
		{Title: "Wizard", Tag: "Server validation", Desc: "A multi-step setup flow with validation, progress, review, and cookie-backed state.", URL: "/examples/wizard", Image: "/assets/images/homepage/examples/wizard.webp", ImageAlt: "Onboarding wizard with server-validated account fields and progress steps"},
	}
}

func getFeaturedExampleApp() exampleApp {
	apps := getExampleApps()
	return apps[len(apps)-1]
}

func getSupportingExampleApps() []exampleApp {
	apps := getExampleApps()
	return apps[:len(apps)-1]
}

type themeChip struct {
	Key   string
	Label string
}

// Curated subset of themes: visually distinct, not the whole set.
func getThemeChips() []themeChip {
	return []themeChip{
		{Key: "araihu", Label: "Arai Hû"},
		{Key: "goshtoso", Label: "Goshtoso"},
		{Key: "minimal", Label: "Minimal"},
		{Key: "modern", Label: "Modern"},
		{Key: "dracula", Label: "Dracula"},
	}
}

templ LandingPage() {
	<!DOCTYPE html>
	<html lang="en" x-data data-demo-storage-policy="strict" data-demo-theme-bootstrap>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@demo.HeadMeta(demo.HomeMeta())
			<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/>
			<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
			<link rel="manifest" href="/site.webmanifest"/>
			// Apply the persisted theme + dark mode synchronously, before first
			// paint, identical to the demo layout's boot script (layout.templ).
			// Doing this here (not in Alpine x-init) keeps the homepage's theme in
			// lock-step with the rest of the site and avoids a flash of the default
			// theme on navigation. Shares localStorage key 'theme' / 'darkMode'.
			<script src={ siteassets.DemoBundleURL }></script>
			<link rel="stylesheet" href="/assets/styles.css"/>
			<link rel="stylesheet" href="/componentdocshell/assets/araihu.css"/>
			<script defer src={ assets.AlpineJSURL }></script>
			<script src={ assets.HTMXURL }></script>
			<style>[x-cloak] { display: none !important; }</style>
		</head>
		<body class="min-h-screen bg-surface text-on-surface dark:bg-surface-dark dark:text-on-surface-dark">
			@landingContent()
			@cookieConsent()
		</body>
	</html>
}

templ landingContent() {
	<a href="#hero-content" class="sr-only fixed left-4 top-4 z-[60] rounded-radius bg-primary px-4 py-3 font-bold text-on-primary focus:not-sr-only dark:bg-primary-dark dark:text-on-primary-dark">Skip to main content</a>
	<main id="main-content" class="min-h-screen overflow-hidden">
		<!-- Hero -->
		<section id="hero" class="relative border-b border-outline/70 bg-surface-alt/40 dark:border-outline-dark/70 dark:bg-surface-dark-alt/30">
			<div class="relative mx-auto max-w-6xl px-5 sm:px-8">
				<header class="flex h-20 items-center justify-between border-b border-outline/60 dark:border-outline-dark/60">
					<a href="/" class="inline-flex min-w-0 items-center gap-3 rounded-radius focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:focus-visible:ring-primary-dark" aria-label="Goshtoso home" data-brand-lockup>
						<img src="/assets/images/goshtoso-logo.svg" alt="" aria-hidden="true" class="h-10 w-auto max-w-48 shrink-0"/>
						<span class="min-w-0">
							<span class="hidden text-xs text-on-surface-muted dark:text-on-surface-dark-muted sm:block">Server-rendered Go UI</span>
						</span>
					</a>
					<nav aria-label="Primary navigation" class="flex items-center gap-1 text-sm sm:gap-2">
						<a href="/components/accordion" class="hidden rounded-radius px-3 py-2 font-medium text-on-surface transition-colors hover:bg-surface dark:text-on-surface-dark dark:hover:bg-surface-dark sm:inline-flex">Components</a>
						<a href="/examples" class="hidden rounded-radius px-3 py-2 font-medium text-on-surface transition-colors hover:bg-surface dark:text-on-surface-dark dark:hover:bg-surface-dark md:inline-flex">Examples</a>
						<a href="/getting-started" class="rounded-radius border border-outline bg-surface px-3 py-2 font-medium text-on-surface-strong transition-colors hover:border-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:hover:border-primary-dark sm:px-4">Get started</a>
					</nav>
				</header>
				<div id="hero-content" tabindex="-1" class="grid items-center gap-12 py-14 outline-none sm:py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,0.95fr)] lg:gap-16 lg:py-24">
					<div class="landing-hero-copy max-w-2xl">
						<div class="mb-6 inline-flex items-center gap-2 rounded-full border border-outline bg-surface px-3 py-1.5 text-xs font-bold text-on-surface dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark">
							<span class="size-2 rounded-full bg-success dark:bg-success-dark"></span>
							No JavaScript build step
						</div>
						<h1 class="font-title text-4xl font-bold leading-[1.05] text-on-surface-strong dark:text-on-surface-dark-strong sm:text-6xl lg:text-7xl">
							Build server-rendered Go interfaces with typed components.
						</h1>
						<p class="mt-6 max-w-xl text-lg leading-8 text-on-surface dark:text-on-surface-dark sm:text-xl">
							Import pre-generated templ components, serve bundled assets, and add HTMX or Alpine.js only where the interface needs interaction.
						</p>
						<div class="mt-8 grid grid-cols-2 gap-3 sm:flex sm:flex-row sm:flex-wrap">
							<a href="/getting-started" data-primary-cta class="col-span-2 inline-flex min-h-11 items-center justify-center gap-2 rounded-radius bg-primary px-6 py-3 text-sm font-bold text-on-primary transition-opacity hover:opacity-90 dark:bg-primary-dark dark:text-on-primary-dark sm:col-auto">
								Render your first component <span aria-hidden="true">→</span>
							</a>
							<a href="/components/accordion" class="inline-flex min-h-11 items-center justify-center rounded-radius border border-outline bg-surface px-4 py-3 text-sm font-bold text-on-surface-strong transition-colors hover:border-primary dark:border-outline-dark dark:bg-surface-dark dark:text-on-surface-dark-strong dark:hover:border-primary-dark sm:px-6">
								Browse { componentCount() } components
							</a>
							<a href="https://github.com/araihu/goshtoso" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center justify-center rounded-radius border border-outline px-4 py-3 text-sm font-medium text-on-surface underline-offset-4 hover:border-primary hover:underline dark:border-outline-dark dark:text-on-surface-dark dark:hover:border-primary-dark sm:border-0">
								GitHub
							</a>
						</div>
						<div class="mt-8 flex max-w-xl items-center gap-3 overflow-x-auto rounded-radius border border-outline bg-surface px-4 py-3 dark:border-outline-dark dark:bg-surface-dark" aria-label="Install Goshtoso">
							<span class="font-mono text-xs font-bold text-primary dark:text-primary-dark" aria-hidden="true">$</span>
							<code class="whitespace-nowrap font-mono text-[0.7rem] text-on-surface-strong dark:text-on-surface-dark-strong sm:text-xs">go get github.com/araihu/goshtoso@latest</code>
						</div>
					</div>
					<div class="landing-hero-preview relative mx-auto w-full max-w-xl" data-hero-preview>
						<div class="overflow-hidden rounded-radius border border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark">
							<div class="bg-on-surface-strong px-5 py-5 text-white sm:px-6">
								<div class="mb-4 flex items-center justify-between border-b border-white/20 pb-3">
									<span class="font-mono text-xs text-white/70">deploy.templ</span>
									<span class="font-mono text-[0.65rem] text-white/60">Go → HTML</span>
								</div>
								@templ.Raw(`<pre class="overflow-x-auto font-mono text-[0.68rem] leading-6 sm:text-xs"><code><span class="text-primary-dark">templ</span> DeployPanel() {
  <span class="text-success-dark">@badge.Badge</span>(badge.Config{Label: <span class="text-warning-dark">"Live"</span>})
  <span class="text-success-dark">@toggle.Toggle</span>(toggle.Config{Checked: true})
  <span class="text-success-dark">@button.Button</span>() { Deploy }
}</code></pre>`)
							</div>
							<div class="p-5 sm:p-6">
								<div class="flex items-start justify-between gap-4">
									<div>
										<p class="text-xs font-bold text-primary dark:text-primary-dark">RENDERED BY GO</p>
										<h2 class="mt-2 font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Ready to ship</h2>
										<p class="mt-2 text-sm leading-6 text-on-surface dark:text-on-surface-dark">Typed props in, accessible HTML out. No client app between them.</p>
									</div>
									<img src="/assets/images/goshtoso-art-home.webp" width="256" height="384" alt="Goshtoso gopher mascot in Rio de Janeiro" class="size-16 shrink-0 rounded-radius object-cover sm:size-20"/>
								</div>
								<div class="mt-5 flex flex-wrap items-center gap-3 border-t border-outline pt-5 dark:border-outline-dark">
									@badge.Badge(badge.Config{Label: "Live", Tone: badge.ToneSuccess})
									@toggle.Toggle(toggle.Config{ID: "hero-notifications", Label: "Notify team", Checked: true})
									<span class="sm:ml-auto">
										@button.Button() {
											Deploy
										}
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
			<!-- Live playground -->
			<section id="playground" class="mb-28 sm:mb-32">
				<div class="mb-8 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.8fr)] lg:items-end">
					<div>
						<p class="mb-3 text-xs font-bold text-primary dark:text-primary-dark">LIVE PLAYGROUND</p>
						<h2 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">Change the theme. Keep the behavior.</h2>
					</div>
					<p class="max-w-xl text-base leading-7 text-on-surface dark:text-on-surface-dark lg:justify-self-end">
						Every control below is a real Goshtoso component. Switch themes and the full surface updates instantly without a reload.
					</p>
				</div>
				<div class="overflow-hidden rounded-radius border border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark">
					<div class="flex flex-col gap-4 border-b border-outline bg-surface-alt/70 px-4 py-4 dark:border-outline-dark dark:bg-surface-dark-alt/70 sm:flex-row sm:items-center sm:justify-between sm:px-6" x-data="{ theme: document.documentElement.dataset.theme }">
						<div>
							<p class="font-title text-sm font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Customer workspace</p>
							<p class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Live theme preview</p>
						</div>
						<div class="flex max-w-full flex-col gap-2 sm:items-end">
							<div id="home-theme-picker" class="max-w-full overflow-x-auto pb-1" role="radiogroup" aria-label="Homepage theme">
								@radio.RadioBar() {
									for _, c := range getThemeChips() {
										@radio.Radio(radio.Config{
											ID:        "home-theme-" + c.Key,
											Name:      "home-theme",
											Value:     c.Key,
											Label:     c.Label,
											Checked:   c.Key == "goshtoso",
											Segmented: true,
											RootClass: "min-w-28 px-4",
											Alpine: &radio.AlpineConfig{
												BindChecked: "theme === $el.value",
												OnChange:    "theme = $el.value; document.documentElement.dataset.theme = theme; if (window.goshtosoStorageConsent && window.goshtosoStorageConsent.allowed()) localStorage.theme = theme",
											},
											InputAttrs: templ.Attributes{"data-theme-key": c.Key},
										})
									}
								}
							</div>
							<a href="/docs/theme" class="text-xs font-medium text-primary underline underline-offset-2 dark:text-primary-dark">Explore all { themes.Count() } themes</a>
						</div>
					</div>
					<div class="space-y-6 p-4 sm:p-6">
						<div class="flex flex-wrap items-center gap-3 border-b border-outline pb-6 dark:border-outline-dark">
							@button.Button() {
								Primary
							}
							@button.Button(button.WithTone(button.ToneSecondary)) {
								Secondary
							}
							@badge.Badge(badge.Config{Label: "Active", Tone: badge.ToneSuccess})
							@badge.Badge(badge.Config{Label: "Pending", Tone: badge.ToneWarning})
							@toggle.Toggle(toggle.Config{ID: "homeToggle", Label: "Notifications", Checked: true})
						</div>
						<div class="overflow-x-auto">
							@table.Table(table.Config{
								ID:       "home-table",
								HTMX:     &table.HTMXConfig{Endpoint: "/api/components/table/rows?variant=lazy"},
								LazyLoad: true,
								Columns: []table.Column{
									{Key: "id", Label: "Customer ID", Sortable: true},
									{Key: "name", Label: "Name", Sortable: true},
									{Key: "email", Label: "Email"},
									{Key: "membership", Label: "Membership", Sortable: true},
								},
							})
						</div>
					</div>
				</div>
			</section>
			<!-- How it works -->
			<section id="how-it-works" class="mb-20 sm:mb-24">
				<div class="mb-8 max-w-2xl">
					<h2 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">A short path from handler to interface.</h2>
					<p class="mt-4 text-base leading-7 text-on-surface dark:text-on-surface-dark">Use the Go tools you already know. Goshtoso adds the UI layer without moving your application into a client runtime.</p>
				</div>
				<div class="grid grid-cols-1 overflow-hidden rounded-radius border border-outline bg-surface dark:border-outline-dark dark:bg-surface-dark md:grid-cols-3">
					<div class="p-6 md:p-8">
						<code class="mb-8 block font-mono text-xs font-bold text-primary dark:text-primary-dark">component.templ</code>
						<h3 class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Compose typed templates</h3>
						<p class="mt-3 text-sm leading-6 text-on-surface dark:text-on-surface-dark">Write typed <code class="font-mono text-on-surface-strong dark:text-on-surface-dark-strong">.templ</code> components that compile directly to Go.</p>
					</div>
					<div class="border-y border-outline bg-surface-alt/40 p-6 dark:border-outline-dark dark:bg-surface-dark-alt/40 md:border-x md:border-y-0 md:p-8">
						<code class="mb-8 block font-mono text-xs font-bold text-primary dark:text-primary-dark">hx-target="#main"</code>
						<h3 class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Return HTML fragments</h3>
						<p class="mt-3 text-sm leading-6 text-on-surface dark:text-on-surface-dark">Return rendered fragments from handlers and let HTMX swap plain HTML.</p>
					</div>
					<div class="p-6 md:p-8">
						<code class="mb-8 block font-mono text-xs font-bold text-primary dark:text-primary-dark">go build ./...</code>
						<h3 class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Ship one Go binary</h3>
						<p class="mt-3 text-sm leading-6 text-on-surface dark:text-on-surface-dark">Bundle runtime assets with no <code class="font-mono text-on-surface-strong dark:text-on-surface-dark-strong">node_modules</code>, CDN dependency, or client router.</p>
					</div>
				</div>
			</section>
			<!-- Example apps gallery -->
			<section id="examples" class="mb-28 sm:mb-32">
				<div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<h2 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">Built with Goshtoso</h2>
						<p class="mt-3 max-w-2xl text-on-surface dark:text-on-surface-dark">Full applications that show components working together across forms, live data, streaming, and multi-step flows.</p>
					</div>
					<a href="/examples" class="inline-flex shrink-0 items-center gap-2 text-sm font-bold text-primary underline-offset-4 hover:underline dark:text-primary-dark">Explore every example <span aria-hidden="true">→</span></a>
				</div>
				{{ featured := getFeaturedExampleApp() }}
				<div class="space-y-6">
					<a href={ templ.SafeURL(featured.URL) } data-example-card data-featured-example-card class="group mx-auto block w-full max-w-sm rounded-radius focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface dark:focus-visible:ring-primary-dark dark:focus-visible:ring-offset-surface-dark sm:max-w-none">
						@card.Card(card.Config{
							Image:       featured.Image,
							ImageAlt:    featured.ImageAlt,
							Tag:         featured.Tag,
							Title:       featured.Title,
							Description: featured.Desc,
							Footer:      exampleCardAction(),
							Layout:      card.LayoutHorizontal,
							RootClass:   "max-w-none bg-surface transition-colors hover:border-primary dark:bg-surface-dark dark:hover:border-primary-dark [&>div:first-child]:h-36 sm:[&>div:first-child]:h-40 md:[&>div:first-child]:h-auto [&>div:first-child>img]:h-full [&>div:first-child>img]:w-full [&>div:last-child]:gap-2 [&>div:last-child]:p-4 sm:[&>div:last-child]:gap-4 sm:[&>div:last-child]:p-6",
						})
					</a>
				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3" role="region" aria-label="Example applications">
						for i, a := range getSupportingExampleApps() {
							{{ supportingClass := "group block h-full w-full max-w-sm rounded-radius focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface dark:focus-visible:ring-primary-dark dark:focus-visible:ring-offset-surface-dark min-[480px]:mx-auto sm:max-w-none" }}
							if i >= 2 {
								{{ supportingClass += " max-[479px]:hidden" }}
							}
							<a href={ templ.SafeURL(a.URL) } data-example-card data-supporting-example-card class={ supportingClass }>
								@card.Card(card.Config{
									Image:       a.Image,
									ImageAlt:    a.ImageAlt,
									Tag:         a.Tag,
									Title:       a.Title,
									Description: a.Desc,
									Footer:      exampleCardAction(),
									RootClass:   "h-full max-w-none bg-surface transition-colors hover:border-primary dark:bg-surface-dark dark:hover:border-primary-dark [&>div:first-child]:h-32 sm:[&>div:first-child]:h-40 md:[&>div:first-child]:h-44 [&>div:first-child>img]:h-full [&>div:first-child>img]:w-full [&>div:last-child]:gap-2 [&>div:last-child]:p-4 sm:[&>div:last-child]:gap-4 sm:[&>div:last-child]:p-6",
								})
							</a>
						}
					</div>
				</div>
			</section>
			<!-- Stack strip -->
			<section id="stack-strip" class="mb-16 rounded-radius border border-outline bg-surface-alt/60 px-6 py-8 text-center dark:border-outline-dark dark:bg-surface-dark-alt/60">
				<p class="mb-4 text-sm font-bold text-on-surface-strong dark:text-on-surface-dark-strong">The stack stays yours</p>
				<div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm">
					<a href="https://go.dev/" target="_blank" rel="noopener" class="font-medium text-on-surface dark:text-on-surface-dark hover:text-primary dark:hover:text-primary-dark transition-colors">Go</a>
					<a href="https://templ.guide/" target="_blank" rel="noopener" class="font-medium text-on-surface dark:text-on-surface-dark hover:text-primary dark:hover:text-primary-dark transition-colors">Templ</a>
					<a href="https://tailwindcss.com/" target="_blank" rel="noopener" class="font-medium text-on-surface dark:text-on-surface-dark hover:text-primary dark:hover:text-primary-dark transition-colors">Tailwind CSS</a>
					<a href="https://alpinejs.dev/" target="_blank" rel="noopener" class="font-medium text-on-surface dark:text-on-surface-dark hover:text-primary dark:hover:text-primary-dark transition-colors">Alpine.js</a>
					<a href="https://htmx.org/" target="_blank" rel="noopener" class="font-medium text-on-surface dark:text-on-surface-dark hover:text-primary dark:hover:text-primary-dark transition-colors">HTMX</a>
				</div>
			</section>
			<!-- Footer -->
			<footer class="flex flex-col gap-6 border-t border-outline pt-8 text-sm dark:border-outline-dark sm:flex-row sm:items-center sm:justify-between">
				<div class="flex items-center gap-3">
					<img src="/assets/images/goshtoso-mark.svg" alt="" aria-hidden="true" class="size-9 rounded-radius"/>
					<p class="text-on-surface dark:text-on-surface-dark"><span class="font-title font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Goshtoso</span><br/><span class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ componentCount() } components · { themes.Count() } themes · local assets</span></p>
				</div>
				<div class="flex flex-wrap gap-x-5 gap-y-2">
					<a href="/getting-started" class="text-primary underline-offset-4 hover:underline dark:text-primary-dark">Get started</a>
					<a href="/privacy" class="text-on-surface hover:text-primary dark:text-on-surface-dark dark:hover:text-primary-dark">Privacy</a>
					<a href="https://github.com/araihu/goshtoso" target="_blank" rel="noopener" class="text-on-surface hover:text-primary dark:text-on-surface-dark dark:hover:text-primary-dark">GitHub</a>
				</div>
			</footer>
		</div>
	</main>
}

templ exampleCardAction() {
	<span class="inline-flex items-center gap-1 text-sm font-medium text-primary transition-colors group-hover:gap-2 dark:text-primary-dark">
		View app
		<span aria-hidden="true">→</span>
	</span>
}

// cookieConsent renders the browser-storage notice. Keep in lock-step with the
// demo layout's banner.
templ cookieConsent() {
	<div
		x-data="demoStorageConsent"
		x-show="show"
		x-cloak
		x-transition
		class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-xl rounded-radius border border-outline bg-surface/95 text-on-surface shadow-xl backdrop-blur dark:border-outline-dark dark:bg-surface-dark/95 dark:text-on-surface-dark sm:inset-x-auto sm:bottom-6 sm:right-6 sm:mx-0"
		role="dialog"
		aria-modal="false"
		aria-labelledby="landing-cookie-title"
	>
		<div class="flex flex-col gap-3 p-3 sm:gap-4 sm:p-5">
			<h3 id="landing-cookie-title" class="sr-only">Browser storage</h3>
			<p class="text-xs leading-5 text-on-surface dark:text-on-surface-dark sm:text-sm">
				Store themes and demo preferences on this device. No analytics or tracking.
				<a href="/privacy" class="text-primary dark:text-primary-dark underline underline-offset-2">Privacy Policy</a>.
			</p>
			<div class="grid grid-cols-2 gap-2 sm:flex sm:justify-end">
				<button
					@click="deny()"
					class="min-h-11 px-3 py-2 text-xs font-medium rounded-radius border border-outline text-on-surface dark:border-outline-dark dark:text-on-surface-dark hover:border-primary dark:hover:border-primary-dark hover:text-primary dark:hover:text-primary-dark transition-colors"
				>
					Use without storage
				</button>
				<button
					@click="allow()"
					class="min-h-11 px-3 py-2 text-xs font-medium rounded-radius bg-primary text-on-primary dark:bg-primary-dark dark:text-on-primary-dark hover:opacity-90 transition-opacity"
				>
					Allow browser storage
				</button>
			</div>
		</div>
	</div>
}
