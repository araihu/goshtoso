package components

import (
	rootcomponents "github.com/araihu/goshtoso/components"
	"github.com/araihu/goshtoso/components/structuredinput"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

var structuredInputAPISections = []demo.APISection{
	demo.StructAPI[structuredinput.Config](
		rootcomponents.KindStructuredInput,
		"Config",
		"structuredinput.StructuredInput(cfg Config) Instance",
		"Configures repeatable structured rows whose values are submitted through typed column controls and hidden nested names.",
		[]demo.APIPropDoc{
			{Name: "ID", Default: `"" (omitted)`, Description: "Optional root element ID."},
			{Name: "Name", Default: `"" (names start with [index])`, Description: "Base submitted field name; hidden values use Name[index][columnKey].", Required: true},
			{Name: "Columns", Default: "nil (rows have no controls)", Description: "Ordered typed columns rendered in every repeatable row. Empty keys and later duplicate keys are discarded.", Required: true},
			{Name: "Entries", Default: "nil (starts with no rows)", Description: "Initial repeatable row values keyed by Column.Key. Missing values become empty strings and extra map keys are ignored."},
			{Name: "AddActionLabel", Default: `"Add row"`, Description: "Visible add-row button label."},
			{Name: "Disabled", Default: "false", Description: "Disables visible text/select controls and hides both add-row and remove-row actions; hidden submitted values remain enabled."},
			{Name: "RootClass", Default: `""`, Description: "Appends CSS classes to the structured-input root."},
		},
	),
	demo.StructAPI[structuredinput.Column](
		"",
		"Column",
		"",
		"Describes one typed control repeated across every structured row.",
		[]demo.APIPropDoc{
			{Name: "Key", Default: `"" (column discarded)`, Description: "Stable nested submission key. Empty keys and duplicates after the first are removed.", Required: true},
			{Name: "Label", Default: `""`, Description: "Accessible aria-label for the visible text or select control."},
			{Name: "Type", Default: "ColumnText when empty", Allowed: []string{"ColumnText", "ColumnSelect"}, Description: "ColumnSelect renders a select; every other value, including the zero value, renders a text input."},
			{Name: "Placeholder", Default: `""`, Description: "Text-column placeholder; select columns ignore it."},
			{Name: "Separator", Default: `"" (omitted)`, Description: "Optional visual text rendered after this column, such as = or :; it is aria-hidden and does not change submitted values."},
			{Name: "Options", Default: "nil", Description: "Select-column choices; text columns ignore them."},
			{Name: "Default", Default: `""`, Description: "Value copied into a newly added row. When empty on a select column, the first option value is used; otherwise the new value remains empty."},
		},
	),
	demo.StructAPI[structuredinput.Option](
		"",
		"Option",
		"",
		"Describes one choice for a ColumnSelect column.",
		[]demo.APIPropDoc{
			{Name: "Value", Default: `""`, Description: "Native option value and the value stored in the row.", Required: true},
			{Name: "Label", Default: "Value", Description: "Visible option text; an empty label falls back to Value."},
		},
	),
}

// StructuredInputDemoPage renders the Structured Input component demo.
templ StructuredInputDemoPage() {
	@demo.Layout("Structured Input", "structured-input", structuredInputDemoContent())
}

templ structuredInputDemoContent() {
	<div id="structured-input-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Structured Input",
				Description: "Repeatable rows of structured form inputs for metadata, taints, rules, and similar list-shaped data.",
			},
			structuredInputMetadataPreview(),
			`@structuredinput.StructuredInput(structuredinput.Config{
    ID:   "labels",
    Name: "labels",
    Columns: []structuredinput.Column{
        {Key: "key", Label: "Key", Placeholder: "key", Separator: "="},
        {Key: "value", Label: "Value", Placeholder: "value"},
    },
    Entries: []structuredinput.Entry{
        {"key": "app", "value": "web"},
        {"key": "env", "value": "prod"},
    },
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Select Column",
				Description: "Rows can combine text inputs with select columns for enumerated values like Kubernetes taint effects.",
			},
			structuredInputTaintsPreview(),
			`@structuredinput.StructuredInput(structuredinput.Config{
    ID:   "taints",
    Name: "taints",
    Columns: []structuredinput.Column{
        {Key: "key", Label: "Key", Placeholder: "key", Separator: "="},
        {Key: "value", Label: "Value", Placeholder: "value", Separator: ":"},
        {
            Key: "effect",
            Label: "Effect",
            Type: structuredinput.ColumnSelect,
            Options: []structuredinput.Option{
                {Value: "NoSchedule", Label: "NoSchedule"},
                {Value: "PreferNoSchedule", Label: "PreferNoSchedule"},
                {Value: "NoExecute", Label: "NoExecute"},
            },
        },
    },
    Entries: []structuredinput.Entry{
        {"key": "node-role.kubernetes.io/control-plane", "value": "true", "effect": "NoSchedule"},
    },
    AddActionLabel: "Add taint",
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Empty Starter",
				Description: "With no entries the list starts empty and adds rows from the configured column defaults.",
			},
			structuredInputEmptyPreview(),
			`@structuredinput.StructuredInput(structuredinput.Config{
    ID:   "rules",
    Name: "rules",
    Columns: []structuredinput.Column{
        {Key: "name", Label: "Name", Placeholder: "rule name"},
        {Key: "condition", Label: "Condition", Placeholder: "condition"},
        {
            Key: "priority",
            Label: "Priority",
            Type: structuredinput.ColumnSelect,
            Options: []structuredinput.Option{
                {Value: "high", Label: "High"},
                {Value: "medium", Label: "Medium"},
                {Value: "low", Label: "Low"},
            },
        },
    },
    AddActionLabel: "Add rule",
})`,
		)
	</div>
	@demo.StructuredAPIReference(structuredInputAPISections)
}

templ structuredInputMetadataPreview() {
	<div id="structured-input-metadata" class="w-full max-w-lg mx-auto">
		@structuredinput.StructuredInput(structuredinput.Config{
			ID:   "labelsDemo",
			Name: "labels",
			Columns: []structuredinput.Column{
				{Key: "key", Label: "Key", Placeholder: "key", Separator: "="},
				{Key: "value", Label: "Value", Placeholder: "value"},
			},
			Entries: []structuredinput.Entry{
				{"key": "app", "value": "web"},
				{"key": "env", "value": "prod"},
			},
		})
	</div>
}

templ structuredInputTaintsPreview() {
	<div id="structured-input-taints" class="w-full max-w-2xl mx-auto">
		@structuredinput.StructuredInput(structuredinput.Config{
			ID:   "taintsDemo",
			Name: "taints",
			Columns: []structuredinput.Column{
				{Key: "key", Label: "Key", Placeholder: "key (e.g. node-role.kubernetes.io/control-plane)", Separator: "="},
				{Key: "value", Label: "Value", Placeholder: "value (e.g. true)", Separator: ":"},
				{
					Key:   "effect",
					Label: "Effect",
					Type:  structuredinput.ColumnSelect,
					Options: []structuredinput.Option{
						{Value: "NoSchedule", Label: "NoSchedule"},
						{Value: "PreferNoSchedule", Label: "PreferNoSchedule"},
						{Value: "NoExecute", Label: "NoExecute"},
					},
				},
			},
			Entries: []structuredinput.Entry{
				{"key": "node-role.kubernetes.io/control-plane", "value": "true", "effect": "NoSchedule"},
			},
			AddActionLabel: "Add taint",
		})
	</div>
}

templ structuredInputEmptyPreview() {
	<div id="structured-input-empty" class="w-full max-w-2xl mx-auto">
		@structuredinput.StructuredInput(structuredinput.Config{
			ID:   "rulesDemo",
			Name: "rules",
			Columns: []structuredinput.Column{
				{Key: "name", Label: "Name", Placeholder: "rule name"},
				{Key: "condition", Label: "Condition", Placeholder: "condition"},
				{
					Key:   "priority",
					Label: "Priority",
					Type:  structuredinput.ColumnSelect,
					Options: []structuredinput.Option{
						{Value: "high", Label: "High"},
						{Value: "medium", Label: "Medium"},
						{Value: "low", Label: "Low"},
					},
				},
			},
			AddActionLabel: "Add rule",
		})
	</div>
}
