package components

import "github.com/araihu/goshtoso/site/internal/pages/demo"

templ AttributionsPage() {
	@demo.Layout("Attributions", "attributions", attributionsContent())
}

// attribution is one credited dependency rendered as a table row.
type attribution struct {
	Name    string
	Href    string
	License string
	Note    string
}

templ attributionsContent() {
	<div class="space-y-10">
		<div>
			<h1 class="text-3xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">Attributions</h1>
			<p class="mt-2 text-on-surface dark:text-on-surface-dark">
				Goshtoso stands on the shoulders of excellent open-source work. It is a hard fork of
				<a href="https://www.penguinui.com" target="_blank" rel="noopener" class="text-primary dark:text-primary-dark underline underline-offset-2">PenguinUI</a>,
				re-implemented with Go's templating system. The projects below are bundled or depended
				upon at build or runtime; each is used under its own license, and the original copyright
				and license texts are retained.
			</p>
		</div>

		@attrSection("Design & components", "The design system and component set Goshtoso draws from.", []attribution{
			{Name: "PenguinUI", Href: "https://www.penguinui.com", License: "Source", Note: "Design system Goshtoso is based on; reinterpreted in Go templ"},
			{Name: "Heroicons", Href: "https://heroicons.com", License: "MIT", Note: "Bundled sprite at /assets/icons/heroicons.svg; retained notice at /assets/icons/HEROICONS_LICENSE.txt"},
			{Name: "Bootstrap Icons", Href: "https://icons.getbootstrap.com", License: "MIT", Note: "Some icons sourced from this set"},
		})

		@attrSection("Runtime libraries (bundled)", "Shipped locally under assets/ — no CDN at runtime.", []attribution{
			{Name: "Tailwind CSS", Href: "https://tailwindcss.com", License: "MIT", Note: "Utility-first styling (v4)"},
			{Name: "Alpine.js", Href: "https://alpinejs.dev", License: "MIT", Note: "Reactive UI (v3)"},
			{Name: "@alpinejs/collapse", Href: "https://alpinejs.dev/plugins/collapse", License: "MIT", Note: "Collapse plugin (accordion)"},
			{Name: "@alpinejs/focus", Href: "https://alpinejs.dev/plugins/focus", License: "MIT", Note: "Focus-trap plugin (modal)"},
			{Name: "htmx", Href: "https://htmx.org", License: "Zero-Clause BSD", Note: "Dynamic content loading (v2)"},
			{Name: "htmx SSE extension", Href: "https://htmx.org/extensions/sse/", License: "Zero-Clause BSD", Note: "Server-sent events (log feed example)"},
			{Name: "htmx WebSocket extension", Href: "https://htmx.org/extensions/ws/", License: "Zero-Clause BSD", Note: "WebSockets (chat example)"},
		})

		@attrSection("Go modules", "Direct dependencies from go.mod.", []attribution{
			{Name: "a-h/templ", Href: "https://github.com/a-h/templ", License: "MIT", Note: "HTML template generation (.templ → .go)"},
			{Name: "alecthomas/chroma", Href: "https://github.com/alecthomas/chroma", License: "MIT", Note: "Syntax highlighting (code blocks)"},
			{Name: "coder/websocket", Href: "https://github.com/coder/websocket", License: "ISC", Note: "WebSocket server (chat example)"},
			{Name: "playwright-community/playwright-go", Href: "https://github.com/playwright-community/playwright-go", License: "MIT", Note: "E2E testing (dev only)"},
			{Name: "stretchr/testify", Href: "https://github.com/stretchr/testify", License: "MIT", Note: "Test assertions (dev only)"},
		})

		<div class="pb-8">
			<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
				Spotted a missing credit or licensing issue? Open an issue at
				<a href="https://github.com/araihu/goshtoso" target="_blank" rel="noopener" class="text-primary dark:text-primary-dark underline underline-offset-2">github.com/araihu/goshtoso</a>.
			</p>
		</div>
	</div>
}

templ attrSection(title, subtitle string, rows []attribution) {
	<div>
		<h2 data-toc-heading={ title } class="text-xl font-bold font-title text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2>
		<p class="mt-1 mb-4 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ subtitle }</p>
		<div class="overflow-x-auto rounded-radius border border-outline dark:border-outline-dark">
			<table class="w-full text-left text-sm text-on-surface dark:text-on-surface-dark">
				<thead class="border-b border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt">
					<tr>
						<th class="px-4 py-2.5 font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Project</th>
						<th class="px-4 py-2.5 font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">License</th>
						<th class="px-4 py-2.5 font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Used for</th>
					</tr>
				</thead>
				<tbody>
					for _, a := range rows {
						<tr class="border-b border-outline last:border-0 dark:border-outline-dark">
							<td class="px-4 py-2.5 align-top">
								<a href={ templ.SafeURL(a.Href) } target="_blank" rel="noopener" class="font-medium text-primary dark:text-primary-dark underline underline-offset-2">{ a.Name }</a>
							</td>
							<td class="px-4 py-2.5 align-top whitespace-nowrap">
								<span class="inline-block rounded-radius bg-surface-alt px-2 py-0.5 font-mono text-xs dark:bg-surface-dark-alt">{ a.License }</span>
							</td>
							<td class="px-4 py-2.5 align-top text-on-surface-muted dark:text-on-surface-dark-muted">{ a.Note }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
