}

// textareaDisabledPreview renders the disabled textarea.
templ textareaDisabledPreview() {
	<div id="textarea-disabled" class="w-full max-w-md mx-auto">
		@textarea.Textarea(textarea.Config{
			ID:          "demo-disabled",
