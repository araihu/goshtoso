package components

import (
	"github.com/araihu/goshtoso/components/alert"
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/breadcrumbs"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/navbar"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/steps"
	"github.com/araihu/goshtoso/components/table"
	"github.com/araihu/goshtoso/components/tabs"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

type applicationPatternComponent struct {
	Name string
	Href string
	Role string
}

type applicationPatternContract struct {
	Problem       string
	Components    []applicationPatternComponent
	States        []string
	Mobile        string
	Desktop       string
	Accessibility []string
	AppSpecific   []string
	SourceMap     string
	Done          []string
}

templ ApplicationPatternsPage() {
	@demo.Layout("Application Patterns", "application-patterns", applicationPatternsContent())
}

templ applicationPatternsContent() {
	<div id="application-patterns-fragment" class="mx-auto max-w-6xl">
		<header class="max-w-4xl space-y-4 pb-10">
			<p class="text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">Application recipes</p>
			<h1 class="font-title text-3xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong sm:text-4xl">Compose product surfaces, not component piles</h1>
			<p class="max-w-3xl text-lg leading-relaxed text-on-surface dark:text-on-surface-dark">
				Four server-rendered recipes show how Goshtoso components become durable application structure. Each recipe separates reusable UI from the routing, policy, queries, and domain state that belong to your app.
			</p>
		</header>
		<nav aria-label="Application recipe index" class="grid border-y border-outline dark:border-outline-dark sm:grid-cols-2 lg:grid-cols-4">
			@applicationPatternIndexLink("01", "App Shell", "#app-shell")
			@applicationPatternIndexLink("02", "Operations List", "#operations-list")
			@applicationPatternIndexLink("03", "Detail Workspace", "#detail-workspace")
			@applicationPatternIndexLink("04", "Multi-step Workflow", "#multi-step-workflow")
		</nav>
		<div class="divide-y divide-outline dark:divide-outline-dark">
			@applicationPatternSection("01", "app-shell", "App Shell", "Give every task a stable place to start.", applicationPatternAppShellPreview(), applicationPatternAppShellContract())
			@applicationPatternSection("02", "operations-list", "Operations List", "Help operators scan, narrow, select, and act without losing context.", operationsListPreview(), operationsListContract())
			@applicationPatternSection("03", "detail-workspace", "Detail Workspace", "Keep identity, status, actions, and deeper context in one navigable workspace.", detailWorkspacePreview(), detailWorkspaceContract())
			@applicationPatternSection("04", "multi-step-workflow", "Multi-step Workflow", "Make progress, validation, review, and recovery explicit.", multiStepWorkflowPreview(), multiStepWorkflowContract())
		</div>
		@fieldProvenApplicationPatterns()
	</div>
}

templ fieldProvenApplicationPatterns() {
	<section class="border-t border-outline py-14 dark:border-outline-dark sm:py-20" aria-labelledby="field-proven-title">
		<div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.7fr)]">
			<header class="space-y-3">
				<p class="text-sm font-semibold uppercase tracking-wide text-primary dark:text-primary-dark">Field-proven extensions</p>
				<h2 id="field-proven-title" data-toc-heading class="font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Patterns recovered from independent apps</h2>
				<p class="text-on-surface dark:text-on-surface-dark">Three blind consumer builds pushed the four base recipes into finance, warehouse, and editorial work. Reuse the decision structure; keep the domain voice.</p>
			</header>
			<div class="divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark">
				@fieldProvenPattern("Decision Queue", "Operations List + Detail Workspace", "Keep the queue, selected record, risk or policy context, decision form, and audit history visible together. Stack the selected record after the queue at 390 px.")
				@fieldProvenPattern("Interruption-safe Workflow", "Multi-step Workflow + bounded draft", "Default the common case, edit exceptions only, review exact changes, preserve a short-lived draft, and make retries idempotent. Sticky actions must not cover focused fields.")
				@fieldProvenPattern("Content-first Review", "Queue + reading surface + decision rail", "Let typography and rhythm belong to the publication. Keep author, deadline, channel, status, and handoff note next to the decision instead of converting prose into dashboard cards.")
			</div>
		</div>
	</section>
}

templ fieldProvenPattern(title, composition, guidance string) {
	<article data-field-proven-pattern class="grid gap-3 py-6 sm:grid-cols-[12rem_minmax(0,1fr)]">
		<div>
			<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h3>
			<p class="mt-1 text-xs font-medium uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">{ composition }</p>
		</div>
		<p class="text-sm leading-6 text-on-surface dark:text-on-surface-dark">{ guidance }</p>
	</article>
}

templ applicationPatternIndexLink(number, label, href string) {
	<a href={ templ.SafeURL(href) } class="group flex items-baseline gap-3 px-4 py-4 transition-colors hover:bg-surface-alt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:hover:bg-surface-dark-alt dark:focus-visible:outline-primary-dark lg:border-r lg:border-outline lg:last:border-r-0 lg:dark:border-outline-dark">
		<span class="font-mono text-xs text-on-surface-muted dark:text-on-surface-dark-muted">{ number }</span>
		<span class="font-semibold text-on-surface-strong group-hover:text-primary dark:text-on-surface-dark-strong dark:group-hover:text-primary-dark">{ label }</span>
	</a>
}

templ applicationPatternSection(number, id, title, description string, preview templ.Component, contract applicationPatternContract) {
	<section data-application-pattern={ id } class="py-14 sm:py-20">
		<header class="mb-8 grid gap-3 sm:grid-cols-[3rem_minmax(0,1fr)] sm:items-start">
			<p class="font-mono text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ number }</p>
			<div class="space-y-2">
				<h2 id={ id } data-toc-heading class="scroll-mt-20 font-title text-2xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">{ title }</h2>
				<p class="max-w-2xl text-on-surface dark:text-on-surface-dark">{ description }</p>
			</div>
		</header>
		<div data-pattern-preview class="overflow-hidden rounded-radius border border-outline bg-surface-alt dark:border-outline-dark dark:bg-surface-dark-alt">
			@preview
		</div>
		@applicationPatternContractDetails(contract)
	</section>
}

templ applicationPatternContractDetails(contract applicationPatternContract) {
	<div class="mt-8 border-y border-outline dark:border-outline-dark">
		<div data-pattern-problem class="grid gap-2 py-6 md:grid-cols-[11rem_minmax(0,1fr)]">
			<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Problem</h3>
			<p class="max-w-3xl text-on-surface dark:text-on-surface-dark">{ contract.Problem }</p>
		</div>
		<div class="grid border-t border-outline dark:border-outline-dark lg:grid-cols-2 lg:divide-x lg:divide-outline lg:dark:divide-outline-dark">
			<div class="space-y-7 py-7 lg:pr-8">
				<div data-pattern-components class="space-y-3">
					<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Goshtoso components</h3>
					<ul class="space-y-2">
						for _, component := range contract.Components {
							<li class="grid gap-1 sm:grid-cols-[9rem_minmax(0,1fr)]">
								<a href={ templ.SafeURL(component.Href) } class="font-mono text-sm text-primary underline underline-offset-2 dark:text-primary-dark">{ component.Name }</a>
								<span class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">{ component.Role }</span>
							</li>
						}
					</ul>
				</div>
				<div data-pattern-states class="space-y-3">
					<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">States to design</h3>
					@applicationPatternList(contract.States)
				</div>
				<div data-pattern-app-specific class="space-y-3">
					<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">What stays app-specific</h3>
					@applicationPatternList(contract.AppSpecific)
				</div>
			</div>
			<div class="space-y-7 border-t border-outline py-7 dark:border-outline-dark lg:border-t-0 lg:pl-8">
				<div class="grid gap-5 sm:grid-cols-2">
					<div data-pattern-390 class="space-y-2">
						<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">At 390 px</h3>
						<p class="text-sm text-on-surface dark:text-on-surface-dark">{ contract.Mobile }</p>
					</div>
					<div data-pattern-1440 class="space-y-2">
						<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">At 1440 px</h3>
						<p class="text-sm text-on-surface dark:text-on-surface-dark">{ contract.Desktop }</p>
					</div>
				</div>
				<div data-pattern-accessibility class="space-y-3">
					<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Accessibility</h3>
					@applicationPatternList(contract.Accessibility)
				</div>
				<div data-pattern-done class="space-y-3">
					<h3 class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Done when</h3>
					<ul class="space-y-2">
						for _, item := range contract.Done {
							<li class="flex gap-2 text-sm text-on-surface dark:text-on-surface-dark">
								<svg class="mt-0.5 size-4 shrink-0 text-success" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d="M16.704 5.292a1 1 0 0 1 .004 1.416l-7.25 7.292a1 1 0 0 1-1.42.002l-3.75-3.75a1 1 0 1 1 1.414-1.414l3.04 3.039 6.542-6.58a1 1 0 0 1 1.42-.005Z" clip-rule="evenodd"></path>
								</svg>
								<span>{ item }</span>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>
		<div data-pattern-source-map class="border-t border-outline py-7 dark:border-outline-dark">
			@codeblock.CodeBlock(codeblock.Config{
				Language: "text",
				Label:    "Source map",
				Code:     contract.SourceMap,
			})
		</div>
	</div>
}

templ applicationPatternList(items []string) {
	<ul class="list-disc space-y-2 pl-5 text-sm text-on-surface dark:text-on-surface-dark">
		for _, item := range items {
			<li>{ item }</li>
		}
	</ul>
}

templ applicationPatternAppShellPreview() {
	<div id="app-shell-preview" class="bg-surface dark:bg-surface-dark">
		@navbar.Navbar(navbar.Config{
			Brand: applicationPatternAppShellBrand(),
			Links: []navbar.NavLink{
				{Label: "Operations", Href: "#app-shell", Active: true},
				{Label: "Runbooks", Href: "#app-shell"},
			},
			Actions: []navbar.ActionItem{
				{Content: applicationPatternAppShellCreateAction(), Position: navbar.ActionRight},
			},
			User: &navbar.UserProfile{Name: "Sam Rivera", Email: "sam@example.com"},
			UserMenu: []navbar.UserMenuItem{
				{Label: "Profile", Href: "#app-shell"},
				{Label: "Sign out", Href: "#app-shell", Danger: true},
			},
			NavClass: "bg-surface dark:bg-surface-dark",
		})
		<div class="flex min-h-[25rem]">
			<div id="app-shell-desktop-sidebar" class="hidden w-60 shrink-0 md:block">
				@sidebar.Sidebar(sidebar.Config{
					RootClass: "h-full",
					Sections: []sidebar.Section{
						{
							Title: "Workspace",
							Items: []sidebar.Item{
								{ID: "overview", Label: "Overview", Href: "#app-shell", Active: true},
								{ID: "deployments", Label: "Deployments", Href: "#app-shell", Badge: "3"},
								{ID: "services", Label: "Services", Href: "#app-shell"},
							},
						},
						{
							Title: "System",
							Items: []sidebar.Item{
								{ID: "audit-log", Label: "Audit log", Href: "#app-shell"},
								{ID: "settings", Label: "Settings", Href: "#app-shell"},
							},
						},
					},
				})
			</div>
			<main class="min-w-0 flex-1 p-4 sm:p-6" aria-label="App shell preview content">
				<div class="flex flex-col gap-4 border-b border-outline pb-5 dark:border-outline-dark sm:flex-row sm:items-start sm:justify-between">
					<div>
						<p class="text-xs font-medium uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Production workspace</p>
						<h3 class="mt-1 font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Operations overview</h3>
						<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Monitor the release train and respond to active changes.</p>
					</div>
					@badge.Badge(badge.Config{Label: "All systems nominal", Tone: badge.ToneSuccess, Appearance: badge.AppearanceSoft, Size: badge.SizeSM, Indicator: true})
				</div>
				<div class="grid gap-6 py-6 lg:grid-cols-[minmax(0,1fr)_15rem]">
					<section aria-labelledby="shell-priority-title">
						<h4 id="shell-priority-title" class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Needs attention</h4>
						<div class="mt-3 divide-y divide-outline border-y border-outline dark:divide-outline-dark dark:border-outline-dark">
							@applicationPatternAppShellTask("payments-api", "Ready for approval", badge.ToneWarning)
							@applicationPatternAppShellTask("identity-worker", "Deploying", badge.ToneInfo)
							@applicationPatternAppShellTask("docs-site", "Healthy", badge.ToneSuccess)
						</div>
					</section>
					<aside class="border-t border-outline pt-5 dark:border-outline-dark lg:border-l lg:border-t-0 lg:pl-5 lg:pt-0" aria-label="App shell preview context">
						<p class="text-xs font-medium uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Current shift</p>
						<p class="mt-2 font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Platform team</p>
						<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">7 services, 2 active changes, no open incidents.</p>
					</aside>
				</div>
			</main>
		</div>
	</div>
}

templ applicationPatternAppShellBrand() {
	<span class="font-title font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Northstar</span>
}

templ applicationPatternAppShellCreateAction() {
	@button.Button(button.WithSize(button.SizeSmall), button.WithRootClass("hidden sm:inline-flex")) {
		New change
	}
}

templ applicationPatternAppShellTask(name, state string, tone badge.Tone) {
	<div class="flex items-center justify-between gap-3 py-3">
		<div class="min-w-0">
			<p class="truncate font-mono text-sm text-on-surface-strong dark:text-on-surface-dark-strong">{ name }</p>
			<p class="mt-0.5 text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Updated moments ago</p>
		</div>
		@badge.Badge(badge.Config{Label: state, Tone: tone, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
	</div>
}

templ operationsListPreview() {
	<div id="operations-list-preview" class="space-y-5 bg-surface p-4 dark:bg-surface-dark sm:p-6">
		<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<p class="text-xs font-medium uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Release control</p>
				<h3 class="mt-1 font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Deployments</h3>
				<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Three changes need review before the next window closes.</p>
			</div>
			<div class="flex items-center gap-2">
				@badge.Badge(badge.Config{Label: "3 awaiting review", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
				@button.Button(button.WithSize(button.SizeSmall)) {
					Create deployment
				}
			</div>
		</div>
		<div class="grid gap-3 border-y border-outline py-4 dark:border-outline-dark md:grid-cols-[minmax(0,1fr)_12rem_auto]">
			@textinput.TextInput(textinput.Config{
				ID:          "operations-list-search",
				Name:        "search",
				Label:       "Search deployments",
				Placeholder: "Service, owner, or release",
				Type:        textinput.TypeSearch,
			})
			@selectfield.Select(selectfield.Config{
				ID:    "operations-list-environment",
				Name:  "environment",
				Label: "Environment",
				Options: []selectfield.Option{
					{Value: "all", Label: "All", Selected: true},
					{Value: "production", Label: "Production"},
					{Value: "staging", Label: "Staging"},
				},
			})
			<div class="flex items-end">
				@button.Button(button.WithTone(button.ToneAlternate), button.WithSize(button.SizeSmall), button.WithRootClass("w-full md:w-auto")) {
					Clear filters
				}
			</div>
		</div>
		<div class="overflow-x-auto">
			<div class="min-w-[48rem]">
				@table.Table(table.Config{
					ID:           "operations-pattern-table",
					Caption:      "Deployments awaiting operational review",
					ShowCheckbox: true,
					Columns: []table.Column{
						{Key: "service", Label: "Service", Width: "min-w-48"},
						{Key: "release", Label: "Release", Width: "min-w-28"},
						{Key: "environment", Label: "Environment", Width: "min-w-32"},
						{Key: "status", Label: "Status", Width: "min-w-36"},
						{Key: "owner", Label: "Owner", Width: "min-w-32"},
					},
					Rows: operationsPatternRows(),
				})
			</div>
		</div>
		<p class="text-xs text-on-surface-muted dark:text-on-surface-dark-muted">Showing 3 of 18 deployments. Selection remains stable while filters update from the server.</p>
	</div>
}

func operationsPatternRows() []table.Row {
	return []table.Row{
		{
			ID: "deployment-payments",
			Cells: map[string]table.Cell{
				"service":     {Text: "payments-api", Description: "Critical path"},
				"release":     {Text: "v2.18.0", Code: true},
				"environment": {Text: "Production"},
				"status":      {Component: badge.Badge(badge.Config{Label: "Awaiting approval", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})},
				"owner":       {Text: "Lena Ortiz"},
			},
			Actions: operationsRowAction("Review"),
		},
		{
			ID: "deployment-identity",
			Cells: map[string]table.Cell{
				"service":     {Text: "identity-worker", Description: "Background service"},
				"release":     {Text: "v4.3.1", Code: true},
				"environment": {Text: "Production"},
				"status":      {Component: badge.Badge(badge.Config{Label: "Deploying", Tone: badge.ToneInfo, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})},
				"owner":       {Text: "Maya Chen"},
			},
			Actions: operationsRowAction("Open"),
		},
		{
			ID: "deployment-docs",
			Cells: map[string]table.Cell{
				"service":     {Text: "docs-site", Description: "Public edge"},
				"release":     {Text: "v1.42.2", Code: true},
				"environment": {Text: "Staging"},
				"status":      {Component: badge.Badge(badge.Config{Label: "Ready", Tone: badge.ToneSuccess, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})},
				"owner":       {Text: "Sam Rivera"},
			},
			Actions: operationsRowAction("Review"),
		},
	}
}

templ operationsRowAction(label string) {
	@button.Button(button.WithTone(button.ToneAlternate), button.WithSize(button.SizeSmall)) {
		{ label }
	}
}

templ detailWorkspacePreview() {
	<div id="detail-workspace-preview" class="space-y-5 bg-surface p-4 dark:bg-surface-dark sm:p-6">
		@breadcrumbs.Breadcrumbs(breadcrumbs.Config{
			Items: []breadcrumbs.Item{
				{Label: "Deployments", Href: "#detail-workspace"},
				{Label: "payments-api", Href: "#detail-workspace"},
			},
			Current: "v2.18.0",
		})
		<div class="flex flex-col gap-4 border-b border-outline pb-5 dark:border-outline-dark md:flex-row md:items-start md:justify-between">
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					<h3 class="font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">payments-api v2.18.0</h3>
					@badge.Badge(badge.Config{Label: "Awaiting approval", Tone: badge.ToneWarning, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})
				</div>
				<p class="mt-2 max-w-2xl text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Production rollout with a guarded database migration and automatic rollback threshold.</p>
			</div>
			<div class="flex gap-2">
				@button.Button(button.WithTone(button.ToneAlternate), button.WithSize(button.SizeSmall)) {
					Reject
				}
				@button.Button(button.WithSize(button.SizeSmall)) {
					Approve
				}
			</div>
		</div>
		<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_16rem]">
			@tabs.Tabs(tabs.Config{
				ID:         "application-pattern-detail-tabs",
				DefaultTab: "overview",
				Tabs: []tabs.Tab{
					{ID: "overview", Label: "Overview", Content: detailOverviewPanel()},
					{ID: "changes", Label: "Changes", Badge: "12", Content: detailChangesPanel()},
					{ID: "activity", Label: "Activity", Badge: "8", Content: detailActivityPanel()},
				},
			})
			<aside class="border-t border-outline pt-5 dark:border-outline-dark xl:border-l xl:border-t-0 xl:pl-5 xl:pt-0" aria-labelledby="detail-context-title">
				<h4 id="detail-context-title" class="font-semibold text-on-surface-strong dark:text-on-surface-dark-strong">Release context</h4>
				<dl class="mt-4 space-y-4 text-sm">
					<div>
						<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Environment</dt>
						<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Production</dd>
					</div>
					<div>
						<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Owner</dt>
						<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Lena Ortiz</dd>
					</div>
					<div>
						<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Window closes</dt>
						<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">18:30 UTC</dd>
					</div>
				</dl>
			</aside>
		</div>
	</div>
}

templ detailOverviewPanel() {
	<div class="space-y-5">
		@alert.Alert(alert.Config{
			Title:       "Approval is required",
			Description: "The migration changes a production table. Review the rollback signal before approving.",
			Tone:        alert.ToneWarning,
		})
		<dl class="grid gap-4 sm:grid-cols-2">
			<div class="border-b border-outline pb-3 dark:border-outline-dark">
				<dt class="text-xs uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Strategy</dt>
				<dd class="mt-1 text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">10% canary, then progressive rollout</dd>
			</div>
			<div class="border-b border-outline pb-3 dark:border-outline-dark">
				<dt class="text-xs uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Rollback signal</dt>
				<dd class="mt-1 text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Error rate above 1.5%</dd>
			</div>
		</dl>
	</div>
}

templ detailChangesPanel() {
	<div class="space-y-3">
		<p class="text-sm text-on-surface dark:text-on-surface-dark">Twelve reviewed changes are included in this release.</p>
		<ul class="list-disc space-y-2 pl-5 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			<li>Add idempotency keys to capture requests.</li>
			<li>Backfill the settlement ledger in batches.</li>
			<li>Remove the deprecated retry flag.</li>
		</ul>
	</div>
}

templ detailActivityPanel() {
	<ol class="space-y-3 text-sm text-on-surface dark:text-on-surface-dark">
		<li><span class="font-medium">Sam</span> completed the security review.</li>
		<li><span class="font-medium">Lena</span> attached the rollback runbook.</li>
		<li><span class="font-medium">Automation</span> passed all preflight checks.</li>
	</ol>
}

templ multiStepWorkflowPreview() {
	<div id="multi-step-workflow-preview" class="bg-surface p-4 dark:bg-surface-dark sm:p-6">
		<div class="grid gap-7 lg:grid-cols-[12rem_minmax(0,1fr)]">
			<div id="workflow-steps-mobile" class="lg:hidden">
				@steps.Steps(steps.Config{
					ID:          "application-pattern-workflow-mobile",
					Orientation: steps.OrientationVertical,
					ShowLabels:  true,
					AriaLabel:   "Deployment workflow progress",
					LiveRegion:  true,
					Steps: []steps.Step{
						{Label: "Basics", Status: steps.StatusCompleted},
						{Label: "Targets", Status: steps.StatusCurrent},
						{Label: "Review", Status: steps.StatusUpcoming},
					},
				})
			</div>
			<div id="workflow-steps-desktop" class="hidden lg:block">
				@steps.Steps(steps.Config{
					ID:          "application-pattern-workflow-desktop",
					Orientation: steps.OrientationVertical,
					ShowLabels:  true,
					AriaLabel:   "Deployment workflow progress",
					LiveRegion:  true,
					Steps: []steps.Step{
						{Label: "Basics", Status: steps.StatusCompleted},
						{Label: "Targets", Status: steps.StatusCurrent},
						{Label: "Review", Status: steps.StatusUpcoming},
					},
				})
			</div>
			<form class="min-w-0 space-y-6" aria-labelledby="workflow-form-title">
				<div class="border-b border-outline pb-4 dark:border-outline-dark">
					<p class="text-xs font-medium uppercase tracking-wide text-on-surface-muted dark:text-on-surface-dark-muted">Step 2 of 3</p>
					<h3 id="workflow-form-title" class="mt-1 font-title text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Choose deployment targets</h3>
					<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Select where this release can run and define the rollout limit.</p>
				</div>
				@alert.Alert(alert.Config{
					Title:       "Draft saved",
					Description: "You can leave this workflow and continue from the same step.",
					Tone:        alert.ToneInfo,
				})
				<div class="grid gap-4 md:grid-cols-2">
					@selectfield.Select(selectfield.Config{
						ID:    "workflow-environment",
						Name:  "environment",
						Label: "Environment",
						Options: []selectfield.Option{
							{Value: "production", Label: "Production", Selected: true},
							{Value: "staging", Label: "Staging"},
						},
					})
					@textinput.TextInput(textinput.Config{
						ID:         "workflow-percentage",
						Name:       "percentage",
						Label:      "Initial traffic percentage",
						Type:       textinput.TypeNumber,
						Value:      "10",
						HelperText: "Start between 1 and 25 percent.",
						Required:   true,
					})
				</div>
				@checkbox.Checkbox(checkbox.Config{
					ID:           "workflow-auto-rollback",
					Name:         "auto_rollback",
					Label:        "Enable automatic rollback",
					Checked:      true,
					HelperText:   "Stop the rollout when the error threshold is crossed.",
					HelperTextID: "workflow-auto-rollback-help",
					Container:    true,
				})
				<div class="flex flex-col-reverse gap-2 border-t border-outline pt-5 dark:border-outline-dark sm:flex-row sm:justify-between">
					@button.Button(button.WithTone(button.ToneAlternate), button.WithRootClass("w-full sm:w-auto")) {
						Back
					}
					@button.Button(button.WithType("submit"), button.WithRootClass("w-full sm:w-auto")) {
						Continue to review
					}
				</div>
			</form>
		</div>
	</div>
}

func applicationPatternAppShellContract() applicationPatternContract {
	return applicationPatternContract{
		Problem: "Repeated page chrome drifts quickly. The shell must own global navigation, responsive positioning, identity, and page framing while each route supplies only its task content.",
		Components: []applicationPatternComponent{
			{Name: "Navbar", Href: "/components/navbar", Role: "Global brand, primary navigation, account menu, and compact actions."},
			{Name: "Sidebar", Href: "/components/sidebar", Role: "Persistent desktop navigation and current-route orientation."},
			{Name: "Button", Href: "/components/button", Role: "One decisive global action with familiar states."},
			{Name: "Badge", Href: "/components/badge", Role: "Compact environment and system-state signals."},
		},
		States: []string{
			"Known route with one active navigation item.",
			"Mobile navigation open and closed.",
			"Account menu open, signed-out state, and restricted actions.",
			"Slow or failed route content without losing the shell.",
		},
		Mobile:  "Keep the navbar and page title. Replace the persistent sidebar with the Navbar mobile menu or Sidebar Overlay. Stack page actions below identity and preserve one page scrollbar.",
		Desktop: "Hold the navbar at the top, reserve a stable sidebar column, and let the task region grow. Secondary context may use a right rail when it does not compete with the primary task.",
		Accessibility: []string{
			"Name header, navigation, main, and complementary landmarks.",
			"Expose the current route with aria-current and keep focus visible after navigation.",
			"Return focus to the mobile navigation trigger after dismissal.",
		},
		AppSpecific: []string{
			"Route tree, authorization, workspace selection, and account actions.",
			"Which content is global, route-scoped, streamed, or cached.",
			"Breakpoints driven by the app's real labels and navigation depth.",
		},
		SourceMap: `components/navbar        -> global navigation and account actions
components/sidebar       -> desktop navigation and mobile overlay
components/button        -> shell-level primary action
components/badge         -> environment and health signals
app/ui/shell.templ       -> responsive composition and landmarks
app/navigation.go        -> routes, labels, permissions, active state`,
		Done: []string{
			"Direct navigation and fragment navigation produce the same active state.",
			"At 390 px, no persistent sidebar or second page scrollbar remains.",
			"At 1440 px, the content region does not jump between routes.",
			"Keyboard users can open, traverse, and close every global control.",
		},
	}
}

func operationsListContract() applicationPatternContract {
	return applicationPatternContract{
		Problem: "Operational lists fail when filters, selection, status, and row actions are designed separately. Compose them as one server-backed task with explicit query and selection ownership.",
		Components: []applicationPatternComponent{
			{Name: "Table", Href: "/components/table", Role: "Rows, accessible caption, selection, sorting, pagination, and HTMX updates."},
			{Name: "Text Input", Href: "/components/text-input", Role: "Search with a persistent label and server query value."},
			{Name: "Select", Href: "/components/select", Role: "Bounded filters with a visible current value."},
			{Name: "Badge", Href: "/components/badge", Role: "Text-backed semantic status in dense rows."},
			{Name: "Button", Href: "/components/button", Role: "Create, clear, review, and bulk actions."},
		},
		States: []string{
			"Initial, filtered, sorted, selected, and paginated results.",
			"Skeleton loading, empty results, query error, and stale result recovery.",
			"Zero, one, and many selected rows with valid bulk actions.",
			"Row action pending, completed, and rejected by the server.",
		},
		Mobile:  "Stack the title, count, and primary action. Put filters in a single column, keep the table horizontally scrollable, and preserve the identifying column before secondary metadata.",
		Desktop: "Keep the toolbar on one scan line when labels fit. Use the full width for the table, align status and actions predictably, and paginate in the same content region.",
		Accessibility: []string{
			"Provide a specific table caption and labels for every filter.",
			"Do not encode status by color alone. Keep visible text in every Badge.",
			"Announce result-count changes and preserve focus when HTMX swaps rows.",
		},
		AppSpecific: []string{
			"Query grammar, filter defaults, column priority, and row permissions.",
			"Selection persistence across pages and safety rules for bulk actions.",
			"HTMX endpoints, optimistic behavior, audit logging, and export jobs.",
		},
		SourceMap: `components/table         -> row structure, selection, sorting, pagination
components/textinput     -> search query
components/select        -> bounded filters
components/badge         -> row status
components/button        -> create, row, and bulk actions
app/deployments/query.go -> filter parsing and result counts
app/deployments/list.templ -> toolbar, columns, empty and error states`,
		Done: []string{
			"Search, filters, sorting, and pagination round-trip through canonical URLs.",
			"Selection remains understandable after a server-rendered row swap.",
			"Empty, loading, error, and permission states are as usable as the populated list.",
			"The 390 px path preserves identity, action labels, and keyboard reachability.",
		},
	}
}

func detailWorkspaceContract() applicationPatternContract {
	return applicationPatternContract{
		Problem: "A detail route must answer what this is, what state it is in, what can happen next, and where deeper evidence lives without forcing users through separate pages.",
		Components: []applicationPatternComponent{
			{Name: "Breadcrumbs", Href: "/components/breadcrumbs", Role: "Hierarchy and a reliable path back to the parent list."},
			{Name: "Tabs", Href: "/components/tabs", Role: "Keyboardable views of overview, changes, and activity."},
			{Name: "Badge", Href: "/components/badge", Role: "Current lifecycle state next to the resource identity."},
			{Name: "Alert", Href: "/components/alert", Role: "Decision-critical context before the primary action."},
			{Name: "Button", Href: "/components/button", Role: "Primary and secondary resource actions."},
		},
		States: []string{
			"Loading identity, complete detail, not found, and access denied.",
			"Action available, pending, failed, completed, or revoked by new state.",
			"Tabs with populated, empty, lazy-loaded, and error content.",
			"Concurrent update detected with an explicit refresh path.",
		},
		Mobile:  "Wrap breadcrumbs, stack actions below the title, keep tabs horizontally scrollable, and move the context rail below the active panel.",
		Desktop: "Keep identity and actions on one header line when possible. Reserve the main column for tab content and a narrow rail for stable metadata, never for a competing task.",
		Accessibility: []string{
			"Keep the h1, status text, and primary action in a predictable reading order.",
			"Use the Tabs arrow-key behavior and visible focus instead of custom tab controls.",
			"Move focus to validation or server feedback after a destructive action fails.",
		},
		AppSpecific: []string{
			"Resource identity, lifecycle transitions, permissions, and destructive-action policy.",
			"Which tab owns URL state and which panels may lazy load.",
			"Freshness, conflict detection, activity provenance, and audit detail.",
		},
		SourceMap: `components/breadcrumbs   -> parent hierarchy
components/tabs          -> detail views and keyboard navigation
components/badge         -> lifecycle state
components/alert         -> decision-critical context
components/button        -> resource actions
app/releases/detail.go   -> resource query, permissions, transitions
app/releases/detail.templ -> header, tab panels, context rail`,
		Done: []string{
			"The route communicates identity, status, and next action before the first tab.",
			"Refreshing or deep-linking restores the correct resource and tab.",
			"Actions remain correct when permissions or resource state change.",
			"At both target widths, context follows the task instead of competing with it.",
		},
	}
}

func multiStepWorkflowContract() applicationPatternContract {
	return applicationPatternContract{
		Problem: "Long forms hide progress and make recovery expensive. A workflow should expose the current step, validate on the server, preserve safe draft data, and present a final review before commitment.",
		Components: []applicationPatternComponent{
			{Name: "Steps", Href: "/components/steps", Role: "Ordered progress with completed, current, and upcoming states."},
			{Name: "Text Input", Href: "/components/text-input", Role: "Typed values, constraints, helper text, and validation feedback."},
			{Name: "Select", Href: "/components/select", Role: "Constrained choices with an explicit label and current value."},
			{Name: "Checkbox", Href: "/components/checkbox", Role: "Optional policy choices with descriptive help."},
			{Name: "Alert", Href: "/components/alert", Role: "Draft, validation, and submission feedback."},
			{Name: "Button", Href: "/components/button", Role: "Back, continue, retry, and final commit actions."},
		},
		States: []string{
			"Pristine, editing, server validation error, and valid step.",
			"Draft saving, saved, save failed, expired, and resumed.",
			"Reviewing, submitting, completed, duplicate submit, and recoverable failure.",
			"Back navigation with preserved values and corrected downstream state.",
		},
		Mobile:  "Use a compact vertical progress summary before the active form. Stack fields and actions, keep Back before Continue in reading order, and avoid a second internal scroller.",
		Desktop: "Use a narrow progress rail and a focused form column. Keep helper text close to fields and place actions at the form boundary, not at the viewport edge.",
		Accessibility: []string{
			"Mark the current step with aria-current and announce server-rendered progress changes.",
			"Associate helper and error text with fields and focus the first invalid control.",
			"Prevent duplicate submission while keeping the pending state understandable.",
		},
		AppSpecific: []string{
			"Step graph, validation rules, draft lifetime, ownership, and idempotency keys.",
			"Which changes invalidate later steps and how resumed sessions are reconciled.",
			"Final side effects, audit records, retries, and cancellation policy.",
		},
		SourceMap: `components/steps         -> progress and current-step semantics
components/textinput     -> typed fields and validation
components/select        -> constrained choices
components/checkbox      -> optional policy choice
components/alert         -> draft and submission feedback
components/button        -> workflow navigation
app/workflow/state.go    -> step graph, draft, validation, idempotency
app/workflow/page.templ  -> step form, review, success and recovery`,
		Done: []string{
			"Every step can render directly from server state after a refresh.",
			"Back and resume preserve valid values without keeping invalid downstream decisions.",
			"Errors identify the field or action that needs attention and move focus there.",
			"The final commit is idempotent and its completion state survives retries.",
		},
	}
}
