package components

import (
	"github.com/araihu/goshtoso/components/radio"
	"github.com/araihu/goshtoso/components/rating"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// RatingDemoPage renders the Rating component demo as a full document.
templ RatingDemoPage() {
	@demo.Layout("Rating", "rating", ratingDemoContent())
}

templ ratingDemoContent() {
	<div id="rating-fragment" x-data="{ selected: 'md' }">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Rating",
				Description: "Collect product scores and satisfaction signals with accessible radio semantics, or present a non-interactive RatingDisplay.",
			},
			ratingDefaultPreview(),
			`@rating.Rating(rating.Config{
    ID: "rating-default",
    Name: "rating",
    Value: 3,
    Label: "Product rating",
})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Emoji Rating",
				Description: "Switch to sentiment icons for feedback flows that should feel more conversational.",
			},
			ratingEmojiPreview(),
			`@rating.Rating(rating.Config{
    ID: "rating-emoji",
    Name: "sentiment",
    Value: 4,
    Appearance: rating.AppearanceEmoji,
    Label: "Satisfaction",
})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:        "Sizes",
				Description:  "Use SizeSM, SizeMD, SizeLG, or SizeXL to fit dense forms or larger feedback moments.",
				AbovePreview: ratingSizeSelector(),
			},
			ratingSizesPreview(),
			`@rating.Rating(rating.Config{
    ID: "rating-size-md",
    Name: "rating-size-md",
    Value: 3,
    Size: rating.SizeMD,
    Label: "Medium",
    ShowLabel: true,
})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Disabled",
				Description: "Disabled ratings keep their selected value visible while blocking interaction.",
			},
			ratingDisabledPreview(),
			`@rating.Rating(rating.Config{
    ID: "rating-disabled",
    Name: "disabled-rating",
    Value: 2,
    Disabled: true,
})`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Rating Display",
				Description: "RatingDisplay owns the same visual language as a non-interactive summary.",
			},
			ratingDisplayPreview(),
			`@rating.RatingDisplay(rating.DisplayConfig{
    ID: "rating-display",
    Value: 4,
    Label: "Average rating",
    ShowLabel: true,
})`,
		)
	</div>
}

// ratingSizeSelector renders the segmented size selector for the size preview.
templ ratingSizeSelector() {
	<div class="mb-3 flex items-center gap-4">
		<label class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Size</label>
		<div data-testid="rating-size-selector">
			@radio.RadioBar() {
				@ratingSizeOption("sm", "sm")
				@ratingSizeOption("md", "md")
				@ratingSizeOption("lg", "lg")
				@ratingSizeOption("xl", "xl")
			}
		</div>
		<span class="sr-only" data-testid="rating-size-selected" x-text="selected"></span>
	</div>
}

// ratingSizeOption renders one segmented radio item for the rating size selector.
templ ratingSizeOption(value, label string) {
	@radio.Radio(radio.Config{
		ID:        "rating-size-" + value,
		Name:      "rating-size",
		Value:     value,
		Label:     label,
		Segmented: true,
		Alpine: &radio.AlpineConfig{
			BindChecked: "selected === '" + value + "'",
			OnChange:    "selected = '" + value + "'",
		},
	})
}

templ ratingDefaultPreview() {
	<div id="rating-default" class="w-full max-w-md mx-auto">
		@rating.Rating(rating.Config{
			ID:        "rating-stars",
			Name:      "rating-stars",
			Value:     3,
			Label:     "Product rating",
			ShowLabel: true,
		})
	</div>
}

templ ratingEmojiPreview() {
	<div id="rating-emoji" class="w-full max-w-md mx-auto">
		@rating.Rating(rating.Config{
			ID:        "rating-sentiment",
			Name:      "rating-sentiment",
			Value:     4,
			Label:     "Satisfaction",
			ShowLabel: true,
			Appearance: rating.AppearanceEmoji,
		})
	</div>
}

templ ratingSizesPreview() {
	<div id="rating-sizes" class="w-full max-w-md mx-auto">
		<div data-testid="rating-size-preview-sm" x-show="selected === 'sm'" x-cloak>
			@rating.Rating(rating.Config{ID: "rating-size-preview-sm", Name: "rating-size-preview-sm", Value: 3, Size: rating.SizeSM, Label: "Small", ShowLabel: true})
		</div>
		<div data-testid="rating-size-preview-md" x-show="selected === 'md'">
			@rating.Rating(rating.Config{ID: "rating-size-preview-md", Name: "rating-size-preview-md", Value: 3, Size: rating.SizeMD, Label: "Medium", ShowLabel: true})
		</div>
		<div data-testid="rating-size-preview-lg" x-show="selected === 'lg'" x-cloak>
			@rating.Rating(rating.Config{ID: "rating-size-preview-lg", Name: "rating-size-preview-lg", Value: 4, Size: rating.SizeLG, Label: "Large", ShowLabel: true})
		</div>
		<div data-testid="rating-size-preview-xl" x-show="selected === 'xl'" x-cloak>
			@rating.Rating(rating.Config{ID: "rating-size-preview-xl", Name: "rating-size-preview-xl", Value: 4, Size: rating.SizeXL, Label: "XL", ShowLabel: true})
		</div>
	</div>
}

templ ratingDisabledPreview() {
	<div id="rating-disabled" class="w-full max-w-md mx-auto">
		@rating.Rating(rating.Config{
			ID:        "rating-disabled-control",
			Name:      "rating-disabled-control",
			Value:     2,
			Label:     "Locked rating",
			ShowLabel: true,
			Disabled:  true,
		})
	</div>
}

templ ratingDisplayPreview() {
	<div id="rating-readonly" class="w-full max-w-md mx-auto">
		@rating.RatingDisplay(rating.DisplayConfig{
			ID:        "rating-readonly-summary",
			Value:     4,
			Label:     "Average rating",
			ShowLabel: true,
		})
	</div>
}
