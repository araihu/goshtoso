package components

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// PanelDemoPage renders the Panel component demo.
templ PanelDemoPage() {
	@demo.Layout("Panel", "panel", panelDemoContent())
}

templ panelDemoContent() {
	<div id="panel-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Panel",
				Description: "Frame full-width operational, detail, and settings content without imposing a heading rank, article role, shadow, or maximum width.",
			},
			panelOutlinedPreview(),
			`@panel.Panel(panel.Config{
    Header:    changePanelHeader(),
    Actions:   changePanelActions(),
    Footer:    changePanelFooter(),
    RootAttrs: templ.Attributes{
        "role": "region",
        "aria-labelledby": "change-panel-title",
    },
}) {
    @changePanelBody()
}`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Subtle settings surface",
				Description: "Use the alternate surface when a grouped region needs hierarchy without another visible border.",
			},
			panelSubtlePreview(),
			`@panel.Panel(panel.Config{
    Appearance: panel.AppearanceSubtle,
    Density:    panel.DensityRelaxed,
    Header:     notificationPanelHeader(),
}) {
    @notificationPanelBody()
}`,
		)
		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Plain detail rail",
				Description: "Use the plain treatment when the surrounding layout already owns its border and background.",
			},
			panelPlainPreview(),
			`@panel.Panel(panel.Config{
    Appearance: panel.AppearancePlain,
    Density:    panel.DensityCompact,
    Header:     ownershipPanelHeader(),
}) {
    @ownershipPanelBody()
}`,
		)
	</div>
}

templ panelOutlinedPreview() {
	<div id="panel-outlined" class="w-full">
		@panel.Panel(panel.Config{
			Header:    changePanelHeader(),
			Actions:   changePanelActions(),
			Footer:    changePanelFooter(),
			RootAttrs: templ.Attributes{
				"role":               "region",
				"aria-labelledby": "change-panel-title",
			},
		}) {
			@changePanelBody()
		}
	</div>
}

templ changePanelHeader() {
	<div>
		<div class="flex flex-wrap items-center gap-2">
			<h2 id="change-panel-title" class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Database failover</h2>
			@badge.Badge(badge.Config{Label: "Awaiting review", Tone: badge.ToneWarning})
		</div>
		<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Change CHG-2841 · Window starts at 02:00 UTC</p>
	</div>
}

templ changePanelActions() {
	@button.Button(button.WithTone(button.TonePrimary)) {
		Review change
	}
}

templ changePanelBody() {
	<dl class="grid gap-4 text-sm sm:grid-cols-3">
		<div>
			<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Owner</dt>
			<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Data reliability</dd>
		</div>
		<div>
			<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Risk</dt>
			<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Elevated</dd>
		</div>
		<div>
			<dt class="text-on-surface-muted dark:text-on-surface-dark-muted">Rollback threshold</dt>
			<dd class="mt-1 font-medium text-on-surface-strong dark:text-on-surface-dark-strong">Write lag above 90 s</dd>
		</div>
	</dl>
}

templ changePanelFooter() {
	<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Last validated 8 minutes ago by the change service.</p>
}

templ panelSubtlePreview() {
	<div id="panel-subtle" class="w-full">
		@panel.Panel(panel.Config{
			Appearance: panel.AppearanceSubtle,
			Density:    panel.DensityRelaxed,
			Header:     notificationPanelHeader(),
		}) {
			@notificationPanelBody()
		}
	</div>
}

templ notificationPanelHeader() {
	<div>
		<h2 class="text-lg font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Pickup notifications</h2>
		<p class="mt-1 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Choose when patrons receive hold updates.</p>
	</div>
}

templ notificationPanelBody() {
	<div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between">
		<p class="text-on-surface dark:text-on-surface-dark">Ready and expiring-soon notices are enabled for this branch.</p>
		@button.Button(button.WithTone(button.ToneSecondary)) {
			Change rules
		}
	</div>
}

templ panelPlainPreview() {
	<div id="panel-plain" class="w-full rounded-radius border border-outline dark:border-outline-dark">
		@panel.Panel(panel.Config{
			Appearance: panel.AppearancePlain,
			Density:    panel.DensityCompact,
			Header:     ownershipPanelHeader(),
		}) {
			@ownershipPanelBody()
		}
	</div>
}

templ ownershipPanelHeader() {
	<h2 class="text-base font-bold text-on-surface-strong dark:text-on-surface-dark-strong">Ownership</h2>
}

templ ownershipPanelBody() {
	<p class="text-sm text-on-surface-muted dark:text-on-surface-dark-muted">Watershed field team · Northern reach</p>
}
