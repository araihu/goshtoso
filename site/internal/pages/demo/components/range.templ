package components

import (
	rangeinput "github.com/araihu/goshtoso/components/range"
	"github.com/araihu/goshtoso/site/internal/pages/demo"
)

// RangeDemoPage renders the Range component demo.
templ RangeDemoPage() {
	@demo.Layout("Range", "range", rangeDemoContent())
}

// rangeDemoContent renders the demo. Each range variant lives in its own
// preview frame followed by its own code block (mirrors
// penguinui.com/components/range). The variant set stays wrapped in
// #range-fragment.
templ rangeDemoContent() {
	<div id="range-fragment">
		@demo.ComponentDemo(
			demo.ComponentDemoProps{
				Title:       "Range",
				Description: "Range sliders let users pick a numeric value from a bounded interval with native keyboard and form behavior.",
			},
			rangeDefaultPreview(),
			`@rangeinput.Range(rangeinput.Config{
    ID:    "mood",
    Name:  "mood",
    Label: "Mood Meter",
    Value: "20",
    Min:   "0",
    Max:   "100",
    Step:  "1",
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Range with Ticks",
				Description: "ShowTicks renders a responsive tick row below the slider. Provide Ticks to customize the labels.",
			},
			rangeTicksPreview(),
			`@rangeinput.Range(rangeinput.Config{
    ID:        "moodTicks",
    Name:      "mood",
    Label:     "Mood Meter",
    Value:     "20",
    Step:      "5",
    ShowTicks: true,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Range with Icons",
				Description: "LeadingIcon and TrailingIcon frame the slider with semantic icon labels while the native input remains the interactive control.",
			},
			rangeIconsPreview(),
			`@rangeinput.Range(rangeinput.Config{
    ID:           "brightnessIcons",
    Name:         "brightness",
    Label:        "Brightness",
    Value:        "20",
    LeadingIcon:  rangeSunDimIcon(),
    TrailingIcon: rangeSunIcon(),
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Range with Value",
				Description: "ShowValue adds a compact Alpine.js value badge that updates as the slider moves.",
			},
			rangeValuePreview(),
			`@rangeinput.Range(rangeinput.Config{
    ID:        "volumeValue",
    Name:      "volume",
    Label:     "Volume",
    Value:     "20",
    ShowValue: true,
})`,
		)

		@demo.DemoSection(
			demo.DemoSectionProps{
				Title:       "Disabled Range",
				Description: "Disabled blocks interaction and dims the control.",
			},
			rangeDisabledPreview(),
			`@rangeinput.Range(rangeinput.Config{
    ID:       "disabledRange",
    Name:     "disabled",
    Label:    "Disabled",
    Value:    "40",
    Disabled: true,
})`,
		)
	</div>
	// API reference lives outside #range-fragment.
	@demo.APIReference([]demo.PropDoc{
		{Name: "ID", Type: "string", Default: `""`, Description: "Unique id for the range input and label target."},
		{Name: "Name", Type: "string", Default: `""`, Description: "Form field name."},
		{Name: "Label", Type: "string", Default: `""`, Description: "Visible label for the slider."},
		{Name: "Value", Type: "string", Default: `"0"`, Description: "Current value."},
		{Name: "Min", Type: "string", Default: `"0"`, Description: "Minimum value."},
		{Name: "Max", Type: "string", Default: `"100"`, Description: "Maximum value."},
		{Name: "Step", Type: "string", Default: `"1"`, Description: "Increment between valid values."},
		{Name: "Disabled", Type: "bool", Default: "false", Description: "Disables the slider."},
		{Name: "Required", Type: "bool", Default: "false", Description: "Marks the input as required."},
		{Name: "ShowTicks", Type: "bool", Default: "false", Description: "Renders a tick row below the input."},
		{Name: "Ticks", Type: "[]Tick", Default: "nil", Description: "Custom tick labels; empty uses the default min-to-max scale."},
		{Name: "ShowValue", Type: "bool", Default: "false", Description: "Renders a live Alpine.js value badge."},
		{Name: "LeadingIcon", Type: "templ.Component", Default: "nil", Description: "Icon component rendered before the control."},
		{Name: "TrailingIcon", Type: "templ.Component", Default: "nil", Description: "Icon component rendered after the control."},
		{Name: "RootClass", Type: "string", Default: `""`, Description: "Extra classes on the container."},
		{Name: "InputClass", Type: "string", Default: `""`, Description: "Extra classes on the range input."},
		{Name: "InputAttrs", Type: "templ.Attributes", Default: "nil", Description: "Arbitrary attributes on the input (e.g. hx-post, x-on:input, data-*)."},
	})
}

templ rangeDefaultPreview() {
	<div id="range-default" class="w-full max-w-md mx-auto">
		@rangeinput.Range(rangeinput.Config{
			ID:    "rangeDefault",
			Name:  "mood",
			Label: "Mood Meter",
			Value: "20",
			Min:   "0",
			Max:   "100",
			Step:  "1",
		})
	</div>
}

templ rangeTicksPreview() {
	<div id="range-ticks" class="w-full max-w-md mx-auto">
		@rangeinput.Range(rangeinput.Config{
			ID:        "rangeTicks",
			Name:      "mood_ticks",
			Label:     "Mood Meter",
			Value:     "20",
			Step:      "5",
			ShowTicks: true,
		})
	</div>
}

templ rangeIconsPreview() {
	<div id="range-icons" class="w-full max-w-md mx-auto">
		@rangeinput.Range(rangeinput.Config{
			ID:           "rangeIcons",
			Name:         "brightness",
			Label:        "Brightness",
			Value:        "20",
			LeadingIcon:  rangeSunDimIcon(),
			TrailingIcon: rangeSunIcon(),
		})
	</div>
}

templ rangeValuePreview() {
	<div id="range-value" class="w-full max-w-md mx-auto">
		@rangeinput.Range(rangeinput.Config{
			ID:        "rangeValue",
			Name:      "volume",
			Label:     "Volume",
			Value:     "20",
			ShowValue: true,
		})
	</div>
}

templ rangeDisabledPreview() {
	<div id="range-disabled" class="w-full max-w-md mx-auto">
		@rangeinput.Range(rangeinput.Config{
			ID:       "rangeDisabled",
			Name:     "disabled",
			Label:    "Disabled",
			Value:    "40",
			Disabled: true,
		})
	</div>
}

templ rangeSunDimIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-5">
		<path d="M12 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0M8.5 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m0 11a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m5-5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m-11 0a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m9.743-4.036a.5.5 0 1 1-.707-.707.5.5 0 0 1 .707.707m-7.779 7.779a.5.5 0 1 1-.707-.707.5.5 0 0 1 .707.707m7.072 0a.5.5 0 1 1 .707-.707.5.5 0 0 1-.707.707M3.757 4.464a.5.5 0 1 1 .707-.707.5.5 0 0 1-.707.707"></path>
	</svg>
}

templ rangeSunIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-5">
		<path d="M12 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"></path>
	</svg>
}
