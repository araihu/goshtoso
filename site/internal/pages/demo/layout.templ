// sidebarItem creates a sidebar item with data-sidebar-item for search filtering
// and HTMX attributes for fragment-swap navigation.
func sItem(id, label, href, activeComponent string) sidebar.Item {
	return sidebar.Item{
		ID: id, Label: label, Href: href,
		Active:    activeComponent == id,
		LinkAttrs: navHxAttrs(href, label),
	}
}

func getSearchItems() []searchfield.Item {
	items := []searchfield.Item{
		{ID: "search-getting-started", Title: "Getting Started", Description: "Install Goshtoso, wire assets, and render your first component.", Href: "/getting-started", Section: "Docs", Attrs: navHxAttrs("/getting-started", "")},
		{ID: "search-component-model", Title: "Component Model", Description: "Learn the common component interface, concrete return values, constructor styles, and stable Kind identity.", Href: "/docs/component-model", Section: "Docs", Attrs: navHxAttrs("/docs/component-model", "")},
		{ID: "search-application-patterns", Title: "Application Patterns", Description: "Compose App Shell, Operations List, Detail Workspace, and Multi-step Workflow product surfaces.", Href: "/docs/application-patterns", Section: "Docs", Keywords: []string{"recipes app shell operations detail workflow"}, Attrs: navHxAttrs("/docs/application-patterns", "")},
		{ID: "search-iconpack", Title: "Icon Packs", Description: "Generate consumer-local packs from Arai Hu Assets, GitHub trees, single files, or multiple arbitrary sources with an iconpack-owned TOFU lock.", Href: "/docs/iconpack", Section: "Docs", Keywords: []string{"sprite heroicons developer icons bootstrap arbitrary source manifest muamba iconpack yaml lock"}, Attrs: navHxAttrs("/docs/iconpack", "")},
		{ID: "search-examples", Title: "Examples", Description: "Full runnable app examples built with Goshtoso components.", Href: "/examples", Section: "Examples", Attrs: navHxAttrs("/examples", "")},
		{ID: "search-agents", Title: "AI Agents", Description: "Install and verify the Goshtoso consumer integration skill for AI coding tools.", Href: "/docs/agents", Section: "Docs", Attrs: navHxAttrs("/docs/agents", "")},
		{ID: "search-theme", Title: "Theme", Description: "Customize colors, radius, typography, and dark mode tokens.", Href: "/docs/theme", Section: "Docs", Attrs: navHxAttrs("/docs/theme", "")},
		{ID: "search-attributions", Title: "Attributions", Description: "Third-party notices and project credits.", Href: "/attributions", Section: "Docs", Attrs: navHxAttrs("/attributions", "")},
		{ID: "search-license", Title: "License", Description: "License details for using Goshtoso.", Href: "/license", Section: "Docs", Attrs: navHxAttrs("/license", "")},
		{ID: "search-module-charts", Title: "Charts", Description: "Static, interactive, and 3D charts from the Goshtoso Charts module.", Href: "/modules/charts", Section: "Modules", Keywords: []string{"visualization line 3d"}, Attrs: navHxAttrs("/modules/charts", "")},
		{ID: "search-module-app-shells", Title: "App Shells", Description: "Reusable component documentation and console shells from Goshtoso App Shells.", Href: "/modules/app-shells", Section: "Modules", Keywords: []string{"layout docs console shell"}, Attrs: navHxAttrs("/modules/app-shells", "")},
	}
	for _, page := range catalog.ComponentPages() {
		if page.Active == "app-shell" {
			continue
		}
		items = append(items, searchfield.Item{
			ID:          "search-" + page.Active,
			Title:       page.Title,
			Description: page.Description,
			Href:        page.Path,
			Section:     page.Section,
			Keywords:    []string{page.Active},
			Attrs:       navHxAttrs(page.Path, ""),
		})
	}
	for _, section := range getSidebarSections("") {
		if section.Title == "Examples" {
			for _, item := range section.Items {
				items = append(items, searchfield.Item{
					ID:          "search-" + item.ID,
					Title:       item.Label,
					Description: searchItemDescription(item.ID, item.Label, section.Title),
					Href:        item.Href,
					Section:     section.Title,
					Keywords:    []string{item.ID},
					Attrs:       navHxAttrs(item.Href, ""),
				})
			}
		}
	}
	items = append(items, getSearchSectionItems()...)
	return items
}

func searchItemDescription(id, label, section string) string {
	descriptions := map[string]string{
		"todo":    "Runnable task-list example with add, edit, complete, and filter flows.",
		"chat":    "Runnable chat interface example with messages, composer, and conversation layout.",
		"logs":    "Live log-feed example with streaming updates and operational scanning patterns.",
		"profile": "Profile editing example with forms, preferences, validation, and persisted state.",
		"ticker":  "Live ticker example with real-time list updates and compact status rows.",
	}
	if description, ok := descriptions[id]; ok {
		return description
	}
	return label + " patterns for " + section + " interfaces."
}

func searchSectionItem(id, title, description, href string) searchfield.Item {
	return searchfield.Item{
		ID:          "search-section-" + id,
		Title:       title,
		Description: description,
		Href:        href,
		Section:     "Section",
	}
}

func getSearchSectionItems() []searchfield.Item {
	return []searchfield.Item{
		searchSectionItem("button-sizes", "Sizes", "Button size variants: small, medium, large, and extra large.", "/components/button#"+slugify("Sizes")),
		searchSectionItem("button-disabled", "Disabled", "Disabled button states block interaction and dim the control.", "/components/button#"+slugify("Disabled")),
		searchSectionItem("button-htmx-interactions", "HTMX Interactions", "Button examples wired to HTMX requests, confirmation, indicators, and loading text.", "/components/button#"+slugify("HTMX Interactions")),
	}
}

// getSidebarSections returns the component categories with left-border style items
func getSidebarSections(activeComponent string) []sidebar.Section {
	sections := []sidebar.Section{{
		Title: "Modules",
		Items: []sidebar.Item{
			sItem("module-charts", "Charts", "/modules/charts", activeComponent),
			sItem("module-app-shells", "App Shells", "/modules/app-shells", activeComponent),
		},
	}}
	sectionIndex := map[string]int{}
	for _, page := range catalog.ComponentPages() {
		if page.Active == "app-shell" {
			continue
		}
		index, ok := sectionIndex[page.Section]
		if !ok {
			index = len(sections)
			sectionIndex[page.Section] = index
			sections = append(sections, sidebar.Section{Title: page.Section})
		}
		sections[index].Items = append(
			sections[index].Items,
			sItem(page.Active, page.Title, page.Path, activeComponent),
		)
	}

	return append(sections, sidebar.Section{
		Title:       "Examples",
		Collapsible: true,
		Items: []sidebar.Item{
			sItem("examples", "Overview", "/examples", activeComponent),
			sItem("todo", "Todo List", "/examples/todo", activeComponent),
			sItem("expense", "Expense Tracker", "/examples/expense", activeComponent),
			sItem("chat", "Chat", "/examples/chat", activeComponent),
			sItem("logs", "Live Log Feed", "/examples/logs", activeComponent),
			sItem("profile", "Profile", "/examples/profile", activeComponent),
			sItem("ticker", "Live Ticker", "/examples/ticker", activeComponent),
			sItem("wizard", "Onboarding Wizard", "/examples/wizard", activeComponent),
		},
	})
}

// componentNavLink represents a prev/next link for component navigation
type componentNavLink struct {
	Label string
	Href  string
}

func getComponentNav(activeComponent string) (prev, next *componentNavLink) {
	pages := make([]catalog.Entry, 0, len(catalog.ComponentPages()))
	for _, page := range catalog.ComponentPages() {
		if page.Active != "app-shell" {
			pages = append(pages, page)
		}
	}
	for i, page := range pages {
		if page.Active == activeComponent {
			if i > 0 {
				prev = &componentNavLink{
					Label: pages[i-1].Title,
					Href:  pages[i-1].Path,
				}
			}
			if i < len(pages)-1 {
				next = &componentNavLink{
					Label: pages[i+1].Title,
					Href:  pages[i+1].Path,
				}
			}
			return
		}
	}
	return nil, nil
}

templ componentNavFooter(activeComponent string) {
	{{ prev, next := getComponentNav(activeComponent) }}
	if prev != nil || next != nil {
		<div class="mt-12 flex items-center justify-between border-t border-outline dark:border-outline-dark pt-6 pb-4">
			if prev != nil {
				{{ prevAttrs := navHxAttrs(prev.Href, "") }}
				<a
					href={ templ.SafeURL(prev.Href) }
					{ prevAttrs... }
					class="group flex items-center gap-2 text-sm text-on-surface-muted hover:text-primary dark:text-on-surface-dark-muted dark:hover:text-primary-dark transition-colors motion-reduce:transition-none"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
					</svg>
					<span>{ prev.Label }</span>
				</a>
			} else {
				<div></div>
			}
			if next != nil {
				{{ nextAttrs := navHxAttrs(next.Href, "") }}
				<a
					href={ templ.SafeURL(next.Href) }
					{ nextAttrs... }
					class="group flex items-center gap-2 text-sm text-on-surface-muted hover:text-primary dark:text-on-surface-dark-muted dark:hover:text-primary-dark transition-colors motion-reduce:transition-none"
				>
					<span>{ next.Label }</span>
					<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
					</svg>
				</a>
			} else {
				<div></div>
			}
		</div>
	}
}

// siteFooter renders the global footer shown beneath every page's content
// (inside #main-content, so it survives fragment-swap navigation). Mirrors
// PenguinUI's footer: brand line, legal nav, and social links.
templ siteFooter() {
	{{ privacyAttrs := navHxAttrs("/privacy", "") }}
	{{ attrAttrs := navHxAttrs("/attributions", "") }}
	{{ licenseAttrs := navHxAttrs("/license", "") }}
	<footer class="mt-16 border-t border-outline dark:border-outline-dark pt-8 pb-10 text-center">
		<p class="inline-flex items-center justify-center gap-2 font-title font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
			<img
				src="/assets/images/goshtoso-mark.svg"
				alt=""
				aria-hidden="true"
				class="size-6 shrink-0 rounded-md"
			/>
			<span>Goshtoso <span class="font-normal text-on-surface-muted dark:text-on-surface-dark-muted">2026</span></span>
		</p>
		<nav class="mt-3 flex items-center justify-center gap-2 text-sm text-on-surface-muted dark:text-on-surface-dark-muted">
			<a href="/privacy" { privacyAttrs... } class="hover:text-primary dark:hover:text-primary-dark transition-colors motion-reduce:transition-none">Privacy</a>
			<span class="text-primary dark:text-primary-dark">•</span>
			<a href="/attributions" { attrAttrs... } class="hover:text-primary dark:hover:text-primary-dark transition-colors motion-reduce:transition-none">Attributions</a>
			<span class="text-primary dark:text-primary-dark">•</span>
			<a href="/license" { licenseAttrs... } class="hover:text-primary dark:hover:text-primary-dark transition-colors motion-reduce:transition-none">License</a>
		</nav>
		<div class="mt-4 flex items-center justify-center gap-4">
			<a href="https://github.com/araihu/goshtoso" target="_blank" rel="noopener" aria-label="GitHub" class="text-on-surface-muted hover:text-on-surface-strong dark:text-on-surface-dark-muted dark:hover:text-on-surface-dark-strong transition-colors motion-reduce:transition-none">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
					<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"></path>
				</svg>
			</a>
		</div>
	</footer>
}

func getThemeOptions() []selectfield.Option {
	all := themes.All()
	options := make([]selectfield.Option, 0, len(all))
	for _, theme := range all {
		options = append(options, selectfield.Option{Value: theme.Key, Label: theme.Label})
	}
	return options
}

templ themeSelectIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
	</svg>
}
