package server

templ tableHeadOOBFragment(id string, sortBy string, sortDir string, content templ.Component) {
	<hx-partial hx-target={ "#" + id } hx-swap="outerHTML">
		<thead
			id={ id }
			data-table-sort-by={ sortBy }
			data-table-sort-dir={ sortDir }
			class={ tableHeadClasses }
		>
			@content
		</thead>
	</hx-partial>
}

templ tablePaginationOOBFragment(id string, page int, totalPages int, navigation templ.Component) {
	<div
		id={ id }
		hx-swap-oob="true"
		class="flex items-center justify-between border-t border-outline px-4 py-3 dark:border-outline-dark"
		hidden?={ totalPages <= 1 }
	>
		if totalPages > 1 {
			<div class="text-sm text-on-surface/70 dark:text-on-surface-dark/70">
				Page { page } of { totalPages }
			</div>
			@navigation
		}
	</div>
}
