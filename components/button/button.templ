package button

// Button renders a PenguinUI-styled button with Tailwind utility classes.
templ buttonTemplate(options ...Option) {
	{{ cfg := newConfig(options) }}
	{{ classes := buttonClasses(cfg) }}
	{{ hasHTMX := cfg.htmx != nil }}
	{{ hasAlpine := cfg.alpine != nil }}
	
	<button
		if cfg.id != "" {
			id={ cfg.id }
		}
		type={ cfg.buttonType }
		class={ classes }
		if cfg.disabled {
			disabled
		}
		if cfg.loadingText != "" {
			data-goshtoso-loading
		}
		
		if hasAlpine {
			if cfg.alpine.OnClick != "" {
				x-on:click={ cfg.alpine.OnClick }
			}
			if cfg.alpine.Show != "" {
				x-show={ cfg.alpine.Show }
			}
			if cfg.alpine.BindDisabled != "" {
				:disabled={ cfg.alpine.BindDisabled }
			}
			if cfg.alpine.Transition {
				x-transition
			}
			if cfg.alpine.Data != "" {
				x-data={ cfg.alpine.Data }
			}
		}
		
		if hasHTMX {
			if cfg.loadingText != "" {
				hx-disabled-elt="this"
			}
			if cfg.htmx.Get != "" {
				hx-get={ cfg.htmx.Get }
			}
			if cfg.htmx.Post != "" {
				hx-post={ cfg.htmx.Post }
			}
			if cfg.htmx.Put != "" {
				hx-put={ cfg.htmx.Put }
			}
			if cfg.htmx.Delete != "" {
				hx-delete={ cfg.htmx.Delete }
			}
			if cfg.htmx.Patch != "" {
				hx-patch={ cfg.htmx.Patch }
			}
			if cfg.htmx.Target != "" {
				hx-target={ cfg.htmx.Target }
			}
			if cfg.htmx.Swap != "" {
				hx-swap={ cfg.htmx.Swap }
			}
			if cfg.htmx.Trigger != "" {
				hx-trigger={ cfg.htmx.Trigger }
			}
			if cfg.htmx.Indicator != "" {
				hx-indicator={ cfg.htmx.Indicator }
			}
			if cfg.htmx.PushURL {
				hx-push-url="true"
			}
			if cfg.htmx.Confirm != "" {
				hx-confirm={ cfg.htmx.Confirm }
			}
			if cfg.htmx.Vals != "" {
				hx-vals={ cfg.htmx.Vals }
			}
		}
		{ cfg.attrs... }
		>
			if cfg.loadingText != "" {
				<span class="goshtoso-loading-content">{ children... }</span>
				<span class="goshtoso-loading-label" aria-live="polite">{ cfg.loadingText }</span>
			} else {
				{ children... }
			}
	</button>
}
