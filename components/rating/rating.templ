package rating

import "fmt"

// Rating renders a star or emoji rating control.
templ ratingTemplate(cfg Config) {
	@ratingInteractive(cfg)
}

// RatingDisplay renders a non-interactive star or emoji rating.
templ ratingDisplayTemplate(cfg DisplayConfig) {
	@ratingDisplay(cfg)
}

templ ratingInteractive(cfg Config) {
	<div
		id={ cfg.resolvedID() }
		class={ cfg.rootClasses() }
		x-data={ cfg.xData() }
		{ cfg.RootAttrs... }
	>
		if cfg.ShowLabel {
			<span class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">{ cfg.resolvedLabel() }</span>
		}
		<div class={ cfg.controlClasses() } role="radiogroup" aria-label={ cfg.resolvedLabel() }>
			for i := 1; i <= cfg.resolvedMax(); i++ {
				@ratingOption(cfg, i)
			}
		</div>
	</div>
}

templ ratingDisplay(cfg DisplayConfig) {
	{{ accessibleLabel := cfg.Label }}
	{{ if accessibleLabel == "" { accessibleLabel = cfg.valueLabel(cfg.resolvedValue()) } }}
	<div
		id={ cfg.resolvedID() }
		class={ cfg.rootClasses() }
		role="img"
		aria-label={ accessibleLabel }
		{ cfg.RootAttrs... }
	>
		if cfg.ShowLabel {
			<span class="text-sm font-medium text-on-surface-strong dark:text-on-surface-dark-strong">{ cfg.resolvedLabel() }</span>
		}
		<div class={ cfg.controlClasses() }>
			for i := 1; i <= cfg.resolvedMax(); i++ {
				<span class={ cfg.iconClasses() + " " + displayIconState(cfg, i) } aria-hidden="true">
					if cfg.Appearance == AppearanceEmoji {
						{ cfg.emojiIcon(i) }
					} else {
						@starIcon()
					}
				</span>
			}
		</div>
	</div>
}

templ ratingOption(cfg Config, value int) {
	<label for={ cfg.inputID(value) } class="group/rating-option cursor-pointer has-disabled:cursor-not-allowed">
		<span class="sr-only">{ cfg.valueLabel(value) }</span>
		<input
			id={ cfg.inputID(value) }
			type="radio"
			name={ cfg.resolvedName() }
			value={ fmt.Sprintf("%d", value) }
			class="sr-only"
			x-model.number="currentVal"
			if cfg.resolvedValue() == value {
				checked
			}
			if cfg.Disabled {
				disabled
			}
		/>
		<span
			class={ cfg.iconClasses() + " group-hover/rating-option:scale-110" }
			x-bind:class={ cfg.bindClass(value) }
			aria-hidden="true"
		>
			if cfg.Appearance == AppearanceEmoji {
				{ cfg.emojiIcon(value) }
			} else {
				@starIcon()
			}
		</span>
	</label>
}

templ starIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-full">
		<path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd"></path>
	</svg>
}
