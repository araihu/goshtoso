package kbd

// Kbd renders a keyboard input hint.
//
// Usage:
//
//	@kbd.Kbd("Ctrl")
//	@kbd.Kbd("K", kbd.WithSize(kbd.SizeSM))
//	@kbd.Kbd("", kbd.WithIcon(commandIcon()), kbd.WithLabel("Command"))
templ kbdTemplate(text string, options ...Option) {
	{{ cfg := newConfig(text, options) }}
	<kbd
		class={ cfg.rootClasses() }
		if cfg.label != "" {
			aria-label={ cfg.label }
		}
		{ cfg.attrs... }
	>
		if cfg.icon != nil {
			<span class={ "shrink-0 " + cfg.iconClasses() } aria-hidden="true">
				@cfg.icon
			</span>
		}
		if cfg.text != "" {
			{ cfg.text }
		} else if cfg.accessibleLabel() != "" {
			<span class="sr-only">{ cfg.accessibleLabel() }</span>
		}
	</kbd>
}
