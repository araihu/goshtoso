package pageheader

// PageHeader renders breadcrumb context, a page title and description, and
// optional page-level actions.
templ pageHeaderTemplate(cfg Config) {
	<header class={ cfg.rootClasses() } { cfg.RootAttrs... }>
		if cfg.Breadcrumbs != nil {
			<div class={ cfg.breadcrumbsClasses() } { cfg.BreadcrumbsAttrs... }>
				@cfg.Breadcrumbs
			</div>
		}
		<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				<h1 class={ cfg.titleClasses() } { cfg.TitleAttrs... }>
					{ cfg.Title }
				</h1>
				if cfg.Description != "" {
					<p class="mt-2 max-w-3xl text-sm leading-6 text-on-surface-muted sm:text-base dark:text-on-surface-dark-muted">
						{ cfg.Description }
					</p>
				}
			</div>
			if cfg.Actions != nil {
				<div class={ cfg.actionsClasses() } { cfg.ActionsAttrs... }>
					@cfg.Actions
				</div>
			}
		</div>
	</header>
}
