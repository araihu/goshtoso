package avatar

import "fmt"

// Avatar renders a layered avatar component.
//
// Three layers (bottom to top):
//  1. Initials — always rendered, solid background with text initials (or icon)
//  2. Loading — spinner overlay, only when Src is set, hidden on image load or error
//  3. Image — the actual image, only when Src is set, hidden on error
//
// When Src is provided, Alpine.js handles image onload/onerror:
//   - onload: hide the loading spinner
//   - onerror: hide both image and spinner (initials show through), log a console warning
//
// Usage:
//
//	// Image with initials fallback
//	@avatar.Avatar(avatar.Config{
//	    Src:  "https://example.com/avatar.jpg",
//	    Name: "John Doe",
//	    Size: avatar.SizeMD,
//	})
//
//	// Initials only
//	@avatar.Avatar(avatar.Config{
//	    Name:    "dev-ops",
//	    Tone: avatar.TonePrimary,
//	})
//
//	// Explicit initials
//	@avatar.Avatar(avatar.Config{
//	    Initials: "JS",
//	})
templ avatarTemplate(cfg Config) {
	if cfg.Status != "" {
		@avatarWithStatus(cfg)
	} else {
		@avatarLayers(cfg)
	}
}

// AvatarStack renders an overlapping group of avatars.
templ avatarStackTemplate(cfg StackConfig) {
	{{
		label := cfg.Label
		if label == "" {
			label = "Avatar group"
		}
		rootClasses := "flex items-center " + cfg.RootClass
	}}
	<div class={ rootClasses } role="list" aria-label={ label }>
		for i, item := range cfg.Items {
			{{
				item.Reactive = item.Reactive || cfg.Reactive
				item.RootClass = "ring-2 ring-surface dark:ring-surface-dark " + item.RootClass
				if i > 0 {
					item.RootClass = "-ml-3 " + item.RootClass
				}
			}}
			<div role="listitem">
				@Avatar(item)
			</div>
		}
	</div>
}

// avatarLayers renders the 3-layer stack.
//
// When cfg.Reactive is true, the size classes (size-X text-Y) are omitted
// from the baked class string and an x-bind:class="avatarSizeClass" reads
// the live value from the parent Alpine scope instead — see Config.Reactive.
templ avatarLayers(cfg Config) {
	{{
		sizePart := cfg.sizeClasses()
		if cfg.Reactive {
			sizePart = ""
		}
		radiusPart := cfg.shapeClasses()
		if cfg.ReactiveRadius {
			radiusPart = ""
		}
		bindClass := ""
		if cfg.Reactive && cfg.ReactiveRadius {
			bindClass = "[avatarSizeClass, avatarRadiusClass]"
		} else if cfg.Reactive {
			bindClass = "avatarSizeClass"
		} else if cfg.ReactiveRadius {
			bindClass = "avatarRadiusClass"
		}
		rootSkinClasses := cfg.toneClasses()
		layerSkinClasses := ""
		if cfg.Border {
			rootSkinClasses = ""
			layerSkinClasses = cfg.toneFillClasses()
		}
		containerClasses := "relative inline-flex " + sizePart + " " + radiusPart + " " + rootSkinClasses + " " + cfg.borderClasses() + " " + cfg.RootClass
		layerBoxClasses := "relative block size-full overflow-hidden " + radiusPart + " " + layerSkinClasses
	}}
	if cfg.hasImage() {
		<div
			x-data="{ imgLoaded: false, imgError: false }"
			class={ containerClasses }
			if bindClass != "" {
				x-bind:class={ bindClass }
			}
		>
			<span
				class={ layerBoxClasses }
				if cfg.ReactiveRadius {
					x-bind:class="avatarRadiusClass"
				}
			>
				@layerInitials(cfg, true)
				@layerLoading(cfg)
				@layerImage(cfg)
			</span>
		</div>
	} else {
		<div
			class={ containerClasses }
			if bindClass != "" {
				x-bind:class={ bindClass }
			}
		>
			<span
				class={ layerBoxClasses }
				if cfg.ReactiveRadius {
					x-bind:class="avatarRadiusClass"
				}
			>
				@layerInitials(cfg, false)
			</span>
		</div>
	}
}

// layerInitials renders the initials/icon layer. When withImageOverlay is true,
// the layer is hidden on successful image load (so transparent pixels don't
// bleed the initials through) and shown on error as a fallback.
templ layerInitials(cfg Config, withImageOverlay bool) {
	{{ classes := "absolute inset-0 flex items-center justify-center font-bold tracking-wider" }}
	<span
		class={ classes }
		aria-hidden="true"
		if withImageOverlay {
			if cfg.SrcExpr != "" {
				x-show={ fmt.Sprintf("!(%s) || !imgLoaded || imgError", cfg.SrcExpr) }
			} else {
				x-show="!imgLoaded || imgError"
			}
		}
	>
		if cfg.Icon != nil {
			<span class="w-full h-full mt-3">
				@cfg.Icon
			</span>
		} else {
			{ cfg.resolvedInitials() }
		}
	</span>
}

// layerLoading renders a spinner overlay while the image loads.
// When SrcExpr is set the spinner is also gated on the expression being truthy —
// an empty/nil SrcExpr should not cause the spinner to show forever.
templ layerLoading(cfg Config) {
	<span
		if cfg.SrcExpr != "" {
			x-show={ fmt.Sprintf("(%s) && !imgLoaded && !imgError", cfg.SrcExpr) }
		} else {
			x-show="!imgLoaded && !imgError"
		}
		class="absolute inset-0 flex items-center justify-center bg-surface-alt dark:bg-surface-dark-alt"
		aria-hidden="true"
	>
		<svg class={ "animate-spin text-on-surface-muted dark:text-on-surface-dark-muted " + cfg.spinnerSizeClasses() } xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
			<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
			<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
		</svg>
	</span>
}

// layerImage renders the actual image, hidden on error.
// x-init handles the race where the browser finishes loading (or fails) before
// Alpine attaches x-on:load / x-on:error. In that case neither event fires and
// the spinner gets stuck. $el.complete tells us the fetch is done; naturalWidth
// distinguishes success (>0) from error (==0).
//
// When cfg.SrcExpr is set, x-bind:src binds to the parent-scope expression
// instead of a static src attribute, enabling client-set sources (object URLs, etc.).
//
// SrcExpr mode: the x-init naturalWidth check is guarded on the expression being
// truthy at mount — an empty/no src (e.g. while IndexedDB hydrates) is reported
// by browsers as complete with naturalWidth==0, which would latch imgError=true
// and keep the image hidden forever even after the real URL arrives.
// An x-effect clears imgError whenever the expression becomes truthy, allowing
// the subsequent x-on:load/x-on:error to set the correct state from the real fetch.
templ layerImage(cfg Config) {
	<img
		x-show="!imgError"
		if cfg.SrcExpr != "" {
			x-init={ fmt.Sprintf("if ((%[1]s) && $el.complete) { if ($el.naturalWidth > 0) imgLoaded = true; else imgError = true; }", cfg.SrcExpr) }
			x-effect={ fmt.Sprintf("if (%s) { imgError = false; }", cfg.SrcExpr) }
			x-bind:src={ cfg.SrcExpr }
		} else {
			x-init="if ($el.complete) { if ($el.naturalWidth > 0) imgLoaded = true; else imgError = true; }"
			src={ cfg.Src }
		}
		x-on:load="imgLoaded = true"
		x-on:error={ fmt.Sprintf("imgError = true; console.warn('[avatar] failed to load image:', '%s')", jsEscapeSingle(cfg.Src)) }
		alt={ cfg.Alt }
		class="absolute inset-0 h-full w-full object-cover object-center"
	/>
}

// avatarWithStatus wraps the layered avatar with a status indicator dot.
//
// In reactive mode the status-dot size class is also deferred to the parent
// Alpine scope via x-bind:class="avatarStatusSizeClass".
templ avatarWithStatus(cfg Config) {
	<div class="relative w-fit">
		@avatarLayers(cfg)
		{{
			positionClass := "bottom-0.5 end-0"
			statusSizePart := cfg.statusSizeClasses()
			if cfg.Reactive {
				statusSizePart = ""
			}
		}}
		<span
			class={ "absolute rounded-full border-2 border-surface dark:border-surface-dark " + statusSizePart + " " + cfg.statusClasses() + " " + positionClass }
			if cfg.Reactive {
				x-bind:class="avatarStatusSizeClass"
			}
			aria-hidden="true"
		></span>
	</div>
}

// userIcon returns the default user icon component.
func userIcon() templ.Component {
	return userIconTempl()
}

templ userIconTempl() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="w-full h-full mt-3">
		<path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd"/>
	</svg>
}
