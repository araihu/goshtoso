package popover

// Popover renders consumer-owned trigger and content with shared open/close
// lifecycle, focus restoration, ARIA wiring, and CSS placement.
templ popoverTemplate(cfg Config) {
	<div
		data-popover-root
		x-data="goshtosoPopover($el)"
		x-on:keydown.esc.window="closeAndFocus()"
		x-on:click.outside="close()"
		if cfg.activation() == ActivationHover {
			x-on:mouseenter="clearScheduledClose(); open()"
			x-on:mouseleave="scheduleClose()"
		}
		if cfg.ID != "" {
			id={ cfg.ID }
		}
		class={ cfg.rootClasses() }
	>
		<span
			data-popover-trigger
			class="contents"
			if cfg.activation() != ActivationHover {
				x-on:click="toggle()"
			}
			if cfg.activation() == ActivationContext {
				x-on:contextmenu.prevent="open()"
			}
			x-on:keydown.enter.prevent="openFromKeyboard()"
			x-on:keydown.space.prevent="openFromKeyboard()"
			x-on:keydown.down.prevent="openFromKeyboard()"
		>
			if cfg.Trigger != nil {
				@cfg.Trigger
			} else {
				<button type="button">Open</button>
			}
		</span>
		<div
			data-popover-panel
			x-ref="panel"
			x-cloak
			x-show="isOpen || openedWithKeyboard"
			x-transition
			if cfg.TrapFocus {
				x-trap.noreturn="openedWithKeyboard"
			}
			if panelID := cfg.panelID(); panelID != "" {
				id={ panelID }
			}
			if cfg.Role != "" {
				role={ cfg.Role }
			}
			if cfg.Label != "" {
				aria-label={ cfg.Label }
			}
			class={ cfg.panelClasses() }
		>
			if cfg.Content != nil {
				@cfg.Content
			}
		</div>
	</div>
}
