package codeblock

// CodeBlock renders a syntax-highlighted code block with a header bar and
// copy button. Highlighting is done server-side via Chroma (class mode);
// the palette is defined in css/codeblock.css.
//
// Usage:
//
//	@codeblock.CodeBlock(codeblock.Config{
//	    Language: "go",
//	    Code:     `func main() { fmt.Println("hello") }`,
//	})
//
//	// With custom label and max height
//	@codeblock.CodeBlock(codeblock.Config{
//	    Language: "bash",
//	    Label:    "Install",
//	    Code:     "go get github.com/a-h/templ",
//	    MaxHeight: "200px",
//	})
templ codeBlockTemplate(cfg Config) {
	{{ id := cfg.getID() }}
	<div
		class="rounded-radius border border-outline dark:border-outline-dark overflow-hidden"
		data-code-block
		data-density={ string(cfg.Density) }
	>
			<!-- Header -->
			<div class={ cfg.headerClasses() } data-code-block-header>
				<span class="text-xs font-medium text-on-surface dark:text-on-surface-dark">{ cfg.getLabel() }</span>
			if !cfg.DisableCopyButton {
				<button
					type="button"
					hidden
					data-code-block-copy
					data-code-block-target={ id }
					aria-label={ cfg.copyLabel() }
					aria-controls={ id }
					class="flex items-center gap-1 text-xs text-on-surface-muted hover:text-primary transition-colors motion-reduce:transition-none dark:text-on-surface-dark-muted dark:hover:text-primary-dark"
				>
				<svg data-code-block-copy-icon xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
				</svg>
				<svg data-code-block-success-icon hidden xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
				</svg>
				<span data-code-block-copy-status role="status" aria-live="polite">Copy</span>
				</button>
			}
		</div>
		<!-- Code -->
		<div id={ id } class={ cfg.bodyClasses() } style={ cfg.maxHeightStyle() }>
			@templ.Raw(Render(cfg.Code, cfg.Language))
		</div>
	</div>
}
