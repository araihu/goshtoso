package rangeinput

// Range renders a PenguinUI-inspired range slider.
//
// Usage:
//
//	@rangeinput.Range(rangeinput.Config{
//	    ID:    "mood",
//	    Name:  "mood",
//	    Label: "Mood Meter",
//	    Value: "20",
//	    Min:   "0",
//	    Max:   "100",
//	    Step:  "1",
//	})
templ rangeTemplate(cfg Config) {
	if cfg.ShowValue {
		<div x-data={ cfg.alpineData() } class={ cfg.rootClasses() }>
			@rangeInner(cfg, true)
		</div>
	} else {
		<div class={ cfg.rootClasses() }>
			@rangeInner(cfg, false)
		</div>
	}
}

templ rangeInner(cfg Config, alpine bool) {
	if cfg.Label != "" && cfg.LeadingIcon == nil && cfg.TrailingIcon == nil && !cfg.ShowValue {
		<label for={ cfg.ID } class={ cfg.labelClasses() }>{ cfg.Label }</label>
	}
	<div class={ cfg.controlClasses() }>
		if cfg.LeadingIcon != nil {
			<span class={ cfg.iconClasses() } aria-hidden="true">
				@cfg.LeadingIcon
			</span>
		}
		if cfg.Label != "" && (cfg.LeadingIcon != nil || cfg.TrailingIcon != nil || cfg.ShowValue) {
			<label for={ cfg.ID } class={ cfg.labelClasses() }>{ cfg.Label }</label>
		}
		<input
			id={ cfg.ID }
			type="range"
			class={ cfg.inputClasses() }
			name={ cfg.Name }
			value={ cfg.valueOrDefault() }
			min={ cfg.minOrDefault() }
			max={ cfg.maxOrDefault() }
			step={ cfg.stepOrDefault() }
			if alpine {
				x-model="currentVal"
			}
			disabled?={ cfg.Disabled }
			required?={ cfg.Required }
			{ cfg.InputAttrs... }
		/>
		if cfg.ShowValue {
			<span class={ cfg.valueClasses() } x-text="currentVal">{ cfg.valueOrDefault() }</span>
		}
		if cfg.TrailingIcon != nil {
			<span class={ cfg.iconClasses() } aria-hidden="true">
				@cfg.TrailingIcon
			</span>
		}
	</div>
	if cfg.ShowTicks {
		<div class="flex w-full items-center justify-between px-0.5" aria-hidden="true">
			for _, tick := range cfg.tickLabels() {
				<span class={ cfg.tickClasses(tick) }>{ tick.Label }</span>
			}
		</div>
	}
}
