package sidebar

// Sidebar renders a collapsible sidebar navigation component based on PenguinUI
// Usage:
//
//	@sidebar.Sidebar(sidebar.Config{
//	    LogoText: "MyApp",
//	    Items: []sidebar.Item{
//	        {ID: "home", Label: "Home", Href: "/", Icon: homeIcon, Active: true},
//	        {ID: "profile", Label: "Profile", Href: "/profile", Icon: profileIcon},
//	    },
//	})
templ Sidebar(cfg Config) {
	{{ logoHref := cfg.LogoHref }}
	{{ if logoHref == "" { logoHref = "/" } }}
	
	<nav
		class={ cfg.ContainerClasses() + " " + cfg.RootClass }
		aria-label="sidebar navigation"
	>
		<!-- Skip to main content link for accessibility -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-on-primary">skip to the main content</a>
		<!-- Logo Section (only rendered when Logo or LogoText is provided) -->
		if cfg.Logo != nil || cfg.LogoText != "" {
			<div class="shrink-0 border-b border-outline dark:border-outline-dark p-4">
				<a href={ templ.URL(logoHref) } class="flex items-center gap-2 text-xl font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
					if cfg.Logo != nil {
						@cfg.Logo
					} else {
						<span>{ cfg.LogoText }</span>
					}
				</a>
			</div>
		}
		
		<!-- Search Section -->
		if cfg.SearchSlot != nil {
			@cfg.SearchSlot
		} else if cfg.ShowSearch {
			<div class="shrink-0 px-4 py-3">
				<div class="relative">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" class="absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-on-surface-muted dark:text-on-surface-dark-muted" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
					</svg>
					<input
						type="search"
						class="w-full border border-outline rounded-radius bg-surface py-1.5 pl-9 pr-3 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-75 dark:border-outline-dark dark:bg-surface-dark/50 dark:focus-visible:outline-primary-dark"
						name="search"
						aria-label="Search"
						placeholder={ cfg.SearchPlaceholder }
					/>
				</div>
			</div>
		}
		
		<!-- Navigation -->
		<div class={ cfg.NavClasses() }>
			<!-- Top-level items (icon links) -->
			if len(cfg.Items) > 0 {
				<div class="flex flex-col gap-1">
					for _, item := range cfg.Items {
						@sidebarItem(item)
					}
				</div>
			}

			<!-- Sections (grouped with titles + left-border items) -->
			if len(cfg.Sections) > 0 {
				if len(cfg.Items) > 0 {
					<div class="mt-4"></div>
				}
				if cfg.SectionsTitle != "" {
					<div class="py-2 font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
						{ cfg.SectionsTitle }
					</div>
				}
				<div class="flex flex-col">
					for i, section := range cfg.Sections {
						@sidebarSection(section, i)
					}
				</div>
			}
		</div>
		<!-- Footer Slot (e.g., profile menu) -->
		if cfg.FooterSlot != nil {
			<div class="mt-auto shrink-0">
				@cfg.FooterSlot
			</div>
		}
	</nav>
}

// sidebarItem renders a single sidebar navigation item (top-level icon links)
templ sidebarItem(item Item) {
	if item.Disabled {
		<span class="flex items-center gap-2 py-2 text-base text-on-surface-muted cursor-not-allowed dark:text-on-surface-dark-muted">
			if item.Icon != nil {
				<span class="shrink-0 size-8 rounded-sm p-1.5 bg-surface-alt text-on-surface dark:bg-surface-dark-alt dark:text-on-surface-dark">
					@item.Icon
				</span>
			}
			<span>{ item.Label }</span>
		</span>
	} else if item.Active {
		<a href={ templ.URL(item.Href) } { sidebarLinkAttrs(item)... } class="flex items-center gap-2 py-2 text-base font-medium text-primary dark:text-primary-dark">
			if item.Icon != nil {
				<span class="shrink-0 size-8 rounded-sm p-1.5 bg-primary/10 text-primary dark:bg-primary-dark/10 dark:text-primary-dark">
					@item.Icon
				</span>
			}
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			<span class="sr-only">active</span>
		</a>
	} else {
		<a href={ templ.URL(item.Href) } { sidebarLinkAttrs(item)... } class="flex items-center gap-2 py-2 text-base text-on-surface transition-colors hover:text-on-surface-strong dark:text-on-surface-dark dark:hover:text-on-surface-dark-strong">
			if item.Icon != nil {
				<span class="shrink-0 size-8 rounded-sm p-1.5 bg-surface-alt text-on-surface dark:bg-surface-dark-alt dark:text-on-surface-dark">
					@item.Icon
				</span>
			}
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			if item.Badge != "" {
				<span class={ sidebarBadgeClasses(item, false) }>{ item.Badge }</span>
			}
		</a>
	}
	
	<!-- Render child items if any -->
	if len(item.Items) > 0 {
		<div class="ml-4 mt-1 flex flex-col gap-1">
			for _, child := range item.Items {
				@sidebarItem(child)
			}
		</div>
	}
}

// sidebarSection renders a grouped section with PenguinUI-style left border items
templ sidebarSection(section Section, index int) {
	<div data-sidebar-section={ section.Title }>
		if section.Title != "" {
			<h3 class="mb-2 mt-8 first:mt-2 text-sm font-bold text-on-surface-strong dark:text-on-surface-dark-strong">
				{ section.Title }
			</h3>
		}
		<div class="flex flex-col">
			for _, item := range section.Items {
				@sidebarSectionItem(item, section.Collapsible)
			}
		</div>
	</div>
}

// sidebarSectionItem renders an item with left border line (PenguinUI sidebar style)
templ sidebarSectionItem(item Item, collapseChildGroups bool) {
	if (item.Collapsible || collapseChildGroups) && len(item.Items) > 0 {
		@sidebarCollapsibleSectionItem(item)
	} else if item.Disabled {
		<span class="flex items-center border-l border-outline py-2.5 pl-4 text-sm font-medium text-on-surface-muted cursor-not-allowed dark:border-outline-dark dark:text-on-surface-dark-muted">
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
		</span>
	} else if len(item.Items) > 0 {
		<a
			href={ templ.URL(item.Href) }
			{ sidebarLinkAttrs(item)... }
			class="flex items-center gap-2 py-2.5 pl-4 text-sm font-medium text-on-surface transition duration-200 hover:text-on-surface-strong dark:text-on-surface-dark dark:hover:text-on-surface-dark-strong"
		>
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			if item.Badge != "" {
				<sup class={ sidebarBadgeClasses(item, true) }>{ item.Badge }</sup>
			}
		</a>
	} else if item.Active {
		<a
			href={ templ.URL(item.Href) }
			{ sidebarLinkAttrs(item)... }
			class="pointer-events-none flex items-center gap-2 border-l-2 border-primary py-2.5 pl-4 text-sm font-bold text-primary dark:border-primary-dark dark:text-primary-dark"
		>
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			if item.Badge != "" {
				<sup class={ sidebarBadgeClasses(item, true) }>{ item.Badge }</sup>
			}
			<span class="sr-only">active</span>
		</a>
	} else {
		<a
			href={ templ.URL(item.Href) }
			{ sidebarLinkAttrs(item)... }
			class="flex items-center gap-2 border-l border-outline py-2.5 pl-4 text-sm font-medium text-on-surface transition duration-200 hover:border-l-2 hover:border-outline-strong hover:text-on-surface-strong dark:border-outline-dark dark:text-on-surface-dark dark:hover:border-outline-dark-strong dark:hover:text-on-surface-dark-strong"
		>
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			if item.Badge != "" {
				<sup class={ sidebarBadgeClasses(item, true) }>{ item.Badge }</sup>
			}
		</a>
	}

	if len(item.Items) > 0 && !item.Collapsible && !collapseChildGroups {
		<div class="ml-4 flex flex-col">
			for _, child := range item.Items {
				@sidebarSectionItem(child, false)
			}
		</div>
	}
}

templ sidebarCollapsibleSectionItem(item Item) {
	<div x-data={ sidebarDisclosureData(item.Open) }>
		<a
			href={ templ.URL(item.Href) }
			{ sidebarLinkAttrs(item)... }
			x-on:click.prevent="open = !open"
			x-bind:aria-expanded="open.toString()"
			aria-controls={ sidebarChildrenID(item) }
			class="flex items-center gap-2 border-l border-outline py-2.5 pl-4 text-sm font-medium text-on-surface transition duration-200 hover:border-l-2 hover:border-outline-strong hover:text-on-surface-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-outline-dark dark:text-on-surface-dark dark:hover:border-outline-dark-strong dark:hover:text-on-surface-dark-strong dark:focus-visible:outline-primary-dark"
		>
			<span class="min-w-0 flex-1 truncate">{ item.Label }</span>
			if item.Badge != "" {
				<sup class={ sidebarBadgeClasses(item, true) }>{ item.Badge }</sup>
			}
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 text-on-surface-muted transition-transform duration-150 dark:text-on-surface-dark-muted" x-bind:class="open ? 'rotate-180' : ''" aria-hidden="true">
				<path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</a>
		<div id={ sidebarChildrenID(item) } x-show="open" { sidebarChildrenAttrs(item.Open)... } class="ml-4 flex flex-col">
			for _, child := range item.Items {
				@sidebarSectionItem(child, false)
			}
		</div>
	</div>
}
