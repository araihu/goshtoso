package modal

// Dialog renders a native modal in the browser top layer, including above drawers.
// Dispatch modal:open or modal:close with {id: ID}. Escape closes only this dialog;
// the browser restores focus to the opener. Content remains mounted while closed.
templ dialogTemplate(cfg DialogConfig) {
 <dialog
  id={cfg.ID} data-modal-id={cfg.ID} aria-labelledby={cfg.ID+"Title"}
  x-data="{open:false}"
  x-on:modal:open.window="if ($event.detail && $event.detail.id === $el.dataset.modalId) open=true"
  x-on:modal:close.window="if ($event.detail && $event.detail.id === $el.dataset.modalId) open=false"
  x-effect="if (open && !$el.open) $el.showModal(); if (!open && $el.open) $el.close()"
  x-on:cancel.prevent="open=false"
  x-on:close="open=false"
  if cfg.Compact {
   x-on:click.self="open=false"
  }
  x-on:keydown.escape.stop
  x-trap.noreturn.noscroll="open"
  class={"fixed inset-0 m-auto p-0 open:flex open:flex-col overflow-hidden border border-outline bg-surface text-on-surface dark:border-outline-dark dark:bg-surface-dark-alt dark:text-on-surface-dark backdrop:bg-backdrop/50",templ.KV("h-dvh max-h-dvh w-screen max-w-none rounded-none sm:h-auto sm:max-h-[90dvh] sm:w-[48rem] sm:max-w-[calc(100vw-2rem)] sm:rounded-radius",cfg.FullscreenMobile && !cfg.Compact),templ.KV("max-h-[90dvh] w-[48rem] max-w-[calc(100vw-2rem)] rounded-radius",!cfg.FullscreenMobile && !cfg.Compact),templ.KV("mt-[5dvh] max-h-[85dvh] w-[40rem] max-w-[calc(100vw-2rem)] rounded-radius",cfg.Compact)}
 >
  if cfg.Compact {
   <h2 id={cfg.ID+"Title"} class="sr-only">{cfg.Title}</h2>
  } else {
  <header class="flex shrink-0 items-center justify-between gap-4 border-b border-outline p-4 dark:border-outline-dark">
   <h2 id={cfg.ID+"Title"} class="font-semibold">{cfg.Title}</h2>
   <button type="button" aria-label="Close dialog" x-on:click="open=false" class="cursor-pointer rounded-radius p-2 focus-visible:outline-2 focus-visible:outline-primary">@closeIcon()</button>
  </header>
  }
  <div class={"min-h-0 flex-1 overflow-y-auto",templ.KV("p-4",!cfg.Compact)}>
 if cfg.Content != nil {
 @cfg.Content
 }
 </div>
 </dialog>
}
