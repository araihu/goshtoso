package link

// Link renders a styled anchor element.
templ Link(cfg Config) {
	<a
		if cfg.ID != "" {
			id={ cfg.ID }
		}
		href={ cfg.href() }
		if cfg.Target != "" {
			target={ cfg.Target }
		}
		if cfg.rel() != "" {
			rel={ cfg.rel() }
		}
		if cfg.role() != "" {
			role={ cfg.role() }
		}
		class={ cfg.classes() }
		{ cfg.Attrs... }
	>
		if cfg.Icon != nil && cfg.IconPosition == IconLeading {
			@cfg.Icon
		}
		{ children... }
		if cfg.Icon != nil && cfg.IconPosition != IconLeading {
			@cfg.Icon
		}
	</a>
}
